-- ===== CLASS A HEALING (basado en el script real) =====
local function getNearestHealTarget(radio)
    radio = radio or 22
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local best, bd = nil, radio
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            if not p:FindFirstChild("Experiment") then
                local th = p.Character:FindFirstChildOfClass("Humanoid")
                local tHRP = p.Character:FindFirstChild("HumanoidRootPart")
                if th and tHRP and th.Health > 0 and th.Health < th.MaxHealth then
                    local d = (myHRP.Position - tHRP.Position).Magnitude
                    if d < bd then bd = d; best = p end
                end
            end
        end
    end
    return best
end

local function healPlayer(target)
    local ev = getHealEv(); if not ev or not target or not target.Character then return false end
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not (myHRP and tHRP) then return false end
    if (myHRP.Position - tHRP.Position).Magnitude > 20 then return false end
    pcall(function() ev:FireServer("StartVisuals", target) end)
    for i = 1, 6 do -- 6 ticks × 5 HP = 30 → GiveSpeedBoost
        local tc = target.Character
        if not tc then break end
        local th2 = tc:FindFirstChildOfClass("Humanoid")
        if not th2 or th2.Health >= th2.MaxHealth then break end
        local tHRP2 = tc:FindFirstChild("HumanoidRootPart")
        if not tHRP2 or (myHRP.Position - tHRP2.Position).Magnitude > 20 then break end
        pcall(function() ev:FireServer("HealTick", target) end)
        task.wait(1)
    end
    pcall(function() ev:FireServer("GiveSpeedBoost") end) -- ← 30 data / 50XP → Speed Boost
    pcall(function() ev:FireServer("StopVisuals") end)
    return true
end

FH.healN = function()
    local target = getNearestHealTarget(22)
    if target then healPlayer(target) end
end

FH.healS = function()
    -- No puedes curarte a ti mismo en el juego, así que buscamos al más cercano
    FH.healN()
end

FH.healAll = function()
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character and not p:FindFirstChild("Experiment") then
            local th = p.Character:FindFirstChildOfClass("Humanoid")
            local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local tHRP = p.Character:FindFirstChild("HumanoidRootPart")
            if th and myHRP and tHRP and th.Health > 0 and th.Health < th.MaxHealth 
                and (myHRP.Position - tHRP.Position).Magnitude <= 20 then
                task.spawn(function() healPlayer(p) end)
            end
        end
    end
end

FH.resetCd = function()
