-- AUTO PATIENT (Lo dejamos como el original que te funcionaba)
FH.startAP = function()
    if FH.apConn then return end
    FH.apConn = RS.Heartbeat:Connect(function()
        if not FH.autoPatientLegit then return end
        local gui = LP.PlayerGui:FindFirstChild("TaskGuiMap1")
        if not gui or not gui.Enabled then return end
        local fm = gui:FindFirstChild("Frame"); if not fm or not fm.Visible then return end
        local catcher = fm:FindFirstChild("Catcher"); if not catcher then return end
        for _, h in ipairs(fm:GetChildren()) do
            if h.Name == "Note" and h:IsA("Frame") then
                local a = h:GetAttribute("Angle")
                if a then local d = math.abs(a - (math.pi/2)); if d > math.pi then d = 2*math.pi - d end; if d > 0.3 then h:SetAttribute("Angle", math.pi/2) end end
            end
        end
        local ac = math.pi/2 + math.pi/2
        catcher.Position = UDim2.new(math.cos(ac)*0.42+0.5, 0, math.sin(ac)*0.42+0.5, 0)
        catcher.Rotation = math.deg(ac)+90
        catcher.BackgroundColor3 = Color3.fromRGB(255, 120, 20)
    end)
end
FH.stopAP = function() if FH.apConn then FH.apConn:Disconnect(); FH.apConn=nil end end

-- CYCLE TPs FIX
local tpIdx = { patient = 1, tube = 1, candy = 1 }
local function getTargets(keyword)
    local t = {}
    for _, obj in ipairs(WS:GetChildren()) do
        if obj.Name:lower():find(keyword) then
            local hrp = obj:FindFirstChild("PrimaryPart") or obj:FindFirstChildWhichIsA("BasePart")
            if hrp then table.insert(t, hrp) end
        end
    end
    return t
end
FH.cycleTP = function(kw)
    local t = getTargets(kw)
    if #t == 0 then return end
    local i = tpIdx[kw] or 1
    if i > #t then i = 1 end
    local mc = LP.Character; local hrp = mc and mc:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = t[i].CFrame * CFrame.new(0, 3, 0); tpIdx[kw] = i + 1 end
end

-- GET ALL CANDYS FIX (TP al centro)
FH.autoCandyActive = false
task.spawn(function()
    while true do
        if FH.autoCandyActive then
            local mc = LP.Character; local hrp = mc and mc:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, obj in ipairs(WS:GetChildren()) do
                    if obj.Name:match("Candy") then
                        local primary = obj:FindFirstChild("PrimaryPart") or obj:FindFirstChildWhichIsA("BasePart")
                        if primary then
                            -- TP directo al centro del caramelo
                            hrp.CFrame = primary.CFrame
                            task.wait(0.1)
                        end
                    end
                end
            end
            task.wait(0.5)
        else
            task.wait(1)
        end
    end
end)

