-- Teleports Ciclicos
local tpIndex = { patient = 1, tube = 1 }
local function cycleTP(keyword)
    local mc = LP.Character; if not mc then return end
    local mh = mc:FindFirstChild("HumanoidRootPart"); if not mh then return end
    local targets = {}
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("Model") and string.find(string.lower(obj.Name), keyword) then
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
            if hrp then table.insert(targets, hrp) end
        end
    end
    if #targets == 0 then return end
    local idx = tpIndex[keyword] or 1
    if idx > #targets then idx = 1 end
    tpIndex[keyword] = idx + 1
    local target = targets[idx]
    mh.CFrame = CFrame.new(target.Position + Vector3.new(0, 3, 0))
end

-- Spectator GUI
local specGui = nil; local specList = nil; local specActive = false
local function updateSpecList()
    if not specGui or not specList then return end
    for _, c in ipairs(specList:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end
    local count = 0
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            -- Solo si esta muerto (Especteando)
            if hum and hum.Health <= 0 then
                count = count + 1
                local lbl = Instance.new("TextLabel", specList)
                lbl.Size = UDim2.new(1, 0, 0, 20); lbl.BackgroundTransparency = 1
                lbl.Text = "👁 " .. p.Name; lbl.TextColor3 = Color3.fromRGB(255, 200, 200)
                lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Font = Enum.Font.GothamBold; lbl.TextScaled = true
            end
        end
    end
    local topBar = specGui:FindFirstChild("Frame") and specGui.Frame:FindFirstChild("TopBar")
    local title = topBar and topBar:FindFirstChild("TextLabel")
    if title then title.Text = "Spectators: " .. count end
end
local function startSpectator()
    if specGui then return end
    specGui = Instance.new("ScreenGui"); specGui.Name = "FH_Spectators"; specGui.ResetOnSpawn = false; specGui.Parent = FH.parent
    local frame = Instance.new("Frame", specGui); frame.Name = "Frame"; frame.Size = UDim2.new(0, 180, 0, 250); frame.Position = UDim2.new(0, 20, 0.2, 0)
    frame.BackgroundColor3 = Color3.fromRGB(20, 10, 28); frame.BorderSizePixel = 0; Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    local topBar = Instance.new("Frame", frame); topBar.Name = "TopBar"; topBar.Size = UDim2.new(1, 0, 0, 30); topBar.BackgroundColor3 = Color3.fromRGB(35, 15, 45); topBar.BorderSizePixel = 0; Instance.new("UICorner", topBar).CornerRadius = UDim.new(0, 8)
    local title = Instance.new("TextLabel", topBar); title.Size = UDim2.new(1, 0, 1, 0); title.BackgroundTransparency = 1; title.Text = "Spectators: 0"; title.TextColor3 = Color3.new(1,1,1); title.Font = Enum.Font.GothamBold; title.TextScaled = true
    specList = Instance.new("ScrollingFrame", frame); specList.Size = UDim2.new(1, -10, 1, -40); specList.Position = UDim2.new(0, 5, 0, 35); specList.BackgroundTransparency = 1; specList.BorderSizePixel = 0; specList.ScrollBarThickness = 2
    Instance.new("UIListLayout", specList).Padding = UDim.new(0, 5)
    local dragging, dragStart, startPos
    topBar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; dragStart = input.Position; startPos = frame.Position end end)
    UI.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then local delta = input.Position - dragStart; frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end end)
    UI.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
    task.spawn(function() while specActive do updateSpecList(); task.wait(2) end end)
end
local function stopSpectator() if specGui then specGui:Destroy(); specGui = nil end end

