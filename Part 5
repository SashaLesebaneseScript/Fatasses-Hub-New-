-- LOOP PARA EL V3 (Fast Regen) con Delta Time
RS.Heartbeat:Connect(function(dt)
    if FH.infV3 then
        local char = LP.Character
        if char then
            local stam = char:FindFirstChild("Stam")
            if stam and stam.Value < 100 then
                -- Suma 150 de stamina por segundo (150 * dt)
                stam.Value = math.min(100, stam.Value + (150 * dt))
            end
        end
    end
end)

-- LOOP PRINCIPAL (Velocidad, UI, V1, V2, No Aim Speed)
RS.RenderStepped:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local stam = char:FindFirstChild("Stam")
    local canSprint = char:FindFirstChild("CanSprint")

    -- 1. INFINITE STAMINA V1 (Can Sprint = true)
    if FH.infV1 and canSprint then
        canSprint.Value = true
    end

    -- 2. INFINITE STAMINA V2 (Stam = 100 siempre)
    if FH.infV2 and stam then
        stam.Value = 100
    end

    -- 3. UI (Si cualquiera de las 3 está activa)
    if FH.infV1 or FH.infV2 or FH.infV3 then
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then
            local sg = pg:FindFirstChild("SprintGui")
            if sg then
                local txt = sg:FindFirstChild("StaminaText", true)
                local bar = sg:FindFirstChild("FillFrame", true)
                if txt and txt:IsA("TextLabel") then txt.Text = "Sasha Wuz Here 👀" end
                if bar and bar:IsA("Frame") then bar.Size = UDim2.new(1, 0, 1, 0) end
            end
        end
    end

    -- 4. NO AIMING SPEED (Bypass de velocidad al apuntar)
    if FH.noAimSpeed and hum then
        local isAiming = char:GetAttribute("IsAiming") or false
        if isAiming then
            -- Detectar si el jugador está intentando correr (Shift, L3, o botón móvil)
            local isSprinting = UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.ButtonL3)
            
            -- En móvil, si se está moviendo y el botón de sprint es visible, asumimos que lo mantiene
            if not isSprinting and UIS.TouchEnabled then
                local pg = LP:FindFirstChild("PlayerGui")
                if pg then
                    local sg = pg:FindFirstChild("SprintGui")
                    if sg then
                        local sprBtn = sg:FindFirstChild("SprintButton", true)
                        if sprBtn and sprBtn.Visible and hum.MoveDirection.Magnitude > 0 then
                            isSprinting = true
                        end
                    end
                end
            end

            -- Aplicar la velocidad: 30 si corre, 10 si camina
            if isSprinting then
                hum.WalkSpeed = 30
            else
                hum.WalkSpeed = 10
            end
        end
    end
end)

-- AUTO PATIENT
FH.startAP = function()
    if FH.apConn then return end
    FH.apConn = RS.Heartbeat:Connect(function()
        if not FH.autoPatientLegit then return end
        local gui = LP.PlayerGui:FindFirstChild("TaskGuiMap1")
        if not gui or not gui.Enabled then return end
        local fm = gui:FindFirstChild("Frame"); if not fm or not fm.Visible then return end
        local catcher = fm:FindFirstChild("Catcher"); if not catcher then return end
        for _, h in ipairs(fm:GetChildren()) do
            if h.Name == "Note" and h:IsA("Frame") then
                local a = h:GetAttribute("Angle")
                if a then local d = math.abs(a - (math.pi/2)); if d > math.pi then d = 2*math.pi - d end; if d > 0.3 then h:SetAttribute("Angle", math.pi/2) end end
            end
        end
        local ac = math.pi/2 + math.pi/2
        catcher.Position = UDim2.new(math.cos(ac)*0.42+0.5, 0, math.sin(ac)*0.42+0.5, 0)
        catcher.Rotation = math.deg(ac)+90
        catcher.BackgroundColor3 = Color3.fromRGB(255, 120, 20)
    end)
end
FH.stopAP = function() if FH.apConn then FH.apConn:Disconnect(); FH.apConn=nil end end

-- CYCLE TPs
local tpIdx = { patient = 1, tube = 1, candy = 1, task3 = 1 }
local function getTargets(keyword)
    local t = {}
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find(keyword) then
            local hrp = obj:FindFirstChild("PrimaryPart") or obj:FindFirstChildWhichIsA("BasePart")
            if hrp then table.insert(t, hrp) end
        end
    end
    return t
end
FH.cycleTP = function(kw)
    local t = getTargets(kw)
    if #t == 0 then return end
    local i = tpIdx[kw] or 1
    if i > #t then i = 1 end
    local mc = LP.Character; local hrp = mc and mc:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = t[i].CFrame * CFrame.new(0, 3, 0); tpIdx[kw] = i + 1 end
end

-- GET ALL CANDYS
FH.autoCandyActive = false
FH.candyStartPos = nil
task.spawn(function()
    while true do
        if FH.autoCandyActive then
            local mc = LP.Character; local hrp = mc and mc:FindFirstChild("HumanoidRootPart")
            if hrp then
                if not FH.candyStartPos then FH.candyStartPos = hrp.CFrame end
                local candies = {}
                for _, obj in ipairs(WS:GetDescendants()) do
                    if obj:IsA("Model") and obj.Name:match("^Candy") then
                        local primary = obj:FindFirstChild("PrimaryPart") or obj:FindFirstChildWhichIsA("BasePart")
                        if primary then table.insert(candies, primary) end
                    end
                end
                if #candies > 0 then
                    hrp.CFrame = candies[1].CFrame
                    task.wait(0.15)
                else
                    hrp.CFrame = FH.candyStartPos
                    FH.autoCandyActive = false
                    FH.candyStartPos = nil
                end
            end
            task.wait(0.1)
        else
            FH.candyStartPos = nil
            task.wait(1)
        end
    end
end)

