FH.boost = function()
    local target = getNearestHealTarget(22)
    if target then
        healPlayer(target) -- 6 ticks + GiveSpeedBoost interno
    else
        -- Sin target, dispara directo (por si el server acepta)
        local ev = getHealEv()
        if ev then pcall(function() ev:FireServer("GiveSpeedBoost") end) end
    end
end

