-- Inf Stamina
FH.sashaSprint = false
RS.RenderStepped:Connect(function()
    if not FH.sashaSprint then return end
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local stam = char:FindFirstChild("Stam")
        if FH.UI:IsKeyDown(Enum.KeyCode.LeftShift) or FH.isSprintingManually then
            if hum and hum.WalkSpeed ~= 30 then hum.WalkSpeed = 30 end
            if stam then stam.Value = 100 end
        end
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then
            local sg = pg:FindFirstChild("SprintGui")
            if sg then
                local txt = sg:FindFirstChild("StaminaText", true)
                local bar = sg:FindFirstChild("FillFrame", true)
                if txt and txt:IsA("TextLabel") then txt.Text = "Sasha Wuz Here" end
                if bar and bar:IsA("Frame") then bar.Size = UDim2.new(1, 0, 1, 0); bar.BackgroundColor3 = C.accent end
            end
        end
    end
end)
task.spawn(function()
    while true do
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then
            local sg = pg:FindFirstChild("SprintGui")
            if sg then
                local btn = sg:FindFirstChild("SprintButton", true)
                if btn and not btn:GetAttribute("FH_HOOKED") then
                    btn:SetAttribute("FH_HOOKED", true)
                    btn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then FH.isSprintingManually = true end end)
                    btn.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then FH.isSprintingManually = false end end)
                end
            end
        end
        task.wait(1)
    end
end)

-- Botón S
local th=Instance.new("Frame"); th.Size=UDim2.new(0,60,0,60); th.Position=UDim2.new(0,20,.75,0); th.BackgroundTransparency=1; th.Parent=FH.sg
local tbtn=Instance.new("TextButton",th); tbtn.Size=UDim2.new(1,0,1,0); tbtn.BackgroundColor3=C.accent; tbtn.Text="S"; tbtn.TextColor3=Color3.fromRGB(255,255,255); tbtn.TextScaled=true; tbtn.Font=Enum.Font.GothamBlack; tbtn.BorderSizePixel=0; tbtn.AutoButtonColor=false
Instance.new("UICorner",tbtn).CornerRadius=UDim.new(1,0)
local dragging, dragInput, dragStart, startPos
tbtn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; dragStart = input.Position; startPos = th.Position; end end)
tbtn.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
FH.UI.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        th.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
tbtn.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
tbtn.MouseButton1Click:Connect(function() FH.fr.Visible = not FH.fr.Visible; FH.sfx("button", 1, 1.2) end)

