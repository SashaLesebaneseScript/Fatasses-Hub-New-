-- ===== INFINITE STAMINA & CANDY =====
FH.sashaSprint = false
FH.isSprintingManually = false
task.spawn(function()
    while true do
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then
            local sg = pg:FindFirstChild("SprintGui")
            if sg then
                local btn = sg:FindFirstChild("SprintButton", true)
                if btn and not btn:GetAttribute("FH_HOOKED") then
                    btn:SetAttribute("FH_HOOKED", true)
                    btn.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then FH.isSprintingManually = true end
                    end)
                    btn.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then FH.isSprintingManually = false end
                    end)
                end
            end
        end
        task.wait(1)
    end
end)
RS.RenderStepped:Connect(function()
    if not FH.sashaSprint then return end
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local stam = char:FindFirstChild("Stam")
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or FH.isSprintingManually then
            if hum and hum.WalkSpeed ~= 30 then hum.WalkSpeed = 30 end
            if stam then stam.Value = 100 end
        end
    end
end)

FH.autoCandyActive = false
task.spawn(function()
    while true do
        if FH.autoCandyActive then
            local mc = LP.Character; local hrp = mc and mc:FindFirstChild("HumanoidRootPart")
            if hrp then
                local candies = {}
                local folders = {WS, WS:FindFirstChild("Map1"), WS:FindFirstChild("Map2"), WS:FindFirstChild("Map3")}
                for _, folder in ipairs(folders) do
                    if folder then
                        for _, obj in ipairs(folder:GetChildren()) do
                            if obj:IsA("Model") and obj.Name:match("^Candy") then
                                local primary = obj:FindFirstChild("PrimaryPart") or obj:FindFirstChildWhichIsA("BasePart")
                                if primary then table.insert(candies, primary) end
                            end
                        end
                    end
                end
                if #candies > 0 then pcall(function() hrp.CFrame = candies[1].CFrame end); task.wait(0.15) else task.wait(2) end
            end
            task.wait(0.1)
        else task.wait(1) end
    end
end)

