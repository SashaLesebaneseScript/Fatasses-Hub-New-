-- ===== SISTEMA COMPLETE FULL =====
FH.startSp = function()
    if not FH.TR then return end
    if FH.spLoop then return end
    FH.spLoop = task.spawn(function()
        while FH.on.spamComplete do
            local guis = {LP.PlayerGui:FindFirstChild("TaskGuiMap1"), LP.PlayerGui:FindFirstChild("TaskGuiMap2"), LP.PlayerGui:FindFirstChild("TaskGuiMap3")}
            for _, g in ipairs(guis) do
                if g and g.Enabled and FH.tarea and FH.tarea.id then
                    pcall(function() FH.TR:FireServer("CompleteStep", FH.tarea.id) end)
                end
            end
            task.wait(0.3)
        end
        FH.spLoop = nil
    end)
end
FH.stopSp = function() FH.on.spamComplete = false end

-- ===== AUTO HEAL CLASS A (LOOPS) =====
FH.startAH = function()
    if FH.ahConn then return end
    FH.ahConn = task.spawn(function()
        while FH.on.autoHeal do 
            local t = FH.injPlayer(50)
            if t then FH.healT(t) end
