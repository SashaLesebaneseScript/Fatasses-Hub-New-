local FH=getgenv().FH
if not FH or not FH.p4 then warn("[FH] Ejecuta Partes 1-4 primero") return end
if FH.p5 then warn("[FH] Parte 5 ya ejecutada") return end
local RS,PL,WS,LP=FH.RS,FH.PL,FH.WS,FH.LP
local C=FH.C
local sprHeld=false;sprBtn=nil;ifC=nil;humHk=nil
local function hayM()return WS:FindFirstChild("Map1")~=nil or WS:FindFirstChild("Map2")~=nil end
local function tSpeed()
 if not hayM()then return 16 end
 if sprHeld then return 30 end
 return 10 end
local function forzStam()
 local ch=LP.Character;if not ch then return end
 for _,o in ipairs(ch:GetDescendants())do
  if o:IsA("IntValue")or o:IsA("NumberValue")then
   local n=string.lower(o.Name)
   if n=="stam"or n=="stamina"then if o.Value<1000 then pcall(function()o.Value=100000 end)end end end end end
local function hookH(h)
 if not h or h==humHk then return end
 humHk=h
 pcall(function()
  local mt=getrawmetatable(h);if not mt then return end
  if setreadonly then setreadonly(mt,false)end
  local old=mt.__newindex
  mt.__newindex=function(s,k,v)
   if k=="WalkSpeed"and s==h and FH.on.infStam then
    local t=tSpeed();if v~=t then return old(s,k,t)end end
   return old(s,k,v)end
  if setreadonly then setreadonly(mt,true)end end)end
local function uiStam()
 local s=LP.PlayerGui:FindFirstChild("SprintGui");if not s then return end
 local t=s:FindFirstChild("StaminaText",true)
 if t and t:IsA("TextLabel")then
  if t.Text~="Stamina: 🎃 Inf/67"then t.Text="Stamina: 🎃 Inf/67"end
  t.TextColor3=Color3.fromRGB(255,150,50)end end
local function hookBtn()
 local s=LP.PlayerGui:FindFirstChild("SprintGui")
 if not s then sprBtn=nil;sprHeld=false;return end
 local b=s:FindFirstChild("SprintButton",true)
 if not b or b==sprBtn then return end
 sprBtn=b
 b.InputBegan:Connect(function(i)if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then sprHeld=true end end)
 b.InputEnded:Connect(function(i)if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then sprHeld=false end end)end
FH.startIS=function()
 if ifC then return end
 local ch=LP.Character
 if ch then hookH(ch:FindFirstChildOfClass("Humanoid"))end
 ifC=RS.Heartbeat:Connect(function()
  if not FH.on.infStam then return end
  pcall(forzStam);pcall(uiStam);pcall(hookBtn)
  local c2=LP.Character
  if c2 then local h2=c2:FindFirstChildOfClass("Humanoid")
   if h2 and h2~=humHk then humHk=nil;hookH(h2)end end end)end
FH.stopIS=function()if ifC then ifC:Disconnect();ifC=nil end;sprHeld=false end
local camC,charT,ultD=nil,nil,0
local function countScr(m)
 if not m or not m:IsA("Model")then return 0 end
 local n=0
 for _,x in ipairs(m:GetDescendants())do
  if x:IsA("Script")or x:IsA("LocalScript")or x:IsA("ModuleScript")then n=n+1 end end
 return n end
local function findK()
 local bk,bs=nil,0
 for _,p in ipairs(PL:GetPlayers())do
  if p~=LP and p.Character then
   local ch=p.Character;local h=ch:FindFirstChildOfClass("Humanoid")
   if h and h.Health>0 then
    local n=countScr(ch);local a=ch:GetExtentsSize().Y
    if n>=FH.KST then local sc=1000+n;if sc>bs then bs=sc;bk=ch end
    elseif a>bs then bs=a;bk=ch end end end end
 return bk end
local function aim()local mc=LP.Character;return mc and mc:GetAttribute("IsAiming")==true end
local function getChest(c)return c and(c:FindFirstChild("UpperTorso")or c:FindFirstChild("Torso")or c:FindFirstChild("HumanoidRootPart"))end
local function predPos(c)
 local ch=getChest(c);if not ch then return nil end
 local v=Vector3.new(0,0,0)
 local hr=c:FindFirstChild("HumanoidRootPart")
 if hr then v=hr.AssemblyLinearVelocity;if v.Magnitude<.1 then v=hr.Velocity end end
 local p=v*.12;if p.Magnitude>3 then p=p.Unit*3 end
 return ch.Position+p end
FH.startAL=function()
 if camC then return end
 camC=RS.RenderStepped:Connect(function()
  if not FH.on.aimlockS then return end
  if not aim()then return end
  if not charT or not charT.Parent then charT=findK()end
  if charT and charT.Parent then
   local p=predPos(charT)
   if p then workspace.CurrentCamera.CFrame=CFrame.lookAt(workspace.CurrentCamera.CFrame.Position,p)end end end)end
FH.stopAL=function()if camC then camC:Disconnect();camC=nil end;charT=nil end
local function findTrig()
 local g=LP.PlayerGui:FindFirstChild("GunGui");if not g then return nil end
 return g:FindFirstChild("TriggerButton",true)or g:FindFirstChild("Trigger",true)or g:FindFirstChild("ShootButton",true)end
local function shoot()
 local b=findTrig();if not b then return false end
 if firesignal then pcall(firesignal,b.MouseButton1Click);return true end
 pcall(function()b:Activate()end);return false end
local aSC,aimT=nil,0
FH.startAS2=function()
 if aSC then return end
 aimT=0
 aSC=RS.RenderStepped:Connect(function()
  if not FH.on.autoShootS then return end
  local mc=LP.Character;if not mc then aimT=0;return end
  if not aim()then aimT=0;return end
  if aimT==0 then aimT=tick();return end
  if tick()-ultD<.6 then return end
  local k=charT or findK()
  if not k or not k.Parent then return end
  if FH.vision(k)then if shoot()then ultD=tick();aimT=tick()end end end)end
FH.stopAS2=function()if aSC then aSC:Disconnect();aSC=nil end;aimT=0 end
local function getIcon(n)
 if n=="Esp" then return "👁" end
 if n=="Scientist" then return "🧪" end
 if n=="Class A" then return "💚" end
 if n=="Class S" then return "🎯" end
 if n=="Extra Stuff" then return "⚡" end
 return "🎃"
end
