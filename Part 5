 local l=Instance.new("TextLabel",t); l.Size=UDim2.new(1,-34,1,0); l.Position=UDim2.new(0,30,0,0); l.BackgroundTransparency=1; l.Text=n; l.TextColor3=cs and C.text_sub or C.text; l.TextScaled=true; l.Font=Enum.Font.GothamBold; l.TextXAlignment=Enum.TextXAlignment.Left
 local ck=false
 local function setSt(s) if s=="sel"then t.BackgroundColor3=C.bg_card_hl;t.BackgroundTransparency=0 else t.BackgroundColor3=C.bg_card;t.BackgroundTransparency=.2 end end
 t.MouseButton1Click:Connect(function() 
    if ck or cs or FH.pestana==n then return end
