-- ============ PARTE 9/9 - Anti-Notif + Mute (v5 lag fix) ============
local FH = getgenv().FH
if not FH or not FH.p8 then warn("[FH] Ejecuta Partes 1-8 primero") return end
if FH.p9 then warn("[FH] Parte 9 ya ejecutada") return end
local RS,PL,LP = FH.RS,FH.PL,FH.LP
local C = FH.C

FH.hideHealMsg = false
FH.muteGame = false

-- ===== Anti-Notif =====
local function esHealMsg(txt)
    if not txt or txt == "" then return false end
    return (txt:find("Earned", 1, true) and txt:find("Healed a Scientist", 1, true))
        or (txt:find("Class A", 1, true) and txt:find("Successfully Healed", 1, true))
end

local function checkLabel(lbl)
    if not lbl:IsA("TextLabel") then return end
    if esHealMsg(lbl.Text) then
        pcall(function()
            local p = lbl.Parent
            if p and not p:IsA("ScreenGui") then p:Destroy()
            else lbl:Destroy() end
        end)
    end
end

local hideScan = nil
local function startHide()
    if hideScan then return end
    -- Solo el loop. Sin hooks de DescendantAdded (evita lag con jackpot)
    hideScan = RS.Heartbeat:Connect(function()
        if not FH.hideHealMsg then return end
        -- Limitar a 10Hz para no saturar
        FH._lastHideScan = FH._lastHideScan or 0
        if tick() - FH._lastHideScan < 0.1 then return end
        FH._lastHideScan = tick()
        local pg = LP:FindFirstChild("PlayerGui")
        if not pg then return end
        for _, gui in ipairs(pg:GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, desc in ipairs(gui:GetDescendants()) do
                    if desc:IsA("TextLabel") then checkLabel(desc) end
                end
            end
        end
    end)
end
local function stopHide()
    FH.hideHealMsg = false
    if hideScan then hideScan:Disconnect(); hideScan = nil end
    FH._lastHideScan = nil
end

-- ===== Mute (sin hooks por sonido, solo loop throttled) =====
local mutedRefs = {}
local muteScan = nil

local function esGuiSound(s) return s:GetAttribute("FH_GUI") == true end

local function muteSound(s)
    if esGuiSound(s) then return end
    if mutedRefs[s] == nil then mutedRefs[s] = s.Volume end
    if s.Volume > 0 then pcall(function() s.Volume = 0 end) end
end

local function scanAndMute()
    for _, s in ipairs(workspace:GetDescendants()) do
        if s:IsA("Sound") and s.Volume > 0 then muteSound(s) end
    end
    for _, s in ipairs(FH.SS:GetDescendants()) do
        if s:IsA("Sound") and s.Volume > 0 then muteSound(s) end
    end
    for _, p in ipairs(PL:GetPlayers()) do
        if p.Character then
            for _, s in ipairs(p.Character:GetDescendants()) do
                if s:IsA("Sound") and s.Volume > 0 then muteSound(s) end
            end
        end
    end
end

local function startMute()
    scanAndMute()
    if muteScan then return end
    -- Loop a 10Hz (0.1s). Silencia sin agregar conexiones
    muteScan = RS.Heartbeat:Connect(function()
        if not FH.muteGame then return end
        FH._lastMuteScan = FH._lastMuteScan or 0
        if tick() - FH._lastMuteScan < 0.1 then return end
        FH._lastMuteScan = tick()
        scanAndMute()
    end)
end

local function restoreAll()
    for s, v in pairs(mutedRefs) do
        if s and s.Parent then
            pcall(function() s.Volume = v end)
        end
    end
    mutedRefs = {}
end

local function stopMute()
    FH.muteGame = false
    if muteScan then muteScan:Disconnect(); muteScan = nil end
    FH._lastMuteScan = nil
    restoreAll()
end

-- ===== Panel Class A =====
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Class A" then return end
    local opt = FH.crearOpcion
    opt("Delete Healed Msg 🚫", function(v)
        FH.hideHealMsg = v
        if v then startHide() else stopHide() end
    end)
    opt("Mute Game Sounds 🔇", function(v)
        FH.muteGame = v
        if v then startMute() else stopMute() end
    end)
end

if FH.pestana == "Class A" then FH.panel() end
FH.p9 = true
print("🎃 [9/9] Anti-Notif + Mute Game OK (v5 lag fix)")
