-- ============ PARTE 9/9 - Anti-Notif + Mute Game (v7 sin lag) ============
local FH = getgenv().FH
if not FH or not FH.p8 then warn("[FH] Ejecuta Partes 1-8 primero") return end
if FH.p9 then warn("[FH] Parte 9 ya ejecutada") return end
local RS,PL,LP = FH.RS,FH.PL,FH.LP
local C = FH.C

FH.hideHealMsg = false
FH.muteGame = false

local function esHealMsg(txt)
    if not txt or txt == "" then return false end
    return (txt:find("Earned", 1, true) and txt:find("Healed a Scientist", 1, true))
        or (txt:find("Class A", 1, true) and txt:find("Successfully Healed", 1, true))
end

local function checkLabel(lbl)
    if not lbl:IsA("TextLabel") then return end
    if esHealMsg(lbl.Text) then
        pcall(function()
            local p = lbl.Parent
            if p and not p:IsA("ScreenGui") then p:Destroy()
            else lbl:Destroy() end
        end)
    end
end

-- ===== Heal Msg: task.spawn loop cada 0.3s =====
local hideTask = nil
FH.startHide = function()
    FH.hideHealMsg = true
    if hideTask then return end
    hideTask = task.spawn(function()
        while FH.hideHealMsg do
            local pg = LP:FindFirstChild("PlayerGui")
            if pg then
                for _, gui in ipairs(pg:GetChildren()) do
                    if gui:IsA("ScreenGui") then
                        for _, desc in ipairs(gui:GetDescendants()) do
                            if desc:IsA("TextLabel") then checkLabel(desc) end
                        end
                    end
                end
            end
            task.wait(0.3)
        end
        hideTask = nil
    end)
end
FH.stopHide = function()
    FH.hideHealMsg = false
    hideTask = nil
end

-- ===== Mute: 100% hook-based, sin scans repetidos =====
local mutedRefs = {}
local muteConns = {}

local function esGuiSound(s) return s:GetAttribute("FH_GUI") == true end

local function trackSound(s)
    if not s:IsA("Sound") then return end
    if esGuiSound(s) then return end
    if s:GetAttribute("FH_HOOKED") then return end
    s:SetAttribute("FH_HOOKED", true)
    -- Guardar volumen original
    if mutedRefs[s] == nil then mutedRefs[s] = s.Volume end
    -- Silenciar ahora
    if s.Volume > 0 then pcall(function() s.Volume = 0 end) end
    -- Hook: cuando empiece a sonar
    table.insert(muteConns, s.Played:Connect(function()
        if FH.muteGame then pcall(function() s.Volume = 0 end) end
    end))
    -- Hook: cuando alguien intente subir el volumen
    table.insert(muteConns, s:GetPropertyChangedSignal("Volume"):Connect(function()
        if FH.muteGame and s.Volume > 0 and not esGuiSound(s) then
            pcall(function() s.Volume = 0 end)
        end
    end))
end

local muteScanOnce = nil
FH.startMute = function()
    FH.muteGame = true
    -- Hook para sonidos nuevos
    table.insert(muteConns, workspace.DescendantAdded:Connect(function(d)
        if FH.muteGame then trackSound(d) end
    end))
    table.insert(muteConns, FH.SS.DescendantAdded:Connect(function(d)
        if FH.muteGame then trackSound(d) end
    end))
    -- Scan único la primera vez
    if not muteScanOnce then
        task.spawn(function()
            for _, s in ipairs(workspace:GetDescendants()) do
                if s:IsA("Sound") then trackSound(s) end
            end
            for _, s in ipairs(FH.SS:GetDescendants()) do
                if s:IsA("Sound") then trackSound(s) end
            end
            for _, p in ipairs(PL:GetPlayers()) do
                if p.Character then
                    for _, s in ipairs(p.Character:GetDescendants()) do
                        if s:IsA("Sound") then trackSound(s) end
                    end
                end
            end
        end)
        muteScanOnce = true
    end
end

local function restoreAll()
    for s, v in pairs(mutedRefs) do
        if s and s.Parent then pcall(function() s.Volume = v end) end
        pcall(function() s:SetAttribute("FH_HOOKED", nil) end)
    end
    mutedRefs = {}
end

FH.stopMute = function()
    FH.muteGame = false
    for _, c in ipairs(muteConns) do pcall(function() c:Disconnect() end) end
    muteConns = {}
    restoreAll()
end

-- Enganche al panel: añade los toggles a Class A
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Class A" then return end
    local opt = FH.crearOpcion
    opt("Delete Healed Msg 🚫", function(v)
        if v then FH.startHide() else FH.stopHide() end
    end)
    opt("Mute Game Sounds 🔇", function(v)
        if v then FH.startMute() else FH.stopMute() end
    end)
end

