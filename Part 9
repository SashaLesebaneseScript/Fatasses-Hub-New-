-- ============ PARTE 9/9 - Anti-Notif + Mute Game (fix v2) ============
local FH = getgenv().FH
if not FH or not FH.p8 then warn("[FH] Ejecuta Partes 1-8 primero") return end
if FH.p9 then warn("[FH] Parte 9 ya ejecutada") return end
local RS,PL,LP = FH.RS,FH.PL,FH.LP
local C = FH.C

-- ===== Borrar mensajes de curación en pantalla =====
FH.hideHealMsg = false

local function scanHealNotifs()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") then
            for _, desc in ipairs(gui:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Text then
                    local t = desc.Text
                    if string.find(t, "Earned") and string.find(t, "Healed a Scientist") then
                        pcall(function()
                            local parent = desc.Parent
                            if parent and parent ~= gui then
                                parent:Destroy()
                            else
                                desc:Destroy()
                            end
                        end)
                    end
                end
            end
        end
    end
end

local hideT = nil
local function startHide()
    if hideT then return end
    hideT = task.spawn(function()
        while FH.hideHealMsg do
            pcall(scanHealNotifs)
            task.wait(0.2)
        end
        hideT = nil
    end)
end
local function stopHide()
    FH.hideHealMsg = false
    hideT = nil
end

-- ===== Mute Game Sounds (FIX v2 - silencia en el momento =====
FH.muteGame = false
local mutedRefs = {}
local muteConns = {}

local function isFHGuiSound(s)
    return s:GetAttribute("FH_GUI") == true
end

local function muteSound(s)
    if not s:IsA("Sound") then return end
    if isFHGuiSound(s) then return end
    if mutedRefs[s] == nil then
        mutedRefs[s] = s.Volume
    end
    if s.Volume > 0 then
        pcall(function() s.Volume = 0 end)
    end
    -- Tambien apagar el playing
    if s.IsPlaying then
        pcall(function() s.Volume = 0 end)
    end
end

local function muteAllNow()
    for _, s in ipairs(workspace:GetDescendants()) do
        if s:IsA("Sound") then muteSound(s) end
    end
    for _, s in ipairs(FH.SS:GetDescendants()) do
        if s:IsA("Sound") then muteSound(s) end
    end
    for _, p in ipairs(PL:GetPlayers()) do
        if p.Character then
            for _, s in ipairs(p.Character:GetDescendants()) do
                if s:IsA("Sound") then muteSound(s) end
            end
        end
    end
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        for _, s in ipairs(pg:GetDescendants()) do
            if s:IsA("Sound") then muteSound(s) end
        end
    end
end

local function restoreAll()
    for s, v in pairs(mutedRefs) do
        if s and s.Parent then
            pcall(function() s.Volume = v end)
        end
    end
    mutedRefs = {}
end

-- Conexiones: atrapar sonidos nuevos y cambios de Playing
local function attachHooks()
    -- Workspace: sonidos que se crean en cualquier parte
    table.insert(muteConns, workspace.DescendantAdded:Connect(function(d)
        if FH.muteGame and d:IsA("Sound") then muteSound(d) end
    end))
    table.insert(muteConns, FH.SS.DescendantAdded:Connect(function(d)
        if FH.muteGame and d:IsA("Sound") then muteSound(d) end
    end))
    -- Jugadores nuevos
    table.insert(muteConns, PL.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function(ch)
            if FH.muteGame then
                task.wait(0.1)
                for _, s in ipairs(ch:GetDescendants()) do
                    if s:IsA("Sound") then muteSound(s) end
                end
            end
        end)
    end))
    -- Loop de respaldo rapido: cada frame revisa si hay sonidos sonando sin mutear
    table.insert(muteConns, RS.Heartbeat:Connect(function()
        if not FH.muteGame then return end
        for _, s in ipairs(workspace:GetDescendants()) do
            if s:IsA("Sound") and s.IsPlaying and s.Volume > 0 and not isFHGuiSound(s) then
                muteSound(s)
            end
        end
    end))
end

local function detachHooks()
    for _, c in ipairs(muteConns) do
        pcall(function() c:Disconnect() end)
    end
    muteConns = {}
end

local function startMute()
    detachHooks()
    attachHooks()
    muteAllNow()
end
local function stopMute()
    FH.muteGame = false
    detachHooks()
    restoreAll()
end

-- Hook panel: añadir toggles a Class A
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Class A" then return end
    local opt = FH.crearOpcion
    local hdr = function(t)
        local h = Instance.new("TextLabel", FH.oc)
        h.Size = UDim2.new(1,0,0,22)
        h.BackgroundTransparency = 1
        h.Text = t
        h.TextColor3 = C.accent
        h.Font = Enum.Font.GothamBold
        h.TextScaled = true
        h.TextXAlignment = Enum.TextXAlignment.Left
    end
    hdr("── Notificaciones ──")
    opt("Delete Healed Msg 🚫", function(v)
        FH.hideHealMsg = v
        if v then startHide() else stopHide() end
    end)
    hdr("── Sonido ──")
    opt("Mute Game Sounds 🔇", function(v)
        FH.muteGame = v
        if v then startMute() else stopMute() end
    end)
end

if FH.pestana == "Class A" then FH.panel() end
FH.p9 = true
print("🎃 [9/9] Anti-Notif + Mute Game OK (v2)")
