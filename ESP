local FH = getgenv().FH
if not FH or not FH.p1 then return end
local WS, PL, LP = FH.WS, FH.PL, FH.LP
local C = FH.C

FH.espTasksCache = {}
FH.espPlayersCache = {}

local function getTaskName(obj)
    local map = obj.Parent
    if not map then return obj.Name end
    if map.Name == "Map1" then return "Patient " .. (obj.Name:match("%d+") or "") end
    if map.Name == "Map2" then return "Tube " .. (obj.Name:match("%d+") or "") end
    if map.Name == "Map3" then return "Panel " .. (obj.Name:match("%d+") or "") end
    return obj.Name
end

FH.startESP = function(v)
    if not v then
        for _, data in pairs(FH.espTasksCache) do 
            if data.hl then data.hl:Destroy() end
            if data.bg then data.bg:Destroy() end 
        end
        FH.espTasksCache = {}
        return
    end
    task.spawn(function()
        while FH.on.espActive do
            local tasks = {}
            for i = 1, 3 do
                local map = WS:FindFirstChild("Map" .. i)
                if map then
                    for _, obj in ipairs(map:GetDescendants()) do
                        if obj:IsA("Model") and obj.Name:match("^Task_%d+$") then
                            table.insert(tasks, obj)
                        end
                    end
                end
            end

            for _, obj in ipairs(tasks) do
                local progress = "0/4"
                local isComplete = false
                local billboard = obj:FindFirstChild("BillboardGui", true)
                if billboard then
                    for _, txt in ipairs(billboard:GetDescendants()) do
                        if txt:IsA("TextLabel") then
                            local match = string.match(txt.Text, "(%d+/%d+)")
                            if match then
                                if match == "4/4" then
                                    progress = match
                                    isComplete = true
                                    break
                                elseif progress == "0/4" then
                                    progress = match
                                end
                            end
                        end
                    end
                end
                
                local color = isComplete and Color3.fromRGB(152, 255, 152) or C.accent
                
                if not FH.espTasksCache[obj] then
                    local hl = Instance.new("Highlight")
                    hl.Parent = obj
                    hl.Adornee = obj
                    hl.FillColor = color
                    hl.OutlineColor = Color3.new(1,1,1)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    
                    local bg = Instance.new("BillboardGui")
                    bg.Parent = obj
                    bg.Adornee = obj
                    bg.Size = UDim2.new(0, 120, 0, 40)
                    bg.StudsOffset = Vector3.new(0, 2, 0)
                    bg.AlwaysOnTop = true
                    
                    local progTxt = Instance.new("TextLabel", bg)
                    progTxt.Size = UDim2.new(1, 0, 0.5, 0)
                    progTxt.Position = UDim2.new(0, 0, 0, 0)
                    progTxt.BackgroundTransparency = 1
                    progTxt.Text = progress
                    progTxt.TextColor3 = color
                    progTxt.TextStrokeTransparency = 0
                    progTxt.Font = Enum.Font.GothamBold
                    progTxt.TextScaled = true
                    
                    local txt = Instance.new("TextLabel", bg)
                    txt.Size = UDim2.new(1, 0, 0.5, 0)
                    txt.Position = UDim2.new(0, 0, 0.5, 0)
                    txt.BackgroundTransparency = 1
                    txt.Text = getTaskName(obj)
                    txt.TextColor3 = color
                    txt.TextStrokeTransparency = 0
                    txt.Font = Enum.Font.GothamBold
                    txt.TextScaled = true
                    
                    FH.espTasksCache[obj] = {hl = hl, bg = bg, txt = txt, progTxt = progTxt}
                else
                    local data = FH.espTasksCache[obj]
                    data.hl.FillColor = color
                    data.txt.TextColor3 = color
                    data.txt.Text = getTaskName(obj)
                    data.progTxt.Text = progress
                    data.progTxt.TextColor3 = color
                end
            end
            
            for obj, data in pairs(FH.espTasksCache) do
                if not obj.Parent or not obj:IsDescendantOf(WS) then
                    if data.hl then data.hl:Destroy() end
                    if data.bg then data.bg:Destroy() end
                    FH.espTasksCache[obj] = nil
                end
            end
            task.wait(1)
        end
    end)
end

FH.startEP = function(v)
    if not v then
        for _, data in pairs(FH.espPlayersCache) do 
            if data.hl then data.hl:Destroy() end
            if data.bg then data.bg:Destroy() end 
        end
        FH.espPlayersCache = {}
        return
    end
    task.spawn(function()
        while FH.on.espPlActive do
            local expPlayer = FH.getExperiment() or nil
            local expHRP = expPlayer and expPlayer.Character and expPlayer.Character:FindFirstChild("HumanoidRootPart")
            
            for _, p in ipairs(PL:GetPlayers()) do
                if p ~= LP and p.Character then
                    local char = p.Character
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    
                    if hum and hum.Health > 0 and hrp then
                        local distToExp = expHRP and (expHRP.Position - hrp.Position).Magnitude or 9999
                        local color = Color3.fromRGB(150, 150, 150)
                        local showHealth = false
                        
                        if expPlayer then
                            if p == expPlayer then
                                color = Color3.fromRGB(220, 20, 60)
                            elseif distToExp < 600 then
                                color = Color3.fromRGB(152, 255, 152)
                                showHealth = true
                            end
                        end
                        
                        if not FH.espPlayersCache[char] then
                            local hl = Instance.new("Highlight")
                            hl.Parent = char
                            hl.Adornee = char
                            hl.FillColor = color
                            hl.OutlineColor = color
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            
                            local bg = Instance.new("BillboardGui")
                            bg.Parent = char
                            bg.Adornee = char
                            bg.Size = UDim2.new(0, 120, 0, 40)
                            bg.StudsOffset = Vector3.new(0, 3, 0)
                            bg.AlwaysOnTop = true
                            
                            local txt = Instance.new("TextLabel", bg)
                            txt.Size = UDim2.new(1, 0, 0.5, 0)
                            txt.Position = UDim2.new(0, 0, 0, 0)
                            txt.BackgroundTransparency = 1
                            txt.Text = p.Name
                            txt.TextColor3 = color
                            txt.TextStrokeTransparency = 0
                            txt.Font = Enum.Font.GothamBold
                            txt.TextScaled = true
                            
                            local hpTxt = Instance.new("TextLabel", bg)
                            hpTxt.Size = UDim2.new(1, 0, 0.5, 0)
                            hpTxt.Position = UDim2.new(0, 0, 0.5, 0)
                            hpTxt.BackgroundTransparency = 1
                            hpTxt.Text = ""
                            hpTxt.TextColor3 = color
                            hpTxt.TextStrokeTransparency = 0
                            hpTxt.Font = Enum.Font.GothamBold
                            hpTxt.TextScaled = true
                            hpTxt.Visible = showHealth
                            
                            FH.espPlayersCache[char] = {hl = hl, bg = bg, txt = txt, hpTxt = hpTxt}
                        else
                            local data = FH.espPlayersCache[char]
                            data.hl.FillColor = color
                            data.hl.OutlineColor = color
                            data.txt.TextColor3 = color
                            data.hpTxt.TextColor3 = color
                            data.hpTxt.Visible = showHealth
                            if showHealth then
                                data.hpTxt.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
                            end
                        end
                    end
                end
            end
            for char, data in pairs(FH.espPlayersCache) do
                if not char.Parent then
                    if data.hl then data.hl:Destroy() end
                    if data.bg then data.bg:Destroy() end
                    FH.espPlayersCache[char] = nil
                end
            end
            task.wait(0.5)
        end
    end)
end

local origPanel = FH.panel
FH.panel = function()
    origPanel()
    local opt = FH.crearOpcion
    
    if FH.pestana == "ESP" then
        opt("ESP Tasks", function(v) FH.on.espActive = v; FH.startESP(v) end)
        opt("ESP Players", function(v) FH.on.espPlActive = v; FH.startEP(v) end)
        opt("Full Bright", function(v) 
            local L = game.Lighting
            if v then 
                L.Brightness = 3; L.ClockTime = 12; L.FogEnd = 100000
                L.Ambient = Color3.fromRGB(255,255,255); L.OutdoorAmbient = Color3.fromRGB(255,255,255)
            else 
                L.Brightness = 1; L.ClockTime = 14; L.FogEnd = 1000
                L.Ambient = Color3.fromRGB(70,70,70); L.OutdoorAmbient = Color3.fromRGB(128,128,128)
            end
        end)
    end
end
FH.p2 = true
