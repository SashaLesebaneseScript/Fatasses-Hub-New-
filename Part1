FH.crearOpcion=function(nombre,cb,isBlatant)
 local o=Instance.new("Frame",oc)
 o.Size=UDim2.new(1,0,0,40);o.BackgroundColor3=C.bg_card;o.BackgroundTransparency=.2
 o.BorderSizePixel=0;o.ClipsDescendants=true
 Instance.new("UICorner",o).CornerRadius=UDim.new(0,10)
 local s=Instance.new("UIStroke",o);s.Color=C.border;s.Thickness=1;s.Transparency=.5
 local l=Instance.new("TextLabel",o)
 l.Size=UDim2.new(1,-80,1,0);l.Position=UDim2.new(0,12,0,0);l.BackgroundTransparency=1
 l.Text=nombre;l.TextColor3=C.text;l.TextScaled=true
 l.Font=Enum.Font.GothamBold;l.TextXAlignment=Enum.TextXAlignment.Left;l.TextWrapped=true
 local tb2=Instance.new("TextButton",o)
 tb2.Size=UDim2.new(0,46,0,24);tb2.Position=UDim2.new(1,-58,.5,-12)
 tb2.BackgroundColor3=Color3.fromRGB(35,15,45);tb2.Text="";tb2.BorderSizePixel=0;tb2.AutoButtonColor=false
 Instance.new("UICorner",tb2).CornerRadius=UDim.new(1,0)
 local ts=Instance.new("UIStroke",tb2);ts.Color=C.border;ts.Thickness=1;ts.Transparency=.4
 local b=Instance.new("Frame",tb2)
 b.Size=UDim2.new(0,18,0,18);b.Position=UDim2.new(0,3,.5,-9)
 b.BackgroundColor3=Color3.fromRGB(120,90,130);b.BorderSizePixel=0
 Instance.new("UICorner",b).CornerRadius=UDim.new(1,0)
 local es=FH.est[nombre]or false
 local function setV(a,an)
  local t=an and .4 or 0
  local i=TweenInfo.new(t,an and Enum.EasingStyle.Back or Enum.EasingStyle.Linear,Enum.EasingDirection.Out)
  if a then
   FH.TW:Create(b,i,{Position=UDim2.new(0,24,.5,-9),BackgroundColor3=C.accent,Size=UDim2.new(0,20,0,20)}):Play()
   FH.TW:Create(tb2,i,{BackgroundColor3=C.accent4}):Play()
   FH.TW:Create(ts,i,{Color=C.accent,Transparency=.1}):Play()
  else
   FH.TW:Create(b,i,{Position=UDim2.new(0,3,.5,-9),BackgroundColor3=Color3.fromRGB(120,90,130),Size=UDim2.new(0,18,0,18)}):Play()
   FH.TW:Create(tb2,i,{BackgroundColor3=Color3.fromRGB(35,15,45)}):Play()
   FH.TW:Create(ts,i,{Color=C.border,Transparency=.4}):Play()
  end
 end
 setV(es,false)
 local function tg()
  if isBlatant and not FH.blatantMode then
      -- Redirigir a Blatant
      if FH.pestana ~= "Blatant" then
          FH.pestana = "Blatant"
          FH.panel()
      end
      return
  end
  es=not es;FH.est[nombre]=es;setV(es,true)
  if cb then pcall(cb,es)end
 end
 tb2.MouseButton1Click:Connect(tg)
 l.InputBegan:Connect(function(i)if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then tg()end end)
 l.Active=true
end

