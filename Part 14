-- ============ PARTE 14/14 - ESP Completed ============
local FH = getgenv().FH
if not FH or not FH.p13 then warn("[FH] Ejecuta Partes 1-13 primero") return end
if FH.p14 then warn("[FH] Parte 14 ya ejecutada") return end
local RS,PL,WS,LP = FH.RS,FH.PL,FH.WS,FH.LP
local C = FH.C

FH.espHideCompleted = false
FH._completedType = nil
FH._completedUntil = 0

-- Hook EndTask: cuando el usuario completa una tarea, marca todo como completado
if FH.TR then
    FH.TR.OnClientEvent:Connect(function(accion, taskID, guiName)
        if accion == "EndTask" then
            -- Detecta el tipo por el GUI name
            if guiName == "TaskGuiMap1" then
                FH._completedType = "patient"
            elseif guiName == "TaskGuiMap2" then
                FH._completedType = "tube"
            else
                FH._completedType = "any"
            end
            FH._completedUntil = tick() + 12
        end
    end)
end

-- Funcion: devuelve true si el objeto debe considerarse "completado"
local function esCompletado(obj)
    if tick() > FH._completedUntil then return false end
    if not FH._completedType then return false end
    if FH._completedType == "any" then return true end
    local n = string.lower(obj.Name)
    if FH._completedType == "patient" and string.find(n, "patient", 1, true) then return true end
    if FH._completedType == "tube" and string.find(n, "tube", 1, true) then return true end
    return false
end

-- Hook al Highlight: parcheamos la funcion que crea highlights para añadir un label
-- En su lugar, hacemos un loop que revisa highlights existentes y les añade "Completed"
RS.Heartbeat:Connect(function()
    FH._lastCompCheck = FH._lastCompCheck or 0
    if tick() - FH._lastCompCheck < 0.5 then return end
    FH._lastCompCheck = tick()
    for _, m in ipairs(WS:GetChildren()) do
        if m:IsA("Model") then
            local hl = m:FindFirstChild("ESP_Obj_HL")
            if hl then
                local completo = esCompletado(m)
                if completo then
                    -- Marcar visualmente
                    hl.FillColor = Color3.fromRGB(80, 255, 80)
                    hl.OutlineColor = Color3.fromRGB(140, 255, 140)
                    -- Añadir billboard "Completed" si no existe
                    local bb = m:FindFirstChild("ESP_Completed_BB")
                    if not bb then
                        bb = Instance.new("BillboardGui")
                        bb.Name = "ESP_Completed_BB"
                        bb.Size = UDim2.new(0, 200, 0, 40)
                        bb.StudsOffset = Vector3.new(0, 4, 0)
                        bb.AlwaysOnTop = true
                        bb.Parent = m
                        local t = Instance.new("TextLabel", bb)
                        t.Size = UDim2.new(1, 0, 1, 0)
                        t.BackgroundTransparency = 1
                        t.Text = "✅ Completed"
                        t.TextColor3 = Color3.fromRGB(80, 255, 80)
                        t.TextStrokeTransparency = 0
                        t.TextStrokeColor3 = Color3.fromRGB(20, 5, 20)
                        t.Font = Enum.Font.GothamBold
                        t.TextScaled = true
                    end
                    -- Ocultar si toggle activo
                    if FH.espHideCompleted then
                        if hl.Enabled then hl.Enabled = false end
                        if bb and bb.Enabled then bb.Enabled = false end
                    else
                        if not hl.Enabled then hl.Enabled = true end
                        if bb and not bb.Enabled then bb.Enabled = true end
                    end
                else
                    -- No completado: restaurar color normal
                    local bb = m:FindFirstChild("ESP_Completed_BB")
                    if bb then bb:Destroy() end
                    if hl and not hl.Enabled then hl.Enabled = true end
                end
            end
        end
    end
end)

FH.p14 = true
print("🎃 [14/14] ESP Completed OK")
