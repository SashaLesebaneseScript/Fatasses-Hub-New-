-- ============ PARTE 18/18 - Fake VIP / Max Stats (In-Game) ============
local FH = getgenv().FH
if not FH or not FH.p17 then warn("[FH] Ejecuta Partes 1-17 primero") return end
if FH.p18 then warn("[FH] Parte 18 ya ejecutada") return end
local C = FH.C
local RST = FH.RST
local LP = FH.LP

FH.fakeStatsActive = false

-- ===== 1. Hook al ChatHandler para forzar el Tag VIP real =====
task.spawn(function()
    task.wait(1)
    pcall(function()
        local mt = getrawmetatable(game)
        if setreadonly then setreadonly(mt, false) end
        local oldNamecall = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            -- Si el juego pregunta por tu tag de chat
            if method == "InvokeServer" and self.Name == "ChatHandler" then
                if args[1] == LP and FH.fakeStatsActive then
                    -- Retornamos el tag VIP falso para que el juego lo pinte
                    return {Tag = "VIP", Color = Color3.fromRGB(255, 215, 0)}
                end
            end
            return oldNamecall(self, ...)
        end)
        if setreadonly then setreadonly(mt, true) end
    end)
end)

-- ===== 2. Loop para forzar Dinero y XP en el perfil =====
task.spawn(function()
    while true do
        if FH.fakeStatsActive then
            local pg = LP:FindFirstChild("PlayerGui")
            if pg then
                for _, obj in ipairs(pg:GetDescendants()) do
                    if obj:IsA("TextLabel") and obj.Text ~= "" then
                        
                        -- Forzar Dinero (Collected Data)
                        if string.find(obj.Text, "Data") then
                            obj.Text = string.gsub(obj.Text, "%d+", "99999999999")
                        
                        -- Forzar XP / Level
                        elseif string.find(obj.Text, "XP") or string.find(obj.Text, "Level") then
                            obj.Text = string.gsub(obj.Text, "%d+", "999")
                        end
                        
                    end
                end
            end
        end
        task.wait(1.5) -- Escanea cada 1.5 segundos para no lagear
    end
end)

-- Añadir al panel de Fun
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Fun" then return end
    local opt = FH.crearOpcion
    opt("Fake VIP & Max Stats 👑", function(v) 
        FH.fakeStatsActive = v 
        if not v then
            -- Si se apaga, forzamos un update de la GUI para restaurar los valores reales
            -- (El juego los restaurará solo en el siguiente tick si no los sobreescribimos)
        end
    end)
end

if FH.pestana == "Fun" then FH.panel() end
FH.p18 = true
print("🎃 [18/18] Fake VIP & Max Stats (In-Game) OK")
