-- ============ PARTE 18/18 - Fake VIP Chat Tag ============
local FH = getgenv().FH
if not FH or not FH.p17 then warn("[FH] Ejecuta Partes 1-17 primero") return end
if FH.p18 then warn("[FH] Parte 18 ya ejecutada") return end
local TextChatService = game:GetService("TextChatService")
local C = FH.C

FH.fakeVipActive = false

-- Interceptar mensajes del chat
local oldOnIncomingMessage = TextChatService.OnIncomingMessage

TextChatService.OnIncomingMessage = function(message)
    local props = Instance.new("TextChatMessageProperties")
    
    -- Si eres tú y el toggle está activo
    if message.TextSource and message.TextSource.UserId == FH.LP.UserId then
        if FH.fakeVipActive then
            -- Etiqueta VIP (Dorada) + Nivel Falso
            local fakeTag = "<font color='#ffd700'>[VIP]</font> <font color='#00ffcc'>[Mastery 100]</font> "
            if message.PrefixText then
                props.PrefixText = fakeTag .. message.PrefixText
            else
                props.PrefixText = fakeTag
            end
        end
    end
    
    -- Llamar al original por si acaso
    if oldOnIncomingMessage then
        local ok, oldProps = pcall(oldOnIncomingMessage, message)
        if ok and oldProps then return oldProps end
    end
    
    return props
end

-- Añadir al panel de Fun
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Fun" then return end
    local opt = FH.crearOpcion
    opt("Fake VIP Tag 👑", function(v) 
        FH.fakeVipActive = v 
    end)
end

if FH.pestana == "Fun" then FH.panel() end
FH.p18 = true
print("🎃 [18/18] Fake VIP Chat Tag OK")
