local FH = getgenv().FH
if not FH or not FH.p1 then return end
local RS, PL, LP, RST = FH.RS, FH.PL, FH.LP, FH.RST

local HealEv = RST:FindFirstChild("HealingAbility") and RST.HealingAbility:FindFirstChild("HealingEvent")

FH.startHeals = function()
    task.spawn(function()
        while task.wait(0.1) do 
            if FH.on.autoHeal or FH.on.autoHealSelf then
                local target = FH.on.autoHealSelf and LP or FH.injPlayer(9999)
                if target and target.Character and HealEv then
                    pcall(function() HealEv:FireServer("StartVisuals", target) end)
                    for i = 1, 6 do pcall(function() HealEv:FireServer("HealTick", target) end) end
                    pcall(function() HealEv:FireServer("GiveSpeedBoost") end)
                end
            end
        end
    end)
    task.spawn(function()
        while task.wait(0.1) do
            if FH.on.jackpot then
                local target = FH.injPlayer(9999)
                if target and target.Character and HealEv then
                    for i = 1, 4 do
                        pcall(function() HealEv:FireServer("StartVisuals", target) end)
                        pcall(function() HealEv:FireServer("HealTick", target) end)
                        pcall(function() HealEv:FireServer("GiveSpeedBoost") end)
                    end
                else
                    pcall(function() HealEv:FireServer("RequestCooldownCheck") end)
                end
            end
        end
    end)
    task.spawn(function()
        while task.wait(0.1) do
            if not FH.fakeUI then continue end
            local hg = LP.PlayerGui:FindFirstChild("HealingGui")
            if hg and hg:FindFirstChild("HealingButton") then
                local ct = hg.HealingButton:FindFirstChild("CooldownText")
                if ct then ct.Text = "9999/30" end
            end
        end
    end)
end
FH.startHeals()

local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Class A" then return end
    local opt = FH.crearOpcion
    opt("Infinite Healing Range", function(v) FH.infiniteRange = v end)
    opt("Show 9999/30 UI", function(v) FH.fakeUI = v end)
    opt("Auto Heal", function(v) FH.on.autoHeal = v end)
    opt("Auto Heal Self", function(v) FH.on.autoHealSelf = v end)
    opt("I JUST HIT THE JACKPOOOOTTTTTT", function(v) FH.on.jackpot = v end)
end
FH.p4 = true
