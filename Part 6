-- ============ PARTE 6/6 - Class S Extension ============
local FH = getgenv().FH
if not FH or not FH.p5 then warn("[FH] Ejecuta Partes 1-5 primero") return end
if FH.p6 then warn("[FH] Parte 6 ya ejecutada") return end
local RS,PL,WS,RST,LP = FH.RS,FH.PL,FH.WS,FH.RST,FH.LP
local C = FH.C

local gunEv
local function getGun()
    if gunEv and gunEv.Parent then return gunEv end
    gunEv = RST:FindFirstChild("GunEvent")
    return gunEv
end

local function getKiller() return FH.updateKiller() end

local function headPos(char)
    if not char then return nil end
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    return head and head.Position or nil
end

local function crosshairPos()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local vp = cam.ViewportSize
    local ray = cam:ViewportPointToRay(vp.X/2, vp.Y/2)
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {LP.Character}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local r = workspace:Raycast(ray.Origin, ray.Direction*500, rp)
    if r then return r.Position end
    return ray.Origin + ray.Direction*500
end

local S = {
    noCooldown=false, silentAim=false, autoFire=false,
    forceFire=false, alwaysStun=false, rate=0.5, lastShot=0,
}

local function fireRemote(pos)
    if not pos then return false end
    local g = getGun()
    if not g then return false end
    local ok = pcall(function() g:FireServer("Shoot", pos) end)
    if ok then S.lastShot = tick() end
    return ok
end

local function fireSignalTrigger()
    local gg = LP.PlayerGui:FindFirstChild("GunGui")
    if not gg then return false end
    local tb = gg:FindFirstChild("TriggerButton")
    if not tb or not firesignal then return false end
    pcall(firesignal, tb.MouseButton1Click)
    return true
end

-- Detectar aiming por atributo (el juego lo pone)
local function isAiming()
    local mc = LP.Character
    return mc and mc:GetAttribute("IsAiming") == true
end

-- ===== No Cooldown =====
-- Dispara SIEMPRE (ignora check de aim). Silent Aim respeta LOS.
local ncT
local function startNC()
    if ncT then return end
    ncT = task.spawn(function()
        while S.noCooldown do
            local pos
            if S.silentAim then
                local k = getKiller()
                if k and FH.vision(k) then
                    pos = headPos(k)
                end
            end
            if not pos then pos = crosshairPos() end
            if pos then
                local ok = fireRemote(pos)
                -- Fallback: si el remote no funciono, intentar via boton
                if not ok then fireSignalTrigger() end
            end
            task.wait(S.rate)
        end
        ncT = nil
    end)
end
local function stopNC() S.noCooldown = false; ncT = nil end

-- ===== Auto Fire (solo cuando estas aimando de verdad) =====
local afT
local function startAF()
    if afT then return end
    afT = task.spawn(function()
        while S.autoFire do
            if isAiming() then
                local k = getKiller()
                if k and FH.vision(k) then
                    local pos = S.silentAim and headPos(k) or crosshairPos()
                    fireRemote(pos)
                end
            end
            task.wait(S.rate)
        end
        afT = nil
    end)
end
local function stopAF() S.autoFire = false; afT = nil end

-- ===== Always Stunned Killer =====
-- Anade un "Stunner" falso al killer (client-side) para que el juego lo trate como stuneado
local asT
local function refreshStun()
    local k = getKiller()
    if not k then return end
    if not k:FindFirstChild("Stunner") then
        local s = Instance.new("Folder")
        s.Name = "Stunner"
        s.Parent = k
    end
end
local function startAS()
    if asT then return end
    asT = task.spawn(function()
        while S.alwaysStun do
            pcall(refreshStun)
            task.wait(0.5)
        end
        asT = nil
    end)
end
local function stopAS()
    S.alwaysStun = false
    asT = nil
    -- Limpiar Stunners falsos de todos
    for _, p in ipairs(PL:GetPlayers()) do
        if p.Character then
            local s = p.Character:FindFirstChild("Stunner")
            if s and s:IsA("Folder") then s:Destroy() end
        end
    end
end

-- ===== Hook panel =====
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Class S" then return end
    local opt = FH.crearOpcion
    local hdr = function(t)
        local h = Instance.new("TextLabel", FH.oc)
        h.Size = UDim2.new(1,0,0,22)
        h.BackgroundTransparency = 1
        h.Text = t
        h.TextColor3 = C.accent
        h.Font = Enum.Font.GothamBold
        h.TextScaled = true
        h.TextXAlignment = Enum.TextXAlignment.Left
    end
    hdr("── Disparo ──")
    opt("No Cooldown ∞", function(v)
        S.noCooldown = v
        if v then startNC() else stopNC() end
    end)
    opt("Silent Aim 👻", function(v) S.silentAim = v end)
    opt("Auto Fire 🔫", function(v)
        S.autoFire = v
        if v then startAF() else stopAF() end
    end)
    hdr("── Killer ──")
    opt("Always Stunned ⚡", function(v)
        S.alwaysStun = v
        if v then startAS() else stopAS() end
    end)
end

if FH.pestana == "Class S" then FH.panel() end
FH.p6 = true
print("🎃 [6/6] Class S Extension OK")
