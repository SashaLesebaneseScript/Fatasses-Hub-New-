-- ============ PARTE 6/6 - Class S Extension (simplified) ============
local FH = getgenv().FH
if not FH or not FH.p5 then warn("[FH] Ejecuta Partes 1-5 primero") return end
if FH.p6 then warn("[FH] Parte 6 ya ejecutada") return end
local RS,PL,WS,RST,LP = FH.RS,FH.PL,FH.WS,FH.RST,FH.LP
local C = FH.C

-- GunEvent
local gunEv
local function getGun()
    if gunEv and gunEv.Parent then return gunEv end
    gunEv = RST:FindFirstChild("GunEvent")
    return gunEv
end

-- Killer = jugador MAS ALTO (solo hay 1)
local function getKiller()
    local best, bestH = nil, 6.5
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local ok, sz = pcall(function() return p.Character:GetExtentsSize().Y end)
                if ok and sz and sz > bestH then
                    bestH = sz
                    best = p.Character
                end
            end
        end
    end
    return best
end

local function headPos(char)
    if not char then return nil end
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    return head and head.Position or nil
end

local function crosshairPos()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local vp = cam.ViewportSize
    local ray = cam:ViewportPointToRay(vp.X/2, vp.Y/2)
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {LP.Character}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local r = workspace:Raycast(ray.Origin, ray.Direction*500, rp)
    if r then return r.Position end
    return ray.Origin + ray.Direction*500
end

local S = { noCooldown=false, silentAim=false, autoFire=false, rate=0.5 }

local function shoot(pos)
    if not pos then return false end
    local g = getGun()
    if not g then return false end
    return pcall(function() g:FireServer("Shoot", pos) end)
end

-- Detectar F (independiente del cooldown del cliente)
local holding = false
FH.UI.InputBegan:Connect(function(inp, proc)
    if proc then return end
    if inp.KeyCode == Enum.KeyCode.F or inp.KeyCode == Enum.KeyCode.ButtonL2 then
        holding = true
    end
end)
FH.UI.InputEnded:Connect(function(inp)
    if inp.KeyCode == Enum.KeyCode.F or inp.KeyCode == Enum.KeyCode.ButtonL2 then
        holding = false
    end
end)

-- No Cooldown: dispara cada 0.5s mientras mantengas F
-- Bypassa el lock local de 40s del cliente completamente
local ncT
local function startNC()
    if ncT then return end
    ncT = task.spawn(function()
        while S.noCooldown do
            if holding then
                local pos = S.silentAim and headPos(getKiller()) or crosshairPos()
                if pos then shoot(pos) end
            end
            task.wait(S.rate)
        end
        ncT = nil
    end)
end
local function stopNC() S.noCooldown = false; ncT = nil end

-- Auto Fire: dispara SOLO si el killer es visible y mantienes F
local afT
local function startAF()
    if afT then return end
    afT = task.spawn(function()
        while S.autoFire do
            if holding then
                local k = getKiller()
                if k and FH.vision(k) then
                    local pos = S.silentAim and headPos(k) or crosshairPos()
                    if pos then shoot(pos) end
                end
            end
            task.wait(S.rate)
        end
        afT = nil
    end)
end
local function stopAF() S.autoFire = false; afT = nil end

-- Hook panel de Class S
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Class S" then return end
    local opt = FH.crearOpcion
    local hdr = function(t)
        local h = Instance.new("TextLabel", FH.oc)
        h.Size = UDim2.new(1,0,0,22)
        h.BackgroundTransparency = 1
        h.Text = t
        h.TextColor3 = C.accent
        h.Font = Enum.Font.GothamBold
        h.TextScaled = true
        h.TextXAlignment = Enum.TextXAlignment.Left
    end
    hdr("── Disparo ──")
    opt("No Cooldown ∞", function(v)
        S.noCooldown = v
        if v then startNC() else stopNC() end
    end)
    opt("Silent Aim 👻", function(v) S.silentAim = v end)
    opt("Auto Fire 🔫", function(v)
        S.autoFire = v
        if v then startAF() else stopAF() end
    end)
end

if FH.pestana == "Class S" then FH.panel() end
FH.p6 = true
print("🎃 [6/6] Class S Extension OK (simplified)")
