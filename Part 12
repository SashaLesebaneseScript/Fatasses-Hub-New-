-- ===== Panel =====
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Fun" then return end
    local opt = FH.crearOpcion
    local hdr = function(txt)
        local h = Instance.new("TextLabel", FH.oc)
        h.Size = UDim2.new(1,0,0,22)
        h.BackgroundTransparency = 1
        h.Text = txt
        h.TextColor3 = C.accent
        h.Font = Enum.Font.GothamBold
        h.TextScaled = true
        h.TextXAlignment = Enum.TextXAlignment.Left
    end

    hdr("── Emotes (toggle) ──")
    for _, em in ipairs(FH.EMOTES) do
        opt("▶ " .. em.name, function(v)
            if v then
                FH.emoteLoopActive[em.id] = false
                toggleEmote(em.id)
            else
                stopEmoteById(em.id)
            end
        end)
    end

    hdr("── Acciones ──")
    opt("Ragdoll 🕺", function(v) FH.fun.ragdoll = v; setRagdoll(v) end)
    opt("Dance 💃", function(v) FH.fun.dance = v; setDance(v) end)
    opt("Swim 🏊", function(v) FH.fun.swim = v; setSwim(v) end)
    opt("Fall 🤕", function(v)
        FH.fun.fall = v
        if v then doFall(); FH.est["Fall 🤕"] = false end
    end)
    opt("Enable Jump 🦘", function(v)
        FH.fun.enableJump = v
        if v then startEnableJump() else stopEnableJump() end
    end)
    opt("Inf Jump ♾️", function(v)
        FH.fun.infJump = v
        if v then startInfJump() else stopInfJump() end
    end)
    opt("Guardian 🛡️", function(v)
        FH.fun.guardian = v
        if v then startGuardian() else stopGuardian() end
    end)

    local holder = Instance.new("Frame", FH.oc)
    holder.Size = UDim2.new(1, 0, 0, 40)
    holder.BackgroundColor3 = C.bg_card
    holder.BackgroundTransparency = 0.2
    holder.BorderSizePixel = 0
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)
    local hs = Instance.new("UIStroke", holder)
    hs.Color = C.border; hs.Thickness = 1; hs.Transparency = 0.5
    local l1 = Instance.new("TextLabel", holder)
    l1.Size = UDim2.new(0, 84, 1, 0); l1.Position = UDim2.new(0, 12, 0, 0)
    l1.BackgroundTransparency = 1; l1.Text = "Distancia"
    l1.TextColor3 = C.text; l1.TextScaled = true
    l1.Font = Enum.Font.GothamBold; l1.TextXAlignment = Enum.TextXAlignment.Left
    local valL = Instance.new("TextLabel", holder)
    valL.Size = UDim2.new(0, 40, 1, 0); valL.Position = UDim2.new(1, -50, 0, 0)
    valL.BackgroundTransparency = 1; valL.Text = string.format("%.1f", FH.fun.guardianRadius)
    valL.TextColor3 = C.accent; valL.TextScaled = true
    valL.Font = Enum.Font.GothamBold
    local bar = Instance.new("Frame", holder)
    bar.Size = UDim2.new(1, -190, 0, 14); bar.Position = UDim2.new(0, 100, 0.5, -7)
    bar.BackgroundColor3 = Color3.fromRGB(20, 10, 28); bar.BorderSizePixel = 0
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
    local rel0 = (FH.fun.guardianRadius - 1) / 9
    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new(rel0, 0, 1, 0)
    fill.BackgroundColor3 = C.accent; fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local drag = false
    local function upd(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        local v = 1 + rel * 9
        FH.fun.guardianRadius = v
        valL.Text = string.format("%.1f", v)
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; upd(i.Position.X)
        end
    end)
    FH.UI.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            upd(i.Position.X)
        end
    end)
    FH.UI.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
end

