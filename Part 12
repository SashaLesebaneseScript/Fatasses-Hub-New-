}
FH.emoteLoopActive = {}
FH.emoteTracks = {}

local function getEmoteTrack(animId)
    if FH.emoteTracks[animId] then return FH.emoteTracks[animId] end
    local mc = LP.Character; if not mc then return nil end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if not hum then return nil end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    local a = Instance.new("Animation")
    a.AnimationId = animId
    local tr = animator:LoadAnimation(a)
    tr.Looped = true
    tr.Priority = Enum.AnimationPriority.Action
    FH.emoteTracks[animId] = tr
    return tr
end

local function stopEmoteById(animId)
    local tr = FH.emoteTracks[animId]
    if tr then pcall(function() tr:Stop() end) end
    FH.emoteLoopActive[animId] = false
end

local function stopAllEmotes()
    for id in pairs(FH.emoteLoopActive) do
        local tr = FH.emoteTracks[id]
        if tr then pcall(function() tr:Stop() end) end
    end
    FH.emoteLoopActive = {}
end

local function toggleEmote(animId)
    if FH.emoteLoopActive[animId] then
        stopEmoteById(animId)
    else
        stopAllEmotes()
        local tr = getEmoteTrack(animId)
        if tr then
            FH.emoteLoopActive[animId] = true
            pcall(function() tr:Play(0.1) end)
        end
    end
end

-- ===== Ragdoll =====
local function setRagdoll(on)
    local mc = LP.Character; if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if not hum then return end
    hum.PlatformStand = on
end

-- ===== Dance (acción, no emote) =====
local danceTrack = nil
local function setDance(on)
    local mc = LP.Character; if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then animator = Instance.new("Animator"); animator.Parent = hum end
    if on then
        if danceTrack then return end
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://507771019"
        danceTrack = animator:LoadAnimation(a)
        danceTrack.Looped = true
        danceTrack.Priority = Enum.AnimationPriority.Action
        pcall(function() danceTrack:Play() end)
    else
        if danceTrack then pcall(function() danceTrack:Stop() end); danceTrack = nil end
    end
end

-- ===== Swim =====
local swimConn = nil
local function setSwim(on)
    local mc = LP.Character; if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if not hum then return end
    if on then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
            hum:ChangeState(Enum.HumanoidStateType.Swimming)
        end)
        if swimConn then return end
        swimConn = RS.Heartbeat:Connect(function()
            if not FH.fun.swim then return end
            local c = LP.Character; if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
            local st = h:GetState()
            if st ~= Enum.HumanoidStateType.Swimming and st ~= Enum.HumanoidStateType.Jumping then
                pcall(function() h:ChangeState(Enum.HumanoidStateType.Swimming) end)
            end
        end)
    else
        if swimConn then swimConn:Disconnect(); swimConn = nil end
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

-- ===== Fall =====
local function doFall()
    local mc = LP.Character; if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if not hum then return end
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.FallingDown) end)
end

-- ===== Enable Jump =====
local jumpLoopConn = nil
local spaceConn = nil

local function doJumpNow()
    local mc = LP.Character; if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    pcall(function() hum.Jump = true end)
end

local function startEnableJump()
    if jumpLoopConn then return end
    if not spaceConn then
        spaceConn = FH.UI.InputBegan:Connect(function(inp, proc)
            if proc then return end
            if not FH.fun.enableJump then return end
            if inp.KeyCode == Enum.KeyCode.Space then doJumpNow() end
        end)
    end
    jumpLoopConn = RS.Heartbeat:Connect(function()
        if not FH.fun.enableJump then return end
        local pg = LP:FindFirstChild("PlayerGui")
        if not pg then return end
        local tg = pg:FindFirstChild("TouchGui")
        if not tg then return end
        local jb = tg:FindFirstChild("JumpButton", true)
        if not jb then return end
        if not jb.Visible then jb.Visible = true end
        if not jb.Active then jb.Active = true end
        if not jb:GetAttribute("FH_HOOKED") then
            jb:SetAttribute("FH_HOOKED", true)
            jb.MouseButton1Click:Connect(function()
                if FH.fun.enableJump then doJumpNow() end
            end)
            jb.MouseButton1Down:Connect(function()
                if FH.fun.enableJump then doJumpNow() end
            end)
            jb.TouchTap:Connect(function()
                if FH.fun.enableJump then doJumpNow() end
            end)
        end
    end)
end

local function stopEnableJump()
    FH.fun.enableJump = false
    if jumpLoopConn then jumpLoopConn:Disconnect(); jumpLoopConn = nil end
    if spaceConn then spaceConn:Disconnect(); spaceConn = nil end
end

-- ===== Inf Jump =====
local infConn = nil
local function startInfJump()
    if infConn then return end
    infConn = FH.UI.JumpRequest:Connect(function()
        if FH.fun.infJump then doJumpNow() end
    end)
end
local function stopInfJump()
