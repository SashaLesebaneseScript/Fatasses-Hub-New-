}

-- ===== Ragdoll =====
local function setRagdoll(on)
    local mc = LP.Character
    if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.PlatformStand = on
end

-- ===== Dance =====
local danceTrack = nil
local function setDance(on)
    local mc = LP.Character
    if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    if on then
        if danceTrack then return end
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://507771019"
        danceTrack = animator:LoadAnimation(anim)
        danceTrack.Looped = true
        danceTrack.Priority = Enum.AnimationPriority.Action
        pcall(function() danceTrack:Play() end)
    else
        if danceTrack then
            pcall(function() danceTrack:Stop() end)
            danceTrack = nil
        end
    end
end

-- ===== Swim (nadar en el aire) =====
local swimConn = nil
local function setSwim(on)
    local mc = LP.Character
    if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if on then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
            hum:ChangeState(Enum.HumanoidStateType.Swimming)
        end)
        if swimConn then return end
        swimConn = RS.Heartbeat:Connect(function()
            if not FH.fun.swim then return end
            local c = LP.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            if not h then return end
            local state = h:GetState()
            if state ~= Enum.HumanoidStateType.Swimming and state ~= Enum.HumanoidStateType.Jumping then
                pcall(function() h:ChangeState(Enum.HumanoidStateType.Swimming) end)
            end
        end)
    else
        if swimConn then swimConn:Disconnect(); swimConn = nil end
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

-- ===== Fall (caer con cuerpo hacia abajo) =====
local function setFall()
    local mc = LP.Character
    if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.FallingDown) end)
end

-- ===== Enable Jump =====
local jumpRebindConn = nil
local function setEnableJump(on)
    if on then
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then
            local tg = pg:FindFirstChild("TouchGui")
            if tg then
                local jb = tg:FindFirstChild("JumpButton", true)
                if jb then
                    jb.Visible = true
                    jb.Active = true
                end
            end
        end
        if not jumpRebindConn then
            jumpRebindConn = FH.UI.InputBegan:Connect(function(inp, proc)
                if proc or not FH.fun.enableJump then return end
                if inp.KeyCode == Enum.KeyCode.Space then
                    local mc = LP.Character
                    if not mc then return end
                    local hum = mc:FindFirstChildOfClass("Humanoid")
                    if hum then
                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                    end
                end
            end)
        end
    else
        if jumpRebindConn then jumpRebindConn:Disconnect(); jumpRebindConn = nil end
    end
end

-- ===== Inf Jump =====
local infJumpConn = nil
local function setInfJump(on)
    if on and not infJumpConn then
        infJumpConn = FH.UI.JumpRequest:Connect(function()
            local mc = LP.Character
            if not mc then return end
            local hum = mc:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
            end
        end)
    elseif not on and infJumpConn then
        infJumpConn:Disconnect()
        infJumpConn = nil
    end
end

