-- ===== Ragdoll =====
local function setRagdoll(on)
    local mc = LP.Character; if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if not hum then return end
    hum.PlatformStand = on
end

-- ===== Dance =====
local danceTrack = nil
local function setDance(on)
    local mc = LP.Character; if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then animator = Instance.new("Animator"); animator.Parent = hum end
    if on then
        if danceTrack then return end
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://507771019"
        danceTrack = animator:LoadAnimation(anim)
        danceTrack.Looped = true
        danceTrack.Priority = Enum.AnimationPriority.Action
        pcall(function() danceTrack:Play() end)
    else
        if danceTrack then pcall(function() danceTrack:Stop() end); danceTrack = nil end
    end
end

-- ===== Swim =====
local swimConn = nil
local function setSwim(on)
    local mc = LP.Character; if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if not hum then return end
    if on then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
            hum:ChangeState(Enum.HumanoidStateType.Swimming)
        end)
        if swimConn then return end
        swimConn = RS.Heartbeat:Connect(function()
            if not FH.fun.swim then return end
            local c = LP.Character; if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
            local state = h:GetState()
            if state ~= Enum.HumanoidStateType.Swimming and state ~= Enum.HumanoidStateType.Jumping then
                pcall(function() h:ChangeState(Enum.HumanoidStateType.Swimming) end)
            end
        end)
    else
        if swimConn then swimConn:Disconnect(); swimConn = nil end
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

-- ===== Fall =====
local function setFall()
    local mc = LP.Character; if not mc then return end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if not hum then return end
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.FallingDown) end)
end

-- ===== Enable Jump =====
local jumpRebindConn = nil
local function setEnableJump(on)
    if on then
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then
            local tg = pg:FindFirstChild("TouchGui")
            if tg then
                local jb = tg:FindFirstChild("JumpButton", true)
                if jb then jb.Visible = true; jb.Active = true end
            end
        end
        if not jumpRebindConn then
            jumpRebindConn = FH.UI.InputBegan:Connect(function(inp, proc)
                if proc or not FH.fun.enableJump then return end
                if inp.KeyCode == Enum.KeyCode.Space then
                    local mc = LP.Character; if not mc then return end
                    local hum = mc:FindFirstChildOfClass("Humanoid")
                    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end) end
                end
            end)
        end
    else
        if jumpRebindConn then jumpRebindConn:Disconnect(); jumpRebindConn = nil end
    end
end

-- ===== Inf Jump =====
local infJumpConn = nil
local function setInfJump(on)
    if on and not infJumpConn then
        infJumpConn = FH.UI.JumpRequest:Connect(function()
            local mc = LP.Character; if not mc then return end
            local hum = mc:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end) end
        end)
    elseif not on and infJumpConn then
        infJumpConn:Disconnect(); infJumpConn = nil
    end
end

-- ===== Guardian v3 =====
-- Se posiciona ENTRE el superviviente y el asesino, al pecho del survivor, mirando al killer.
-- No atraviesa paredes (raycast). Si queda atascado lejos, teleport de emergencia.
local guardianConn = nil
local savedSpeed, savedJump = 16, 50

local function getSurvivorTarget()
    local killer = FH.updateKiller()
    if killer then
        local khrp = killer:FindFirstChild("HumanoidRootPart")
        if not khrp then return nil end
        local best, bestD = nil, math.huge
        for _, p in ipairs(PL:GetPlayers()) do
            if p.Character and p.Character ~= killer and p ~= LP then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if h and h.Health > 0 and hrp then
                    local d = (khrp.Position - hrp.Position).Magnitude
                    if d < bestD then bestD = d; best = p.Character end
                end
            end
        end
        return best
    end
    local myhrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myhrp then return nil end
    local best, bestD = nil, math.huge
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and hrp then
                local d = (myhrp.Position - hrp.Position).Magnitude
                if d < bestD then bestD = d; best = p.Character end
            end
        end
    end
    return best
end

local function updateGuardian()
    if not FH.fun.guardian then return end
    local survivor = getSurvivorTarget()
    if not survivor then return end
    local shrp = survivor:FindFirstChild("HumanoidRootPart")
    if not shrp then return end
    local mc = LP.Character
    if not mc then return end
    local myhrp = mc:FindFirstChild("HumanoidRootPart")
    if not myhrp then return end
    local myhum = mc:FindFirstChildOfClass("Humanoid")

    if myhum then
        myhum.WalkSpeed = 0
        myhum.JumpPower = 0
    end

    local killer = FH.updateKiller()
    local khrp = killer and killer:FindFirstChild("HumanoidRootPart")

    local targetPos, lookAt
    if khrp then
        local flatDir = Vector3.new(khrp.Position.X - shrp.Position.X, 0, khrp.Position.Z - shrp.Position.Z)
        if flatDir.Magnitude > 0.1 then
            flatDir = flatDir.Unit
        else
            flatDir = Vector3.new(0, 0, -1)
        end
        targetPos = Vector3.new(
            shrp.Position.X + flatDir.X * FH.fun.guardianRadius,
            shrp.Position.Y + 1,
            shrp.Position.Z + flatDir.Z * FH.fun.guardianRadius
        )
        lookAt = khrp.Position
    else
        targetPos = shrp.Position + Vector3.new(2.5, 1, 0)
        lookAt = shrp.Position
    end

    local finalLook = Vector3.new(lookAt.X, targetPos.Y, lookAt.Z)

    -- ===== Deteccion de atascado: teleport de emergencia =====
    local distToSurvivor = (myhrp.Position - shrp.Position).Magnitude
    local maxAllowed = FH.fun.guardianRadius + 4

    if distToSurvivor > maxAllowed then
        pcall(function()
            myhrp.CFrame = CFrame.lookAt(targetPos, finalLook)
        end)
        return
    end

    -- Anti-wall normal
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {mc, survivor}
    if killer then table.insert(params.FilterDescendantsInstances, killer) end

    local origin = myhrp.Position
    local delta = targetPos - origin
    local dist = delta.Magnitude

    local finalPos = targetPos
    if dist > 0.1 then
        local ray = WS:Raycast(origin, delta, params)
        if ray then
            local hitDist = (ray.Position - origin).Magnitude
            if hitDist < 1.5 then
                local rotY = math.atan2(-(lookAt.X - origin.X), -(lookAt.Z - origin.Z))
                myhrp.CFrame = CFrame.new(origin) * CFrame.Angles(0, rotY, 0)
                return
            end
            finalPos = origin + delta.Unit * (hitDist - 1)
        end
    end

    pcall(function()
        myhrp.CFrame = CFrame.lookAt(finalPos, finalLook)
    end)
end

local function startGuardian()
    if guardianConn then return end
    local mc = LP.Character
    if mc then
        local hum = mc:FindFirstChildOfClass("Humanoid")
        if hum then savedSpeed = hum.WalkSpeed; savedJump = hum.JumpPower end
    end
    guardianConn = RS.RenderStepped:Connect(function()
        pcall(updateGuardian)
    end)
end

local function stopGuardian()
    FH.fun.guardian = false
    if guardianConn then guardianConn:Disconnect(); guardianConn = nil end
    local mc = LP.Character
    if mc then
        local hum = mc:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = savedSpeed; hum.JumpPower = savedJump end
    end
end

