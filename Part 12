-- ===== Panel hook =====
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Fun" then return end
    local opt = FH.crearOpcion

    opt("Ragdoll 🕺", function(v)
        FH.fun.ragdoll = v
        setRagdoll(v)
    end)
    opt("Dance 💃", function(v)
        FH.fun.dance = v
        setDance(v)
    end)
    opt("Swim 🏊", function(v)
        FH.fun.swim = v
        setSwim(v)
    end)
    opt("Fall 🤕", function(v)
        FH.fun.fall = v
        if v then setFall(); FH.est["Fall 🤕"] = false end
    end)
    opt("Enable Jump 🦘", function(v)
        FH.fun.enableJump = v
        setEnableJump(v)
    end)
    opt("Inf Jump ♾️", function(v)
        FH.fun.infJump = v
        setInfJump(v)
    end)
end

