local guardianStuckT = 0

local function updateGuardian()
    if not FH.fun.guardian then return end
    if estoyStuneado() then return end
    local survivor = getSurvivorTarget(); if not survivor then return end
    local shrp = survivor:FindFirstChild("HumanoidRootPart"); if not shrp then return end
    local mc = LP.Character; if not mc then return end
    local myhrp = mc:FindFirstChild("HumanoidRootPart"); if not myhrp then return end
    local myhum = mc:FindFirstChildOfClass("Humanoid")
    if myhum then myhum.WalkSpeed = 0; myhum.JumpPower = 0 end

    local killer = FH.updateKiller()
    local khrp = killer and killer:FindFirstChild("HumanoidRootPart")
    local lookAt = khrp and khrp.Position or shrp.Position

    -- Buscar posicion entre survivor y killer
    local flat
    if khrp then
        flat = Vector3.new(khrp.Position.X - shrp.Position.X, 0, khrp.Position.Z - shrp.Position.Z)
        if flat.Magnitude > 0.1 then flat = flat.Unit else flat = Vector3.new(0,0,-1) end
    else
        flat = Vector3.new(1, 0, 0)
    end

    local targetPos = Vector3.new(
        shrp.Position.X + flat.X * FH.fun.guardianRadius,
        shrp.Position.Y + 1,
        shrp.Position.Z + flat.Z * FH.fun.guardianRadius
    )
    local finalLook = Vector3.new(lookAt.X, targetPos.Y, lookAt.Z)
    local dist = (myhrp.Position - targetPos).Magnitude

    -- Ya estamos en posicion: girar
    if dist < 1 then
        guardianStuckT = 0
        pcall(function() myhrp.CFrame = CFrame.lookAt(myhrp.Position, finalLook) end)
        return
    end

    -- Chequear pared
    local ignorar = {mc, survivor}
    if killer then table.insert(ignorar, killer) end
    local hayP1 = hayPared(myhrp.Position, targetPos, ignorar)
    local hayP2 = hayPared(Vector3.new(myhrp.Position.X, myhrp.Position.Y+2, myhrp.Position.Z),
                            Vector3.new(targetPos.X, targetPos.Y+2, targetPos.Z), ignorar)

    if hayP1 or hayP2 then
        -- Stuck detection: si llevamos 1.5s trabados, forzar TP
        if tick() - guardianStuckT > 1.5 then
            pcall(function() myhrp.CFrame = CFrame.lookAt(targetPos, finalLook) end)
            guardianStuckT = tick()
            return
        end
        if guardianStuckT == 0 then guardianStuckT = tick() end
        local fl = Vector3.new(lookAt.X, myhrp.Position.Y, lookAt.Z)
        pcall(function() myhrp.CFrame = CFrame.lookAt(myhrp.Position, fl) end)
        return
    end

    guardianStuckT = 0
    local newPos = myhrp.Position:Lerp(targetPos, 0.15)
    pcall(function() myhrp.CFrame = CFrame.lookAt(newPos, finalLook) end)
end
