-- ============ FATASSES HUB LOADER (9 partes) ============
local URLS = {
    "https://raw.githubusercontent.com/SashaLesebaneseScript/Fatasses-Hub-New-/refs/heads/main/Part1",
    "https://raw.githubusercontent.com/SashaLesebaneseScript/Fatasses-Hub-New-/refs/heads/main/Part%202",
    "https://raw.githubusercontent.com/SashaLesebaneseScript/Fatasses-Hub-New-/refs/heads/main/Part%203",
    "https://raw.githubusercontent.com/SashaLesebaneseScript/Fatasses-Hub-New-/refs/heads/main/Part%204",
    "https://raw.githubusercontent.com/SashaLesebaneseScript/Fatasses-Hub-New-/refs/heads/main/Part%205",
    "https://raw.githubusercontent.com/SashaLesebaneseScript/Fatasses-Hub-New-/refs/heads/main/Part%207",
    "https://raw.githubusercontent.com/SashaLesebaneseScript/Fatasses-Hub-New-/refs/heads/main/Part%208",
    "https://raw.githubusercontent.com/SashaLesebaneseScript/Fatasses-Hub-New-/refs/heads/main/Part%209",
    "https://raw.githubusercontent.com/SashaLesebaneseScript/Fatasses-Hub-New-/refs/heads/main/Part%2010",
}

local DELAY = 2
local TOTAL = #URLS

print("🎃 LOADER: Iniciando carga de " .. TOTAL .. " partes...")

for i = 1, TOTAL do
    print("🎃 LOADER: Cargando parte " .. i .. "/" .. TOTAL .. "...")
    local ok, code = pcall(function() return game:HttpGet(URLS[i], true) end)
    if not ok or not code or code == "" then
        warn("🎃 LOADER: ERROR al descargar parte " .. i .. "/" .. TOTAL)
        return
    end
    local fn, err = loadstring(code)
    if not fn then
        warn("🎃 LOADER: ERROR de sintaxis en parte " .. i .. ": " .. tostring(err))
        return
    end
    local ok2, err2 = pcall(fn)
    if not ok2 then
        warn("🎃 LOADER: ERROR al ejecutar parte " .. i .. ": " .. tostring(err2))
        return
    end
    print("🎃 LOADER: ✅ Parte " .. i .. "/" .. TOTAL .. " OK")
    if i < TOTAL then task.wait(DELAY) end
end

-- Forzar rebuild del panel al terminar (para que aparezcan los botones de Parts 7-10)
task.wait(0.5)
if getgenv().FH and getgenv().FH.panel then
    pcall(getgenv().FH.panel)
end

