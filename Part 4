-- ============ PARTE 4/5 - ESP & Lighting Fixes ============
local FH=getgenv().FH
if not FH or not FH.p3 then warn("[FH] Ejecuta Partes 1-3 primero") return end
if FH.p4 then warn("[FH] Parte 4 ya ejecutada") return end
local RS,PL,LP=FH.RS,FH.PL,FH.LP
local WS = FH.WS
local Lighting = game:GetService("Lighting")

-- ===== ESP PLAYERS (Colores + Distancia) =====
local pESP={}
local function mkP(m,color)
    if not m then return end
    if pESP[m] then
        local d=pESP[m]
        d.h.FillColor = color; d.h.OutlineColor = color
        d.n.TextColor3 = color; d.s.TextColor3 = color
        return
    end
    local h=Instance.new("Highlight"); h.FillTransparency=.6; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Adornee=m; h.Parent=m
    h.FillColor = color; h.OutlineColor = color
    
    local bg=Instance.new("BillboardGui"); bg.Size=UDim2.new(0,160,0,60); bg.StudsOffset=Vector3.new(0,3.5,0); bg.AlwaysOnTop=true; bg.Parent=m
    local n=Instance.new("TextLabel",bg); n.Size=UDim2.new(1,0,.5,0); n.BackgroundTransparency=1; n.TextColor3=color; n.TextStrokeTransparency=0; n.TextStrokeColor3=Color3.fromRGB(20,5,20); n.TextScaled=true; n.Font=Enum.Font.GothamBold; n.Text=m.Name
    local s=Instance.new("TextLabel",bg); s.Size=UDim2.new(1,0,.5,0); s.Position=UDim2.new(0,0,.5,0); s.BackgroundTransparency=1; s.TextColor3=color; s.TextStrokeTransparency=0; s.TextStrokeColor3=Color3.fromRGB(20,5,20); s.TextScaled=true; s.Font=Enum.Font.GothamBold; s.Text="100 / 100"
    pESP[m]={h=h,bg=bg,l=s,n=n,hp=-1,mx=-1}
end
local function delP(m) local d=pESP[m]; if not d then return end; d.h:Destroy(); d.bg:Destroy(); pESP[m]=nil end

local function scanP()
    local found={}; 
    local expPlayer = FH.getExperiment()
    local myHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    
    for _,p in ipairs(PL:GetPlayers())do 
        if p~=LP and p.Character then 
            local ch=p.Character; local hum=ch:FindFirstChildOfClass("Humanoid"); local hrp = ch:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health>0 and hrp then 
                local color = Color3.fromRGB(150, 150, 150)
                local dist = myHRP and (myHRP.Position - hrp.Position).Magnitude or 0
                
                if dist > 600 then 
                    color = Color3.fromRGB(150, 150, 150) -- Gris (Lobby)
                else
                    if FH.isKiller(ch) then 
                        color = Color3.fromRGB(255, 75, 125) -- Rojo Rosáceo
                    elseif expPlayer then 
                        color = Color3.fromRGB(152, 255, 152) -- Verde Menta
                    end
                end
                
                mkP(ch, color)
                found[ch]=true 
            end 
        end 
    end
    for m in pairs(pESP)do if not found[m]or not m.Parent then delP(m)end end
end

local pT
FH.startEP=function()
    if pT then return end
    scanP()
    PL.PlayerAdded:Connect(function() if FH.on.espPlActive then task.wait(.3); scanP() end end)
    PL.PlayerRemoving:Connect(function() task.wait(.3); scanP() end)
    pT=task.spawn(function()
        while FH.on.espPlActive do
            task.wait(1)
            if FH.on.espPlActive then
                scanP()
                for m,d in pairs(pESP)do 
                    if m and m.Parent and d.l then 
                        local h=m:FindFirstChildOfClass("Humanoid"); 
                        if h then local hp=math.floor(h.Health); local mx=math.floor(h.MaxHealth); if hp~=d.hp or mx~=d.mx then d.hp=hp; d.mx=mx; d.l.Text=hp.." / "..mx end end 
                    end 
                end
            end
        end
        pT=nil
    end)
end
FH.stopEP=function() pT=nil; for m in pairs(pESP)do delP(m)end end

-- ===== ESP TASKS (Por Mapa) =====
FH.espTasksCache = {}
FH.startESP = function(v)
    if not v then
        if FH.espTasksCache then
            for _, data in pairs(FH.espTasksCache) do if data.hl then data.hl:Destroy() end; if data.bg then data.bg:Destroy() end end
            FH.espTasksCache = {}
        end
        return
    end
    task.spawn(function()
        while FH.on.espActive do
            local map1 = WS:FindFirstChild("Map1")
            local map2 = WS:FindFirstChild("Map2")
            local map3 = WS:FindFirstChild("Map3")
            
            local targetFolder = nil
            local targetName = nil
            
            if map1 then targetFolder = map1; targetName = "Patient"
            elseif map2 then targetFolder = map2; targetName = "Tube"
            elseif map3 then targetFolder = map3; targetName = "Panel" end
            
            if targetFolder and targetName then
                for _, obj in ipairs(targetFolder:GetDescendants()) do
                    if obj.Name == targetName then
                        if not FH.espTasksCache[obj] then
                            local hl = Instance.new("Highlight")
                            hl.Parent = obj; hl.Adornee = obj
                            hl.FillColor = Color3.fromRGB(255, 120, 20); hl.OutlineColor = Color3.fromRGB(255, 180, 80); hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            local bg = Instance.new("BillboardGui")
                            bg.Parent = obj; bg.Adornee = obj
                            bg.Size = UDim2.new(0, 80, 0, 20); bg.StudsOffset = Vector3.new(0, 2, 0); bg.AlwaysOnTop = true
                            local txt = Instance.new("TextLabel", bg)
                            txt.Size = UDim2.new(1, 0, 1, 0); txt.BackgroundTransparency = 1; txt.Text = "📋 "..targetName; txt.TextColor3 = Color3.fromRGB(255, 120, 20); txt.TextStrokeTransparency = 0; txt.Font = Enum.Font.GothamBold; txt.TextScaled = true
                            FH.espTasksCache[obj] = {hl = hl, bg = bg}
                        end
                    end
                end
            end
            
            for obj, data in pairs(FH.espTasksCache) do
                if not obj.Parent then
                    if data.hl then data.hl:Destroy() end
                    if data.bg then data.bg:Destroy() end
                    FH.espTasksCache[obj] = nil
                end
            end
            task.wait(1)
        end
    end)
end
FH.stopESP = function()
    if FH.espTasksCache then
        for _, data in pairs(FH.espTasksCache) do if data.hl then data.hl:Destroy() end; if data.bg then data.bg:Destroy() end end
        FH.espTasksCache = {}
    end
end

-- ===== ESP CANDIES =====
FH.candyESP = {}
FH.startCandyESP = function(v)
    if not v then
        for _, data in pairs(FH.candyESP) do if data.hl then data.hl:Destroy() end; if data.bg then data.bg:Destroy() end end
        FH.candyESP = {}
        return
    end
    task.spawn(function()
        while FH.candyESP_Active do
            for _, c in ipairs(WS:GetDescendants()) do
                if c:IsA("Model") and c.Name:match("^Candy") and not FH.candyESP[c] then
                    local hl = Instance.new("Highlight")
                    hl.Parent = c; hl.Adornee = c
                    hl.FillColor = Color3.fromRGB(255, 50, 150); hl.OutlineColor = Color3.new(1,1,1); hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    local bg = Instance.new("BillboardGui")
                    bg.Parent = c; bg.Adornee = c
                    bg.Size = UDim2.new(0, 60, 0, 20); bg.StudsOffset = Vector3.new(0, 2, 0); bg.AlwaysOnTop = true
                    local txt = Instance.new("TextLabel", bg)
                    txt.Size = UDim2.new(1, 0, 1, 0); txt.BackgroundTransparency = 1; txt.Text = "🍬 Candy"; txt.TextColor3 = Color3.fromRGB(255, 50, 150); txt.TextStrokeTransparency = 0; txt.Font = Enum.Font.GothamBold; txt.TextScaled = true
                    FH.candyESP[c] = {hl = hl, bg = bg}
                end
            end
            task.wait(1)
        end
    end)
end

-- ===== FULLBRIGHT =====
local defaultFogEnd = Lighting.FogEnd
FH.setFullbright = function(v, alt)
    if v then
        Lighting.Brightness = 3; Lighting.ClockTime = 12; Lighting.FogEnd = 100000
        if alt then Lighting.Ambient = Color3.fromRGB(150, 150, 150); Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
        else Lighting.Ambient = Color3.fromRGB(255, 255, 255); Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255) end
    else
        Lighting.Brightness = 1; Lighting.ClockTime = 14; Lighting.Ambient = Color3.fromRGB(70, 70, 70); Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128); Lighting.FogEnd = defaultFogEnd
    end
end
FH.setNoFog = function(v) if v then Lighting.FogEnd = 100000 else Lighting.FogEnd = defaultFogEnd end end

FH.p4=true
print("🎃 [4/5] ESP & Lighting OK") 
