-- ============ PARTE 4/5 - ESP Fixes ============
local FH=getgenv().FH
if not FH or not FH.p3 then warn("[FH] Ejecuta Partes 1-3 primero") return end
if FH.p4 then warn("[FH] Parte 4 ya ejecutada") return end
local RS,PL,LP=FH.RS,FH.PL,FH.LP
local WS = FH.WS

-- ESP Tasks (Panels) OPTIMIZADO
local espTasksCache = {}
FH.startESP = function(v)
    if not v then
        for _, hl in pairs(espTasksCache) do hl:Destroy() end
        espTasksCache = {}
        return
    end
    task.spawn(function()
        while FH.on.espActive do
            for _, obj in ipairs(WS:GetChildren()) do
                if (obj.Name:match("^Task_%d+$") or obj.Name == "TaskSpawn") and not espTasksCache[obj] then
                    local hl = Instance.new("Highlight", obj)
                    hl.FillColor = Color3.fromRGB(255, 120, 20)
                    hl.OutlineColor = Color3.fromRGB(255, 180, 80)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    
                    local bg = Instance.new("BillboardGui", obj)
                    bg.Size = UDim2.new(0, 100, 0, 30)
                    bg.StudsOffset = Vector3.new(0, 3, 0)
                    bg.AlwaysOnTop = true
                    local txt = Instance.new("TextLabel", bg)
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Text = "📋 Panel"
                    txt.TextColor3 = Color3.fromRGB(255, 120, 20)
                    txt.TextStrokeTransparency = 0
                    txt.Font = Enum.Font.GothamBold
                    txt.TextScaled = true
                    
                    espTasksCache[obj] = hl
                end
            end
            task.wait(1) -- Optimizacion: escanea cada 1 seg en vez de cada frame
        end
    end)
end

-- ESP Candies (Con Texto)
local candyESP = {}
local function getCandies() local c = {} for _, v in ipairs(WS:GetChildren()) do if v.Name:match("^CandyModel") then table.insert(c, v) end end return c end
FH.startCandyESP = function(v)
    if not v then
        for _, data in pairs(candyESP) do data.hl:Destroy(); data.bg:Destroy() end
        candyESP = {}
        return
    end
    for _, c in ipairs(getCandies()) do
        if not candyESP[c] then
            local hl = Instance.new("Highlight", c)
            hl.FillColor = Color3.fromRGB(255, 50, 150)
            hl.OutlineColor = Color3.new(1,1,1)
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            
            local bg = Instance.new("BillboardGui", c)
            bg.Size = UDim2.new(0, 100, 0, 30)
            bg.StudsOffset = Vector3.new(0, 3, 0)
            bg.AlwaysOnTop = true
            local txt = Instance.new("TextLabel", bg)
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.Text = "🍬 Candy"
            txt.TextColor3 = Color3.fromRGB(255, 50, 150)
            txt.TextStrokeTransparency = 0
            txt.Font = Enum.Font.GothamBold
            txt.TextScaled = true
            
            candyESP[c] = {hl = hl, bg = bg}
        end
    end
end

-- Get all Candys (TP al centro exacto)
FH.autoCandyActive = false
task.spawn(function()
    while true do
        if FH.autoCandyActive then
            local candies = getCandies()
            if candies[1] then
                local mc = LP.Character; local hrp = mc and mc:FindFirstChild("HumanoidRootPart")
                local primary = candies[1]:FindFirstChild("PrimaryPart") or candies[1]:FindFirstChildWhichIsA("BasePart")
                if hrp and primary then hrp.CFrame = primary.CFrame end -- TP al centro
            end
            task.wait(0.2)
        else task.wait(1) end
    end
end)

-- FULLBRIGHT
local oldLighting = {Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, FogEnd = Lighting.FogEnd}
FH.setFullbright = function(v, alt)
    if v then
        Lighting.Brightness = 3
        Lighting.ClockTime = 12
        if alt then
            Lighting.Ambient = Color3.fromRGB(150, 150, 150)
            Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
        else
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
            Lighting.FogEnd = 100000
        end
    else
        Lighting.Brightness = oldLighting.Brightness
        Lighting.ClockTime = oldLighting.ClockTime
        Lighting.Ambient = oldLighting.Ambient
        Lighting.OutdoorAmbient = oldLighting.OutdoorAmbient
        Lighting.FogEnd = oldLighting.FogEnd
    end
end
FH.p4=true
print("🎃 [4/5] ESP & Fullbright OK")
