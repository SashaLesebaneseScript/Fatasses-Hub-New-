-- ESP Players
local pESP={}
local function mkP(m,rojo)
    if not m then return end
    if pESP[m] then
        local h=pESP[m].h
        if rojo then
            h.FillColor=Color3.fromRGB(180,30,60)
            h.OutlineColor=Color3.fromRGB(255,70,120)
        else
            h.FillColor=Color3.fromRGB(255,120,20)
            h.OutlineColor=Color3.fromRGB(255,180,80)
        end
        return
    end
    local h=Instance.new("Highlight")
    h.FillTransparency=.6
    h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee=m
    h.Parent=m
    if rojo then
        h.FillColor=Color3.fromRGB(180,30,60)
        h.OutlineColor=Color3.fromRGB(255,70,120)
    else
        h.FillColor=Color3.fromRGB(255,120,20)
        h.OutlineColor=Color3.fromRGB(255,180,80)
    end
    local bg=Instance.new("BillboardGui")
    bg.Size=UDim2.new(0,160,0,60)
    bg.StudsOffset=Vector3.new(0,3.5,0)
    bg.AlwaysOnTop=true
    bg.Parent=m
    local n=Instance.new("TextLabel",bg)
    n.Size=UDim2.new(1,0,.5,0)
    n.BackgroundTransparency=1
    n.TextColor3=Color3.fromRGB(255,220,180)
    n.TextStrokeTransparency=0
    n.TextStrokeColor3=Color3.fromRGB(20,5,20)
    n.TextScaled=true
    n.Font=Enum.Font.GothamBold
    n.Text="🎃 "..m.Name
    local s=Instance.new("TextLabel",bg)
    s.Size=UDim2.new(1,0,.5,0)
    s.Position=UDim2.new(0,0,.5,0)
    s.BackgroundTransparency=1
    s.TextColor3=Color3.fromRGB(255,150,50)
    s.TextStrokeTransparency=0
    s.TextStrokeColor3=Color3.fromRGB(20,5,20)
    s.TextScaled=true
    s.Font=Enum.Font.GothamBold
    s.Text="100 / 100"
    pESP[m]={h=h,bg=bg,l=s,hp=-1,mx=-1}
end
local function delP(m)
    local d=pESP[m]
    if not d then return end
    d.h:Destroy()
    d.bg:Destroy()
    pESP[m]=nil
end
local function scanP()
    local found={}
    local masAlto,altMax=nil,-math.huge
    for _,p in ipairs(PL:GetPlayers()) do
        if p~=LP and p.Character then
            local ch=p.Character
            local hum=ch:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health>0 then
                local ok,sz=pcall(function() return ch:GetExtentsSize().Y end)
                if ok and sz and sz>altMax then
                    altMax=sz
                    masAlto=ch
                end
            end
        end
    end
    for _,p in ipairs(PL:GetPlayers()) do
        if p~=LP and p.Character then
            local ch=p.Character
            local hum=ch:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health>0 then
                mkP(ch,(ch==masAlto) or FH.isKiller(ch))
                found[ch]=true
            end
        end
    end
    for m in pairs(pESP) do
        if not found[m] or not m.Parent then
            delP(m)
        end
    end
end
local pT
FH.startEP=function()
    if pT then return end
    scanP()
    PL.PlayerAdded:Connect(function()
        if FH.on.espPlActive then
            task.wait(.3)
            scanP()
        end
    end)
    PL.PlayerRemoving:Connect(function()
        task.wait(.3)
        scanP()
    end)
    pT=task.spawn(function()
        while FH.on.espPlActive do
            task.wait(1)
            if FH.on.espPlActive then
                scanP()
                for m,d in pairs(pESP) do
                    if m and m.Parent and d.l then
                        local h=m:FindFirstChildOfClass("Humanoid")
                        if h then
                            local hp=math.floor(h.Health)
                            local mx=math.floor(h.MaxHealth)
                            if hp~=d.hp or mx~=d.mx then
                                d.hp=hp
                                d.mx=mx
                                d.l.Text=hp.." / "..mx
                                local r=hp/math.max(1,mx)
                                if r>.6 then
                                    d.l.TextColor3=Color3.fromRGB(255,150,50)
                                elseif r>.3 then
                                    d.l.TextColor3=Color3.fromRGB(255,220,80)
                                else
                                    d.l.TextColor3=Color3.fromRGB(255,50,50)
                                end
                            end
                        end
                    end
                end
            end
        end
        pT=nil
    end)
end
FH.stopEP=function()
    pT=nil
    for m in pairs(pESP) do
        delP(m)
    end
end

-- Tracers
local tGui=Instance.new("ScreenGui")
tGui.Name="FatassesTracers"
tGui.ResetOnSpawn=false
tGui.IgnoreGuiInset=true
tGui.DisplayOrder=998
tGui.Parent=FH.parent
local tCache={}
local function renderT()
    if not FH.on.tracersActive then
        for _,l in pairs(tCache) do
            if l.Parent then l.Visible=false end
        end
        return
    end
    local mc=LP.Character
    if not mc then return end
    local hr=mc:FindFirstChild("HumanoidRootPart")
    if not hr then return end
    local myFoot=hr.Position-Vector3.new(0,2.5,0)
    local cm=workspace.CurrentCamera
    if not cm then return end
    local msp,mon=cm:WorldToViewportPoint(myFoot)
    if not mon then
        for _,l in pairs(tCache) do
            if l.Parent then l.Visible=false end
        end
        return
    end
    local masAlto,altMax=nil,-math.huge
    for _,p in ipairs(PL:GetPlayers()) do
        if p~=LP and p.Character then
            local h=p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health>0 then
                local ok,sz=pcall(function() return p.Character:GetExtentsSize().Y end)
                if ok and sz and sz>altMax then
                    altMax=sz
                    masAlto=p.Character
                end
            end
        end
    end
    local alive={}
    for _,p in ipairs(PL:GetPlayers()) do
        if p~=LP and p.Character then
            local ch=p.Character
            local h=ch:FindFirstChildOfClass("Humanoid")
            if h and h.Health>0 then
                alive[ch]=true
                local hh=ch:FindFirstChild("HumanoidRootPart")
                if hh then
                    local fp=hh.Position-Vector3.new(0,2.5,0)
                    local sp,ons=cm:WorldToViewportPoint(fp)
                    if ons then
                        local l=tCache[ch]
                        if not l or not l.Parent then
                            l=Instance.new("Frame")
                            l.BorderSizePixel=0
                            l.ZIndex=998
                            l.AnchorPoint=Vector2.new(.5,.5)
                            l.Parent=tGui
                            tCache[ch]=l
                        end
                        local dx=sp.X-msp.X
                        local dy=sp.Y-msp.Y
                        local len=math.sqrt(dx*dx+dy*dy)
                        l.Size=UDim2.new(0,len,0,2)
                        l.Position=UDim2.new(0,(msp.X+sp.X)/2,0,(msp.Y+sp.Y)/2)
                        l.Rotation=math.deg(math.atan2(dy,dx))
                        l.Visible=true
                        if (ch==masAlto) or FH.isKiller(ch) then
                            l.BackgroundColor3=Color3.fromRGB(255,30,60)
                        else
                            l.BackgroundColor3=Color3.fromRGB(255,120,20)
                        end
                    else
                        local l=tCache[ch]
                        if l and l.Parent then l.Visible=false end
                    end
                end
            end
        end
    end
    for ch,l in pairs(tCache) do
        if not alive[ch] or not ch.Parent then
            l:Destroy()
            tCache[ch]=nil
        end
    end
end
local trC
FH.startT=function()
    if trC then return end
    trC=RS.RenderStepped:Connect(function()
        if FH.on.tracersActive then pcall(renderT) end
    end)
end
FH.stopT=function()
    if trC then trC:Disconnect();trC=nil end
    for _,l in pairs(tCache) do l:Destroy() end
    tCache={}
end

-- Healing
FH.healT=function(t)
    local e=FH.getHealEv()
    if not e or not t then return false end
    pcall(function() e:FireServer("StartVisuals",t) end)
    task.spawn(function()
        for i=1,6 do
            pcall(function() e:FireServer("HealTick",t) end)
            task.wait(.1)
        end
        pcall(function() e:FireServer("GiveSpeedBoost") end)
        pcall(function() e:FireServer("StartCooldown") end)
    end)
    return true
end
FH.healN=function() return FH.healT(FH.injPlayer(100)) end
FH.healS=function()
    local e=FH.getHealEv()
    if not e then return false end
    pcall(function() e:FireServer("StartVisuals",LP) end)
    task.spawn(function()
        for i=1,6 do
            pcall(function() e:FireServer("HealTick",LP) end)
            task.wait(.1)
        end
        pcall(function() e:FireServer("GiveSpeedBoost") end)
    end)
    return true
end
FH.resetCd=function()
    local e=FH.getHealEv()
    if not e then return end
    task.spawn(function()
        for i=1,15 do
            pcall(function() e:FireServer("RequestCooldownCheck") end)
            task.wait(.05)
        end
    end)
end
FH.boost=function()
    local e=FH.getHealEv()
    if not e then return end
    for i=1,5 do pcall(function() e:FireServer("GiveSpeedBoost") end) end
end
FH.healAll=function()
    local e=FH.getHealEv()
    if not e then return end
    for _,p in ipairs(PL:GetPlayers()) do
        if p~=LP and p.Character then
            local h=p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health>0 and h.Health<h.MaxHealth then
                task.spawn(function()
                    pcall(function() e:FireServer("StartVisuals",p) end)
                    for i=1,6 do
                        pcall(function() e:FireServer("HealTick",p) end)
                        task.wait(.08)
                    end
                    pcall(function() e:FireServer("GiveSpeedBoost") end)
                end)
            end
        end
    end
end
