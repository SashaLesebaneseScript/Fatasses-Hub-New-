-- ============ PARTE 19/19 - Auto Task 3 + Nuevas Habilidades ============
local FH = getgenv().FH
if not FH or not FH.p18 then warn("[FH] Ejecuta Partes 1-18 primero") return end
if FH.p19 then warn("[FH] Parte 19 ya ejecutada") return end
local RS,PL,LP = FH.RS,FH.PL,FH.LP
local RST = FH.RST
local C = FH.C

FH.autoTask3 = false
FH.autoMelodic = false
FH.autoScreech = false
FH.autoHeat = false

-- ===== Auto Remember Task 3 =====
if FH.TR then
    FH.TR.OnClientEvent:Connect(function(accion, taskID, guiName)
        if accion == "OpenGui" and FH.autoTask3 then
            task.wait(0.2)
            -- El script de Task 3 usa "EndTask" para salir/fallar automáticamente
            pcall(function() FH.TR:FireServer("EndTask", taskID) end)
        end
    end)
end

-- ===== Melodic Rush (Start/End Charge) =====
local function fireMelodic()
    local ev = FH.getEv("AbilityEvent")
    if not ev then return end
    pcall(function() ev:FireServer("StartCharge") end)
    task.wait(0.5) -- Carga 0.5 segundos
    pcall(function() ev:FireServer("EndCharge", "Player") end)
end
task.spawn(function()
    while true do
        if FH.autoMelodic then fireMelodic() end
        task.wait(2.5)
    end
end)

-- ===== Rage Screech (Stun Area) =====
local function fireScreech()
    local ev = FH.getEv("AbilityEvent2")
    if not ev then return end
    -- Si el killer está cerca, grita
    local t = FH.nearest(50)
    if t then pcall(function() ev:FireServer(3) end) end
end
task.spawn(function()
    while true do
        if FH.autoScreech then fireScreech() end
        task.wait(2)
    end
end)

-- ===== Leeking Heat =====
local function fireHeat()
    local ev = FH.getEv("AbilityEvent")
    if not ev then return end
    pcall(function() ev:FireServer() end)
end
task.spawn(function()
    while true do
        if FH.autoHeat then fireHeat() end
        task.wait(3)
    end
end)

-- Añadir al panel de Experiment o Fun
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Experiment" then return end
    local opt = FH.crearOpcion
    opt("Auto Remember Task 3 📝", function(v) FH.autoTask3 = v end)
    opt("Auto Melodic Rush 🎵", function(v) FH.autoMelodic = v end)
    opt("Auto Rage Screech 😱", function(v) FH.autoScreech = v end)
    opt("Auto Leeking Heat 🔥", function(v) FH.autoHeat = v end)
end

if FH.pestana == "Experiment" then FH.panel() end
FH.p19 = true
print("🎃 [19/19] Auto Task 3 + Habilidades OK")
