    obj.MouseLeave:Connect(function()
        FH.TW:Create(obj, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Size = base}):Play()
    end)
end

FH.crearOpcion = function(nombre, cb, isBlatant)
    local o = Instance.new("Frame", oc)
