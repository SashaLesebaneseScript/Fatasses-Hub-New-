local function mkTab(n)
    local t = Instance.new("TextButton", FH.sb)
    t.Size = UDim2.new(1, -6, 0, 32)
    t.BackgroundColor3 = C.bg_card
    t.BackgroundTransparency = .1
    t.Text = ""
    t.BorderSizePixel = 0
    t.AutoButtonColor = false
    Instance.new("UICorner", t).CornerRadius = UDim.new(0, 10)
    
    local l = Instance.new("TextLabel", t)
    l.Size = UDim2.new(1, -34, 1, 0)
    l.Position = UDim2.new(0, 30, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = n
    l.TextColor3 = C.text
    l.TextScaled = true
    l.Font = Enum.Font.GothamBold
    l.TextXAlignment = Enum.TextXAlignment.Left
    
    local ck = false
    local function setSt(s) 
        if s == "sel" then 
            t.BackgroundColor3 = C.bg_card_hl
            t.BackgroundTransparency = 0 
        else 
            t.BackgroundColor3 = C.bg_card
            t.BackgroundTransparency = .1 
        end 
    end
    
    t.MouseButton1Click:Connect(function() 
        if ck or FH.pestana == n then return end
        ck = true
        FH.sfx("tab_switch", 2, 1)
        if tabs[FH.pestana] then tabs[FH.pestana].S("dese") end
        FH.pestana = n
        setSt("sel")
        task.spawn(function() pcall(FH.panel) end)
        task.delay(.5, function() ck = false end)
    end)
    
    FH.animar(t)
    tabs[n] = {S = setSt}
end

for _, n in ipairs(TABS) do mkTab(n) end
