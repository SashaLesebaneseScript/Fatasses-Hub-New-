    local l = Instance.new("TextLabel", o)
    l.Size = UDim2.new(1, -70, 1, 0)
    l.Position = UDim2.new(0, 15, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = nombre
    l.TextColor3 = C.text
    l.TextScaled = true
    l.Font = Enum.Font.GothamBold
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextWrapped = true
    
    local tb2 = Instance.new("TextButton", o)
    tb2.Size = UDim2.new(0, 48, 0, 26)
    tb2.Position = UDim2.new(1, -60, .5, -13)
    tb2.BackgroundColor3 = C.bg_dark
    tb2.Text = ""
    tb2.BorderSizePixel = 0
    tb2.AutoButtonColor = false
    Instance.new("UICorner", tb2).CornerRadius = UDim.new(1, 0)
    
    local ts = Instance.new("UIStroke", tb2)
    ts.Color = C.border
    ts.Thickness = 1.5
    ts.Transparency = .2
    
    local grad = Instance.new("UIGradient", tb2)
    grad.Color = ColorSequence.new(Color3.fromRGB(60, 30, 70), Color3.fromRGB(40, 20, 50))
    
    local b = Instance.new("Frame", tb2)
    b.Size = UDim2.new(0, 20, 0, 20)
    b.Position = UDim2.new(0, 3, .5, -10)
    b.BackgroundColor3 = C.text_sub
    b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
    
    local es = FH.est[nombre] or false
    
    local function setV(a, an)
        local t = an and .3 or 0
        local i = TweenInfo.new(t, an and Enum.EasingStyle.Back or Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
        if a then
            FH.TW:Create(b, i, {Position = UDim2.new(0, 25, .5, -10), BackgroundColor3 = C.accent, Size = UDim2.new(0, 22, 0, 22)}):Play()
            FH.TW:Create(tb2, i, {BackgroundColor3 = C.accent2}):Play()
            FH.TW:Create(ts, i, {Color = C.accent, Transparency = 0}):Play()
            grad.Color = ColorSequence.new(C.accent2, C.accent)
        else
            FH.TW:Create(b, i, {Position = UDim2.new(0, 3, .5, -10), BackgroundColor3 = C.text_sub, Size = UDim2.new(0, 20, 0, 20)}):Play()
            FH.TW:Create(tb2, i, {BackgroundColor3 = C.bg_dark}):Play()
            FH.TW:Create(ts, i, {Color = C.border, Transparency = .2}):Play()
            grad.Color = ColorSequence.new(Color3.fromRGB(60, 30, 70), Color3.fromRGB(40, 20, 50))
        end
    end
    setV(es, false)
    
    local function tg()
        if isBlatant and not FH.blatantMode then
            if FH.pestana ~= "Blatant" then 
                FH.pestana = "Blatant"
                FH.panel() 
            end
            return
        end
        es = not es
        FH.est[nombre] = es
        setV(es, true)
        FH.sfx(es and "toggle_on" or "toggle_off")
        if cb then pcall(cb, es) end
    end
    tb2.MouseButton1Click:Connect(tg)
    l.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then 
            tg() 
        end 
    end)
    FH.animar(tb2)
end

