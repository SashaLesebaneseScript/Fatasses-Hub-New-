-- ============ PARTE 7/7 - Sounds, Music, Animations ============
local FH = getgenv().FH
if not FH or not FH.p5 then warn("[FH] Ejecuta Partes 1-5 primero") return end
if FH.p7 then warn("[FH] Parte 7 ya ejecutada") return end
local RS,PL,LP = FH.RS,FH.PL,FH.LP
local C = FH.C
local fr = FH.fr
local sg = FH.sg
local TW = FH.TW

FH.SND.button = "rbxassetid://9119717523"
FH.SND.open   = "rbxassetid://9119717523"

FH.MUSIC_LIST = {
    {name="Mesmerizer",       id="rbxassetid://71934965392436"},
    {name="F-L-Y",            id="rbxassetid://76819270320985"},
    {name="Birdbrain",        id="rbxassetid://139924511923380"},
    {name="Spoken For",       id="rbxassetid://91472362989961"},
    {name="Execution Clap",   id="rbxassetid://72478420140778"},
    {name="Looping The Rooms",id="rbxassetid://116273924154778"},
}
FH.musicIndex = 1
FH.musicOn = false
FH.keepPlaying = false
FH.musicVolume = 0.15
local music = nil

FH.startMusic = function()
    if music and music.Parent then
        if not music.IsPlaying then music:Play() end
        FH.musicOn = true
        return
    end
    music = Instance.new("Sound")
    music.SoundId = FH.MUSIC_LIST[FH.musicIndex].id
    music.Volume = FH.musicVolume
    music.Looped = true
    music:SetAttribute("FH_GUI", true)
    music.Parent = sg
    music:Play()
    FH.musicOn = true
end
FH.stopMusic = function()
    if music then music:Stop(); music:Destroy(); music = nil end
    FH.musicOn = false
end
FH.setMusic = function(idx)
    if not FH.MUSIC_LIST[idx] then return end
    FH.musicIndex = idx
    if music and music.Parent then
        music.SoundId = FH.MUSIC_LIST[idx].id
        music:Play()
    elseif FH.musicOn then
        FH.startMusic()
    end
end

local origSfx = FH.sfx
FH.sfx = function(n, v, p)
    origSfx(n, v, p)
    for _, s in ipairs(FH.SS:GetChildren()) do
        if s:IsA("Sound") and not s:GetAttribute("FH_GUI") then
            s:SetAttribute("FH_GUI", true)
        end
    end
end

local function hookAll()
    for _, d in ipairs(sg:GetDescendants()) do
        if d:IsA("TextButton") and not d:GetAttribute("FH_S") then
            local p = d.Parent
            local skip = false
            if p and p.Name and string.find(p.Name, "Opt_") then skip = true end
            if p == FH.sb then skip = true end
            if not skip then
                d:SetAttribute("FH_S", true)
                d.MouseButton1Click:Connect(function()
                    pcall(function() FH.sfx("button", 1.8, 1.05) end)
                end)
            end
        end
    end
end
hookAll()

local origPanel = FH.panel
FH.panel = function()
    origPanel()
    hookAll()
    if FH.pestana ~= "Extra Stuff" then return end

    local opt = FH.crearOpcion
    local btn = FH.crearBotonAccion

    opt("Music ON/OFF 🎵", function(v)
        if v then FH.startMusic() else FH.stopMusic() end
    end)
    opt("Keep Playing 🎧", function(v) FH.keepPlaying = v end)

    -- Slider volumen
    local holder = Instance.new("Frame", FH.oc)
    holder.Size = UDim2.new(1, 0, 0, 40)
    holder.BackgroundColor3 = C.bg_card
    holder.BackgroundTransparency = 0.2
    holder.BorderSizePixel = 0
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)
    local hstroke = Instance.new("UIStroke", holder)
    hstroke.Color = C.border; hstroke.Thickness = 1; hstroke.Transparency = 0.5
    local lbl = Instance.new("TextLabel", holder)
    lbl.Size = UDim2.new(0, 84, 1, 0); lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1; lbl.Text = "Volumen"
    lbl.TextColor3 = C.text; lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold; lbl.TextXAlignment = Enum.TextXAlignment.Left
    local barBg = Instance.new("Frame", holder)
    barBg.Size = UDim2.new(1, -108, 0, 14); barBg.Position = UDim2.new(1, -96, 0.5, -7)
    barBg.BackgroundColor3 = Color3.fromRGB(20, 10, 28); barBg.BorderSizePixel = 0
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame", barBg)
    fill.Size = UDim2.new(FH.musicVolume, 0, 1, 0)
    fill.BackgroundColor3 = C.accent; fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("Frame", barBg)
    knob.Size = UDim2.new(0, 18, 0, 18); knob.Position = UDim2.new(FH.musicVolume, -9, 0.5, -9)
    knob.BackgroundColor3 = C.accent; knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local volDrag = false
    local function updateVol(x)
        local rel = math.clamp((x - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -9, 0.5, -9)
        FH.musicVolume = rel
        if music then music.Volume = rel end
    end
    barBg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            volDrag = true; updateVol(i.Position.X)
        end
    end)
    FH.UI.InputChanged:Connect(function(i)
        if volDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            updateVol(i.Position.X)
        end
    end)
    FH.UI.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            volDrag = false
        end
    end)

    for i, song in ipairs(FH.MUSIC_LIST) do
        btn("▶ " .. song.name, function()
            FH.setMusic(i)
            FH.musicOn = true
            if not music or not music.Parent then FH.startMusic() end
        end)
    end
end

local lastVisible = fr.Visible
if fr.Visible and FH.musicOn then FH.startMusic() end

RS.Heartbeat:Connect(function()
    local v = fr.Visible
    if v ~= lastVisible then
        if v then
            fr.Size = UDim2.new(0, FH.BW * 0.6, 0, FH.BH * 0.6)
            fr.BackgroundTransparency = 0.5
            TW:Create(fr, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, FH.BW, 0, FH.BH)
            }):Play()
            TW:Create(fr, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0.05
            }):Play()
            FH.sfx("open", 2, 1)
            if FH.musicOn then FH.startMusic() end
        else
            FH.sfx("close", 2.5, 1)
            if not FH.keepPlaying then
                FH.stopMusic()
                FH.musicOn = false
            end
        end
        lastVisible = v
    end
end)

FH.p7 = true
print("🎃 [7/7] Sounds + Music + Animations OK")
