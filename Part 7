-- ============ PARTE 7/7 - Sounds, Music, Animations ============
local FH = getgenv().FH
if not FH or not FH.p5 then warn("[FH] Ejecuta Partes 1-5 primero") return end
if FH.p7 then warn("[FH] Parte 7 ya ejecutada") return end
local RS,PL,LP = FH.RS,FH.PL,FH.LP
local C = FH.C
local fr = FH.fr
local sg = FH.sg
local TW = FH.TW

-- ===== Sonidos UI =====
FH.SND.button = "rbxassetid://9119717523"
FH.SND.open   = "rbxassetid://9119717523"

-- ===== Catalogo de musica =====
FH.MUSIC_LIST = {
    {name="Mesmerizer",       id="rbxassetid://71934965392436"},
    {name="F-L-Y",            id="rbxassetid://76819270320985"},
    {name="Signaling",        id="rbxassetid://111806697876232"},
    {name="Birdbrain",        id="rbxassetid://139924511923380"},
    {name="Execution Clap",   id="rbxassetid://91472362989961"},
    {name="Spoken For",       id="rbxassetid://72478420140778"},
    {name="Looping The Rooms",id="rbxassetid://116273924154778"},
}
FH.musicIndex = 1
FH.musicOn = false
FH.keepPlaying = false  -- toggle: seguir sonando con GUI cerrada
local music = nil

FH.startMusic = function()
    if music and music.Parent then
        if not music.IsPlaying then music:Play() end
        FH.musicOn = true
        return
    end
    music = Instance.new("Sound")
    music.SoundId = FH.MUSIC_LIST[FH.musicIndex].id
    music.Volume = 0.15
    music.Looped = true
    music.Parent = sg
    music:Play()
    FH.musicOn = true
end
FH.stopMusic = function()
    if music then music:Stop(); music:Destroy(); music = nil end
    FH.musicOn = false
end
FH.setMusic = function(idx)
    if not FH.MUSIC_LIST[idx] then return end
    FH.musicIndex = idx
    if music and music.Parent then
        music.SoundId = FH.MUSIC_LIST[idx].id
        music:Play()
    elseif FH.musicOn then
        FH.startMusic()
    end
end

-- ===== Hook sonido a TODOS los botones =====
local function hookAll()
    for _, d in ipairs(sg:GetDescendants()) do
        if d:IsA("TextButton") and not d:GetAttribute("FH_S") then
            local p = d.Parent
            local skip = false
            if p and p.Name and string.find(p.Name, "Opt_") then skip = true end
            if p == FH.sb then skip = true end
            if not skip then
                d:SetAttribute("FH_S", true)
                d.MouseButton1Click:Connect(function()
                    pcall(function() FH.sfx("button", 1.8, 1.05) end)
                end)
            end
        end
    end
end
hookAll()

-- ===== Hook panel: musica en Extra Stuff =====
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    hookAll()
    if FH.pestana ~= "Extra Stuff" then return end

    local opt = FH.crearOpcion
    local btn = FH.crearBotonAccion

    local h = Instance.new("TextLabel", FH.oc)
    h.Size = UDim2.new(1,0,0,22)
    h.BackgroundTransparency = 1
    h.Text = "── Música ──"
    h.TextColor3 = C.accent
    h.Font = Enum.Font.GothamBold
    h.TextScaled = true
    h.TextXAlignment = Enum.TextXAlignment.Left

    opt("Music ON/OFF 🎵", function(v)
        if v then FH.startMusic() else FH.stopMusic() end
    end)

    opt("Keep Playing 🎧", function(v)
        FH.keepPlaying = v
    end)

    for i, song in ipairs(FH.MUSIC_LIST) do
        btn("▶ " .. song.name, function()
            FH.setMusic(i)
            FH.musicOn = true
            if not music or not music.Parent then FH.startMusic() end
        end)
    end
end

-- ===== Animacion apertura/cierre =====
local lastVisible = fr.Visible
if fr.Visible and FH.musicOn then FH.startMusic() end

RS.Heartbeat:Connect(function()
    local v = fr.Visible
    if v ~= lastVisible then
        if v then
            fr.Size = UDim2.new(0, FH.BW * 0.6, 0, FH.BH * 0.6)
            fr.BackgroundTransparency = 0.5
            TW:Create(fr, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, FH.BW, 0, FH.BH)
            }):Play()
            TW:Create(fr, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0.05
            }):Play()
            FH.sfx("open", 2, 1)
            if FH.musicOn then FH.startMusic() end
        else
            FH.sfx("close", 2.5, 1)
            -- Solo parar musica si Keep Playing esta OFF
            if not FH.keepPlaying then
                FH.stopMusic()
                FH.musicOn = false
            end
        end
        lastVisible = v
    end
end)

FH.p7 = true
print("🎃 [7/7] Sounds + Music + Animations OK")
