local SPHERE_DIRS = {}
do
    for _, v in ipairs({
        Vector3.new(1,0,0), Vector3.new(-1,0,0),
        Vector3.new(0,1,0), Vector3.new(0,-1,0),
        Vector3.new(0,0,1), Vector3.new(0,0,-1),
    }) do table.insert(SPHERE_DIRS, v) end
    for _, v in ipairs({
        Vector3.new(1,1,1), Vector3.new(-1,1,1), Vector3.new(1,-1,1), Vector3.new(1,1,-1),
        Vector3.new(-1,-1,1), Vector3.new(-1,1,-1), Vector3.new(1,-1,-1), Vector3.new(-1,-1,-1),
    }) do table.insert(SPHERE_DIRS, v.Unit) end
    for _, v in ipairs({
        Vector3.new(1,1,0), Vector3.new(-1,1,0), Vector3.new(1,-1,0), Vector3.new(-1,-1,0),
        Vector3.new(1,0,1), Vector3.new(-1,0,1), Vector3.new(1,0,-1), Vector3.new(-1,0,-1),
        Vector3.new(0,1,1), Vector3.new(0,-1,1), Vector3.new(0,1,-1), Vector3.new(0,-1,-1),
    }) do table.insert(SPHERE_DIRS, v.Unit) end
end

local function soyKiller() return FH.isKiller(LP.Character) end

local function enemigoCercano(radio)
    radio = radio or K.range
    local mc = LP.Character; if not mc then return nil end
    local mh = mc:FindFirstChild("HumanoidRootPart"); if not mh then return nil end
    local best, bd = nil, radio
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local hr = p.Character:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and hr then
                local d = (mh.Position - hr.Position).Magnitude
                if d < bd then bd = d; best = p.Character end
            end
        end
    end
    return best
end

local function enemigoAlFrente(radio)
    local mc = LP.Character; if not mc then return nil end
    local mh = mc:FindFirstChild("HumanoidRootPart"); if not mh then return nil end
    local look = mh.CFrame.LookVector
    local best, bestScore = nil, -math.huge
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local hr = p.Character:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and hr then
                local diff = hr.Position - mh.Position
                local dist = diff.Magnitude
                if dist <= radio and dist > 0.1 then
                    local dot = look:Dot(diff.Unit)
                    if dot > 0.3 then
                        local score = dot * 1000 - dist
                        if score > bestScore then bestScore = score; best = p.Character end
                    end
                end
            end
        end
    end
    return best
end

local function triggerExtras()
    if EXTRA_MODE then return end
    if not soyKiller() then return end
    local ev = getPunchEv(); if not ev then return end
    local mc = LP.Character
    local mh = mc and mc:FindFirstChild("HumanoidRootPart"); if not mh then return end
    EXTRA_MODE = true

    if K.autoPunch then
        K.attackId = K.attackId + 1
        local id = K.attackId
        local startT = tick()
        while tick() - startT <= 0.4 do
            local c = LP.Character; if not c then break end
            local h = c:FindFirstChild("HumanoidRootPart"); if not h then break end
            for i = 1, 5 do
                pcall(function()
                    ev:FireServer({
                        AttackId = id,
                        Position = h.Position,
                        Velocity = h.AssemblyLinearVelocity,
                        Direction = h.CFrame.LookVector,
                    })
                end)
            end
            task.wait(0.05)
        end
    end

    if K.hitboxTp then
        local t = enemigoAlFrente(K.expanderRange) or enemigoCercano(K.range)
        if t then
            local th = t:FindFirstChild("Head") or t:FindFirstChild("HumanoidRootPart")
            if th then
                K.attackId = K.attackId + 1
                local id = K.attackId
                local boxSize = K.tpBoxSize
                local startT = tick()
                while tick() - startT <= 0.4 do
                    local t2 = t and (t:FindFirstChild("Head") or t:FindFirstChild("HumanoidRootPart"))
                    if not t2 then break end
                    local center = t2.Position
                    local step = boxSize / 2
                    for dx = -1, 1 do
                        for dy = -1, 1 do
                            for dz = -1, 1 do
                                local pos = center + Vector3.new(dx * step, dy * step, dz * step)
                                local dir = (pos - mh.Position).Unit
                                pcall(function()
                                    ev:FireServer({
                                        AttackId = id,
                                        Position = pos,
                                        Velocity = Vector3.new(0,0,0),
                                        Direction = dir,
                                    })
                                end)
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end
        end
    end

    if K.hitbox360 then
        K.attackId = K.attackId + 1
        local id = K.attackId
        local R = K.hbRange
        local startT = tick()
        while tick() - startT <= 0.4 do
            local c = LP.Character; if not c then break end
            local h = c:FindFirstChild("HumanoidRootPart"); if not h then break end
            local origin = h.Position
            for _, rfrac in ipairs({0.4, 0.7, 1.0}) do
                local r = R * rfrac
                for _, dir in ipairs(SPHERE_DIRS) do
                    local pos = origin + dir * r
                    pcall(function()
                        ev:FireServer({
                            AttackId = id,
                            Position = pos,
                            Velocity = Vector3.new(0,0,0),
                            Direction = dir,
                        })
                    end)
                end
            end
            task.wait(0.1)
        end
    end

    if K.hitboxExpander then
        K.attackId = K.attackId + 1
        local id = K.attackId
        local dist = K.expanderRange
        local width = K.expanderWidth
        local startT = tick()
        while tick() - startT <= 0.4 do
            local c = LP.Character; if not c then break end
            local h = c:FindFirstChild("HumanoidRootPart"); if not h then break end
            local look = h.CFrame.LookVector
            local right = h.CFrame.RightVector
            local up = h.CFrame.UpVector
            local origin = h.Position + look * 2
            local lenSteps = 15
            local wSteps = 2
            for i = 0, lenSteps do
                local lfrac = i / lenSteps
                local basePos = origin + look * (dist * lfrac)
                for j = -wSteps, wSteps do
                    for k = -wSteps, wSteps do
                        local offR = right * (j * (width / (2 * wSteps + 1)))
                        local offU = up * (k * (width / (2 * wSteps + 1)))
                        local pos = basePos + offR + offU
                        pcall(function()
                            ev:FireServer({
                                AttackId = id,
                                Position = pos,
                                Velocity = Vector3.new(0,0,0),
                                Direction = look,
                            })
                        end)
                    end
                end
            end
            task.wait(0.1)
        end
    end

    EXTRA_MODE = false
end

task.spawn(function()
    local ev = getPunchEv()
    local tries = 0
    while not ev and tries < 30 do
        task.wait(0.5); ev = getPunchEv(); tries = tries + 1
    end
    if not ev then return end
    pcall(function()
        local mt = getrawmetatable(game)
        if setreadonly then setreadonly(mt, false) end
        local oldNC = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "FireServer" and self == getPunchEv() then
                if not EXTRA_MODE then task.spawn(triggerExtras) end
            end
            return oldNC(self, ...)
        end)
        if setreadonly then setreadonly(mt, true) end
    end)
end)

