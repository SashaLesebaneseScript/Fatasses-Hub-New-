local function soyKiller() return FH.isKiller(LP.Character) end
local function estoyStuneado()
    local mc = LP.Character; if not mc then return false end
    local s = mc:FindFirstChild("Stun"); if s and s:IsA("BoolValue") then return s.Value == true end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if hum and hum.PlatformStand then return true end
    return false
end
local function hayPared(desde, hasta, ignorar) local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = ignorar or {}; return WS:Raycast(desde, hasta - desde, params) ~= nil end

local function enemigoCercano(radio)
    radio = radio or K.range; local mc = LP.Character; if not mc then return nil end
    local mh = mc:FindFirstChild("HumanoidRootPart"); if not mh then return nil end
    local best, bd = nil, radio
    for _, p in ipairs(PL:GetPlayers()) do if p ~= LP and p.Character then
        local h = p.Character:FindFirstChildOfClass("Humanoid"); local hr = p.Character:FindFirstChild("HumanoidRootPart")
        if h and h.Health > 0 and hr then local d = (mh.Position - hr.Position).Magnitude; if d < bd then bd = d; best = p.Character end end
    end end return best
end

