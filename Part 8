-- Extras On-Click
local function triggerExtras()
    if EXTRA_MODE or not soyKiller() or estoyStuneado() then return end
    local ev=getPunchEv(); if not ev then return end; local mc=LP.Character; local mh=mc and mc:FindFirstChild("HumanoidRootPart"); if not mh then return end; EXTRA_MODE=true
    
    -- 360 HITBOX (Reducido para evitar lag, radio 50)
    if K.worldHitbox then
        K.attackId = K.attackId + 1
        local id = K.attackId
        local R = 50
        for _, rf in ipairs({0.6, 1.0}) do
            for _, d in ipairs(SPHERE_DIRS) do
                local pos = mh.Position + d * (R * rf)
                pcall(function() ev:FireServer({AttackId=id, Position=pos, Velocity=Vector3.new(0,0,0), Direction=d}) end)
            end
        end
    end

    -- TP HITBOX (Circulo mas grande, radio 10, altura 5)
    if K.hitboxTp then 
        local t = FH.nearest(100) 
        if t and t.HRP then
            local th = t.HRP
            K.attackId = K.attackId + 1
            local id = K.attackId
            local center = th.Position
            for i = 1, 20 do
                local angle = (i / 20) * (math.pi * 2)
                local rx = math.cos(angle) * 10
                local rz = math.sin(angle) * 10
                local ry = math.random(-2.5, 2.5) 
                local pos = center + Vector3.new(rx, ry, rz)
                local dir = (pos - mh.Position).Unit
                pcall(function() ev:FireServer({AttackId=id, Position=pos, Velocity=Vector3.new(0,0,0), Direction=dir}) end)
            end
        end 
    end

    -- HITBOX EXPANDER
    if K.hitboxExpander or K.anchoredHitbox then
        K.attackId = K.attackId + 1
        local id = K.attackId
        local look = mh.CFrame.LookVector
        local right = mh.CFrame.RightVector
        local up = mh.CFrame.UpVector
        for x = -5, 5, 2.5 do
            for y = -5, 5, 2.5 do
                for z = -5, 5, 2.5 do
                    local offset = look * (z) + right * (x) + up * (y)
                    local pos = mh.Position + look * 10 + offset
                    pcall(function() ev:FireServer({AttackId = id, Position = pos, Velocity = Vector3.new(0,0,0), Direction = look}) end)
                end
            end
        end
    end
    EXTRA_MODE=false
end
task.spawn(function() local ev=getPunchEv(); local tries=0; while not ev and tries<30 do task.wait(0.5); ev=getPunchEv(); tries=tries+1 end; if not ev then return end; pcall(function() local mt=getrawmetatable(game); if setreadonly then setreadonly(mt,false) end; local oldNC=mt.__namecall; mt.__namecall=newcclosure(function(self,...) if getnamecallmethod()=="FireServer" and self==getPunchEv() then if not EXTRA_MODE then task.spawn(triggerExtras) end end; return oldNC(self,...) end); if setreadonly then setreadonly(mt,true) end end) end)

