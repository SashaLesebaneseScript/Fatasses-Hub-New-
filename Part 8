local amsConn = nil; local function startAMS() if amsConn then return end; amsConn = RS.Heartbeat:Connect(function() if not K.alwaysMaxSpeed or not soyKiller() or estoyStuneado() then return end; local mc = LP.Character; if not mc then return end; local hum = mc:FindFirstChildOfClass("Humanoid"); if hum and hum.WalkSpeed ~= 27 then pcall(function() hum.WalkSpeed = 27 end) end end) end; local function stopAMS() K.alwaysMaxSpeed = false; if amsConn then amsConn:Disconnect(); amsConn = nil end end

local killAllConn = nil; local savedSpeedKA, savedJumpKA = 16, 50; local killAllStuckT = 0
local function getNearestSurvivor() local mc = LP.Character; if not mc then return nil end; local mh = mc:FindFirstChild("HumanoidRootPart"); if not mh then return nil end; local best, bd = nil, math.huge; for _, p in ipairs(PL:GetPlayers()) do if p ~= LP and p.Character then local h = p.Character:FindFirstChildOfClass("Humanoid"); local hrp = p.Character:FindFirstChild("HumanoidRootPart"); if h and h.Health > 0 and hrp then local d = (mh.Position - hrp.Position).Magnitude; if d < bd then bd = d; best = p.Character end end end end return best end
local function updateKillAll() if not K.killAll or estoyStuneado() then return end; local survivor = getNearestSurvivor(); if not survivor then return end; local shrp = survivor:FindFirstChild("HumanoidRootPart"); if not shrp then return end; local mc = LP.Character; if not mc then return end; local myhrp = mc:FindFirstChild("HumanoidRootPart"); if not myhrp then return end; local myhum = mc:FindFirstChildOfClass("Humanoid"); if myhum then myhum.WalkSpeed = 0; myhum.JumpPower = 0 end; local targetPos = shrp.Position + Vector3.new(2.5, 1, 0); local finalLook = Vector3.new(shrp.Position.X, targetPos.Y, shrp.Position.Z); if (myhrp.Position - shrp.Position).Magnitude > 2.5 then local newPos = myhrp.Position:Lerp(targetPos, 0.1); local ignorar = {mc, survivor}; if hayPared(myhrp.Position, newPos, ignorar) or hayPared(Vector3.new(myhrp.Position.X, myhrp.Position.Y + 2, myhrp.Position.Z), Vector3.new(newPos.X, newPos.Y + 2, newPos.Z), ignorar) then if tick() - killAllStuckT > 1.5 then pcall(function() myhrp.CFrame = CFrame.lookAt(targetPos, finalLook) end); killAllStuckT = tick(); return end; if killAllStuckT == 0 then killAllStuckT = tick() end; myhrp.CFrame = CFrame.new(myhrp.Position) * CFrame.Angles(0, math.atan2(-(shrp.Position.X - myhrp.Position.X), -(shrp.Position.Z - myhrp.Position.Z)), 0); return end; killAllStuckT = 0; pcall(function() myhrp.CFrame = CFrame.lookAt(newPos, finalLook) end); return end; killAllStuckT = 0; pcall(function() myhrp.CFrame = CFrame.lookAt(myhrp.Position, finalLook) end) end
local function startKillAll() if killAllConn then return end; local mc = LP.Character; if mc then local hum = mc:FindFirstChildOfClass("Humanoid"); if hum then savedSpeedKA = hum.WalkSpeed; savedJumpKA = hum.JumpPower end end; killAllConn = RS.RenderStepped:Connect(function() pcall(updateKillAll) end) end
local function stopKillAll() K.killAll = false; if killAllConn then killAllConn:Disconnect(); killAllConn = nil end; local mc = LP.Character; if mc then local hum = mc:FindFirstChildOfClass("Humanoid"); if hum then hum.WalkSpeed = savedSpeedKA; hum.JumpPower = savedJumpKA end end end

local stunConns = {}
local function nukeStun(val) if val:GetAttribute("FH_STUN") then return end; val:SetAttribute("FH_STUN", true); pcall(function() val.Value = false end); table.insert(stunConns, val:GetPropertyChangedSignal("Value"):Connect(function() if K.antiStun and val.Value then pcall(function() val.Value = false end) end end)) end
local function findStunValues() local mc = LP.Character; if not mc then return end; for _, d in ipairs(mc:GetDescendants()) do if d.Name:lower():find("stun") and (d:IsA("BoolValue") or d:IsA("IntValue") or d:IsA("NumberValue")) then nukeStun(d) end end end
local antiStunConn = nil; local function startAntiStun() findStunValues(); if antiStunConn then return end; antiStunConn = RS.Heartbeat:Connect(function() if K.antiStun then findStunValues() end end) end; local function stopAntiStun() K.antiStun = false; if antiStunConn then antiStunConn:Disconnect(); antiStunConn = nil end; for _, c in ipairs(stunConns) do pcall(function() c:Disconnect() end) end; stunConns = {} end

