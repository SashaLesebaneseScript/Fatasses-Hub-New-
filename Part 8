-- ===== Emotes (solo Roblox oficiales, loop toggle) =====
FH.EMOTES = {
    {name="Wave",       id="rbxassetid://507770239"},
    {name="Point",      id="rbxassetid://507770453"},
    {name="Dance",      id="rbxassetid://507771019"},
    {name="Laugh",      id="rbxassetid://507770818"},
    {name="Cheer",      id="rbxassetid://507770677"},
    {name="Dance 2",    id="rbxassetid://507771379"},
    {name="Dance 3",    id="rbxassetid://507776043"},
    {name="Salute",     id="rbxassetid://507770677"},
    {name="Sit",        id="rbxassetid://2506281703"},
    {name="Lay",        id="rbxassetid://2825746228"},
}
FH.emoteLoopActive = {}   -- {id → true/false}
FH.emoteTracks = {}       -- {id → AnimationTrack}

local function getEmoteTrack(animId)
    if FH.emoteTracks[animId] then return FH.emoteTracks[animId] end
    local mc = LP.Character; if not mc then return nil end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if not hum then return nil end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then animator = Instance.new("Animator"); animator.Parent = hum end
    local a = Instance.new("Animation")
    a.AnimationId = animId
    local tr = animator:LoadAnimation(a)
    tr.Looped = true
    tr.Priority = Enum.AnimationPriority.Action
    FH.emoteTracks[animId] = tr
    return tr
end

local function stopEmoteById(animId)
    local tr = FH.emoteTracks[animId]
    if tr then pcall(function() tr:Stop() end) end
    FH.emoteLoopActive[animId] = false
end

local function stopAllEmotes()
    for id in pairs(FH.emoteLoopActive) do
        local tr = FH.emoteTracks[id]
        if tr then pcall(function() tr:Stop() end) end
    end
    FH.emoteLoopActive = {}
end

local function toggleEmote(animId)
    if FH.emoteLoopActive[animId] then
        stopEmoteById(animId)
    else
        -- Detener los demas antes de empezar uno nuevo
        stopAllEmotes()
        local tr = getEmoteTrack(animId)
        if tr then
            FH.emoteLoopActive[animId] = true
            pcall(function() tr:Play(0.1) end)
        end
    end
end
