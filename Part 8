-- ============ PARTE 8/8 - Lógica ============
local FH = getgenv().FH
if not FH or not FH.p7 then return end
if FH.p8 then return end
local RS,PL,WS,RST,LP = FH.RS,FH.PL,FH.WS,FH.RST,FH.LP
FH.k8 = FH.k8 or {killAll=false, attackId=0}

-- ===== CLASS A (Real 9999 y Bypass) =====
local HealEv = RST:FindFirstChild("HealingAbility") and RST.HealingAbility:FindFirstChild("HealingEvent")
task.spawn(function()
    while task.wait(0.05) do
        if FH.on.autoHeal or FH.on.jackpot or FH.infiniteRange or FH.dontStopHeal then
            local target = FH.injPlayer(9999) or LP
            if target and target.Character then
                if HealEv then
                    pcall(function() HealEv:FireServer("StartVisuals", target) end)
                    -- Forzar 9999 de forma real spameando el tick sin parar
                    for i=1,20 do 
                        pcall(function() HealEv:FireServer("HealTick", target) end) 
                    end
                    pcall(function() HealEv:FireServer("GiveSpeedBoost") end)
                end
            end
        end
        if FH.fakeUI then
            local hg = LP.PlayerGui:FindFirstChild("HealingGui")
            if hg and hg:FindFirstChild("HealingButton") then
                local ct = hg.HealingButton:FindFirstChild("CooldownText")
                if ct then ct.Text = "9999/30" end
            end
        end
    end
end)

-- ===== EXPERIMENT =====
local PunchEv = RST:FindFirstChild("PunchEvent")
-- Auto Punch sin cooldown
task.spawn(function()
    while task.wait(0.01) do
        if not FH.experimentPunch or not FH.isKiller(LP.Character) then continue end
        FH.k8.attackId = FH.k8.attackId + 1
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp and PunchEv then
            pcall(function() PunchEv:FireServer({AttackId=FH.k8.attackId, Position=hrp.Position, Velocity=hrp.AssemblyLinearVelocity, Direction=hrp.CFrame.LookVector}) end)
        end
    end
end)

-- Kill All pegado (Guardian)
RS.RenderStepped:Connect(function()
    if FH.k8.killAll and FH.isKiller(LP.Character) then
        local target = FH.nearest(2000)
        if target and target.HRP then
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Pegarse al objetivo de forma exacta y mirarlo
                hrp.CFrame = CFrame.lookAt(target.HRP.Position + (target.HRP.CFrame.LookVector * -2) + Vector3.new(0,2,0), target.HRP.Position)
                FH.k8.attackId = FH.k8.attackId + 1
                if PunchEv then pcall(function() PunchEv:FireServer({AttackId=FH.k8.attackId, Position=target.HRP.Position, Velocity=Vector3.new(0,0,0), Direction=Vector3.new(0,1,0)}) end) end
            end
        end
    end
end)

-- Force Speed 26 y Melodic Rush
RS.Heartbeat:Connect(function()
    if FH.isKiller(LP.Character) then
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            if FH.forceSpeed26 then hum.WalkSpeed = 26 end
            if FH.controlRush or FH.infiniteRush then
                if FH.controlRush then
                    local move = FH.UI:GetMoveVector()
                    hum:Move(move, false)
                end
                if FH.infiniteRush then
                    local abEv = RST:FindFirstChild("AbilityEvent")
                    if abEv then pcall(function() abEv:FireServer() end) end
                end
            end
        end
    end
end)

-- ===== CLASS S =====
FH.aimlockConn = RS.RenderStepped:Connect(function()
    if not FH.on.aimlockS then return end
    if FH.UI:IsKeyDown(Enum.KeyCode.F) or FH.UI:IsKeyDown(Enum.KeyCode.ButtonL2) then
        local exp = FH.getExperiment()
        if exp and exp.Character and exp.Character:FindFirstChild("Head") then
            workspace.CurrentCamera.CFrame = CFrame.lookAt(workspace.CurrentCamera.CFrame.Position, exp.Character.Head.Position)
        end
    end
end)

local GunEvent = RST:FindFirstChild("GunEvent")
task.spawn(function()
    while task.wait(0.5) do
        if not FH.classSAutoShoot then continue end
        local exp = FH.getExperiment()
        if exp and exp.Character and exp.Character:FindFirstChild("Head") then
            local myChar = LP.Character
            if myChar then
                pcall(function() myChar:SetAttribute("IsAiming", true) end)
                if GunEvent then pcall(function() GunEvent:FireServer("Shoot", exp.Character.Head.Position) end) end
            end
        end
    end
end)

FH.p8=true
