local killAllConn = nil
local savedSpeedKA, savedJumpKA = 16, 50
local killAllStuckT = 0

local function getNearestSurvivor()
    local mc = LP.Character; if not mc then return nil end
    local mh = mc:FindFirstChild("HumanoidRootPart"); if not mh then return nil end
    local best, bd = nil, math.huge
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and hrp then
                local d = (mh.Position - hrp.Position).Magnitude
                if d < bd then bd = d; best = p.Character end
            end
        end
    end
    return best
end

local function updateKillAll()
    if not K.killAll then return end
    if estoyStuneado() then return end
    local survivor = getNearestSurvivor()
    if not survivor then return end
    local shrp = survivor:FindFirstChild("HumanoidRootPart"); if not shrp then return end
    local mc = LP.Character; if not mc then return end
    local myhrp = mc:FindFirstChild("HumanoidRootPart"); if not myhrp then return end
    local myhum = mc:FindFirstChildOfClass("Humanoid")
    if myhum then myhum.WalkSpeed = 0; myhum.JumpPower = 0 end

    local targetPos = shrp.Position + Vector3.new(2.5, 1, 0)
    local finalLook = Vector3.new(shrp.Position.X, targetPos.Y, shrp.Position.Z)
    local dist = (myhrp.Position - shrp.Position).Magnitude

    if dist > 2.5 then
        local newPos = myhrp.Position:Lerp(targetPos, 0.1)
        local ignorar = {mc, survivor}
        local hayPared1 = hayPared(myhrp.Position, newPos, ignorar)
        local headA = Vector3.new(myhrp.Position.X, myhrp.Position.Y + 2, myhrp.Position.Z)
        local headB = Vector3.new(newPos.X, newPos.Y + 2, newPos.Z)
        local hayPared2 = hayPared(headA, headB, ignorar)
        if hayPared1 or hayPared2 then
            -- Stuck detection: si llevamos 1.5s sin movernos, forzar el TP
            if tick() - killAllStuckT > 1.5 then
                pcall(function() myhrp.CFrame = CFrame.lookAt(targetPos, finalLook) end)
                killAllStuckT = tick()
                return
            end
            if killAllStuckT == 0 then killAllStuckT = tick() end
            local ry = math.atan2(-(shrp.Position.X - myhrp.Position.X), -(shrp.Position.Z - myhrp.Position.Z))
            myhrp.CFrame = CFrame.new(myhrp.Position) * CFrame.Angles(0, ry, 0)
            return
        end
        -- Camino libre: resetear stuck timer
        killAllStuckT = 0
        pcall(function() myhrp.CFrame = CFrame.lookAt(newPos, finalLook) end)
        return
    end
    killAllStuckT = 0
    pcall(function() myhrp.CFrame = CFrame.lookAt(myhrp.Position, finalLook) end)
end
