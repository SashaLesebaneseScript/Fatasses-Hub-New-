-- ============ PARTE 8/8 - Killer & Tasks ============
local FH = getgenv().FH
if not FH or not FH.p7 then warn("[FH] Ejecuta Partes 1-7 primero") return end
if FH.p8 then warn("[FH] Parte 8 ya ejecutada") return end
local RS,PL,WS,RST,LP = FH.RS,FH.PL,FH.WS,FH.RST,FH.LP
local C = FH.C

FH.on = FH.on or {}
FH.classSAutoShoot = false
FH.experimentPunch = false

-- 1. AUTO SHOOT (CLASS S)
task.spawn(function()
    local GunEvent = RST:FindFirstChild("GunEvent")
    while task.wait(0.1) do
        if not FH.classSAutoShoot or not GunEvent then continue end
        local target = FH.nearest and FH.nearest(500) or nil
        if target and target.Char and target.Char:FindFirstChild("Head") then
            local myChar = LP.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHRP then
                -- Rotar al enemigo y disparar
                local lookAt = CFrame.lookAt(myHRP.Position, target.Char.Head.Position)
                myHRP.CFrame = lookAt
                pcall(function() GunEvent:FireServer("Shoot", target.Char.Head.Position) end)
            end
        end
    end
end)

-- 2. KILL ALL (Heartbeat: Rápido)
local killAllConn = nil
FH.updateKillAll = function()
    if FH.k8.killAll and not killAllConn then
        killAllConn = RS.Heartbeat:Connect(function()
            if not FH.k8.killAll or not FH.isKiller(LP.Character) then return end
            local survivor = FH.nearest and FH.nearest(2000) or nil
            if survivor and survivor.HRP then
                local mc = LP.Character; local hrp = mc and mc:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local targetPos = survivor.HRP.Position
                    pcall(function() hrp.CFrame = CFrame.new(targetPos + Vector3.new(0,0,3)) end)
                    local ev = RST:FindFirstChild("PunchEvent")
                    if ev then
                        FH.k8.attackId = FH.k8.attackId + 1
                        for i = 1, 5 do
                            pcall(function() ev:FireServer({AttackId=FH.k8.attackId, Position=targetPos, Velocity=Vector3.new(0,0,0), Direction=Vector3.new(0,1,0)}) end)
                        end
                    end
                end
            end
        end)
    elseif not FH.k8.killAll and killAllConn then
        killAllConn:Disconnect(); killAllConn = nil
    end
end

-- 3. M1 EXPERIMENT
FH.lastPunchId = FH.lastPunchId or 0
task.spawn(function()
    local PunchEv = RST:WaitForChild("PunchEvent", 10)
    if not PunchEv then return end
    while task.wait(0.1) do
        if not FH.experimentPunch then continue end
        local char = LP.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        local stun = char:FindFirstChild("Stun")
        if stun and stun:IsA("BoolValue") and stun.Value then continue end
        FH.lastPunchId = FH.lastPunchId + 1
        local id = FH.lastPunchId
        local t0 = tick()
        while tick() - t0 <= 0.4 do
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then break end
            pcall(function() PunchEv:FireServer({AttackId=id, Position=hrp.Position, Velocity=hrp.AssemblyLinearVelocity, Direction=hrp.CFrame.LookVector}) end)
            task.wait(0.02)
        end
        task.wait(1.6)
    end
end)

-- 4. HITBOXES ENORMES
local EXTRA_MODE = false
local SPHERE_DIRS = {}; for x=-1,1 do for y=-1,1 do for z=-1,1 do if x~=0 or y~=0 or z~=0 then table.insert(SPHERE_DIRS, Vector3.new(x,y,z).Unit) end end end end
local function triggerExtras()
    if EXTRA_MODE or not FH.isKiller(LP.Character) then return end
    local ev=RST:FindFirstChild("PunchEvent"); if not ev then return end
    local mc=LP.Character; local mh=mc and mc:FindFirstChild("HumanoidRootPart"); if not mh then return end
    EXTRA_MODE=true

    if FH.k8.worldHitbox then 
        FH.k8.attackId = FH.k8.attackId + 1
        for _, rf in ipairs({0.4, 0.8, 1.2}) do 
            for _, d in ipairs(SPHERE_DIRS) do 
                local pos = mh.Position + d * (80 * rf)
                pcall(function() ev:FireServer({AttackId=FH.k8.attackId, Position=pos, Velocity=Vector3.new(0,0,0), Direction=d}) end)
            end 
        end 
    end
    if FH.k8.hitboxExpander or FH.k8.anchoredHitbox then 
        FH.k8.attackId = FH.k8.attackId + 1
        local look = mh.CFrame.LookVector; local right = mh.CFrame.RightVector; local up = mh.CFrame.UpVector
        for x = -15, 15, 5 do 
            for y = -15, 15, 5 do 
                for z = -15, 15, 5 do 
                    local offset = look * (z) + right * (x) + up * (y)
                    local pos = mh.Position + look * 10 + offset
                    pcall(function() ev:FireServer({AttackId = FH.k8.attackId, Position = pos, Velocity = Vector3.new(0,0,0), Direction = look}) end)
                end 
            end 
        end 
    end
    EXTRA_MODE=false
end
task.spawn(function() 
    local ev=RST:WaitForChild("PunchEvent",10); if not ev then return end
    pcall(function() 
        local mt=getrawmetatable(game); setreadonly(mt,false)
        local oldNC=mt.__namecall
        mt.__namecall=newcclosure(function(self,...) 
            if getnamecallmethod()=="FireServer" and self==ev and not EXTRA_MODE then task.spawn(triggerExtras) end
            return oldNC(self,...) 
        end)
        setreadonly(mt,true) 
    end) 
end)

