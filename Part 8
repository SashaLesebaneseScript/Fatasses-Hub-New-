-- Extras On-Click
local function triggerExtras()
    if EXTRA_MODE or not soyKiller() or estoyStuneado() then return end
    local ev=getPunchEv(); if not ev then return end; local mc=LP.Character; local mh=mc and mc:FindFirstChild("HumanoidRootPart"); if not mh then return end; EXTRA_MODE=true
    if K.hitboxTp then local t=enemigoCercano(K.expanderRange); if t then local th=t:FindFirstChild("Head") or t:FindFirstChild("HumanoidRootPart"); if th then K.attackId=K.attackId+1; local id=K.attackId; local step=K.tpBoxSize/2; local sT=tick(); while tick()-sT<=0.4 do if estoyStuneado() then break end; local t2=t and (t:FindFirstChild("Head") or t:FindFirstChild("HumanoidRootPart")); if not t2 then break end; local c=t2.Position; for dx=-1,1 do for dy=-1,1 do for dz=-1,1 do local p=c+Vector3.new(dx*step,dy*step,dz*step); local d=(p-mh.Position).Unit; pcall(function() ev:FireServer({AttackId=id, Position=p, Velocity=Vector3.new(0,0,0), Direction=d}) end) end end end; task.wait(0.1) end end end end
    if K.hitbox360 then K.attackId=K.attackId+1; local id=K.attackId; local R=K.hbRange; local sT=tick(); while tick()-sT<=0.4 do if estoyStuneado() then break end; local c=LP.Character; if not c then break end; local h=c:FindFirstChild("HumanoidRootPart"); if not h then break end; for _,rf in ipairs({0.4,0.7,1.0}) do for _,d in ipairs(SPHERE_DIRS) do pcall(function() ev:FireServer({AttackId=id, Position=h.Position+d*(R*rf), Velocity=Vector3.new(0,0,0), Direction=d}) end) end end; task.wait(0.1) end end
    -- Hitbox Expander
    if K.hitboxExpander or K.anchoredHitbox then
        local look = mh.CFrame.LookVector
        local target = enemigoCercano(K.range)
        local targetPos = target and target:FindFirstChild("HumanoidRootPart") and target.HumanoidRootPart.Position
        for i=1,7 do
            K.attackId = K.attackId + 1
            local pos
            if K.anchoredHitbox then pos = mh.Position + look * (i * 3)
            else local dir = (targetPos and (targetPos - mh.Position).Unit) or look; pos = mh.Position + dir * (i * 3) end
            pcall(function() ev:FireServer({AttackId=K.attackId, Position=pos, Velocity=Vector3.new(0,0,0), Direction=look}) end)
            task.wait(0.05)
        end
    end
    EXTRA_MODE=false
end

task.spawn(function() local ev=getPunchEv(); local tries=0; while not ev and tries<30 do task.wait(0.5); ev=getPunchEv(); tries=tries+1 end; if not ev then return end; pcall(function() local mt=getrawmetatable(game); if setreadonly then setreadonly(mt,false) end; local oldNC=mt.__namecall; mt.__namecall=newcclosure(function(self,...) if getnamecallmethod()=="FireServer" and self==getPunchEv() then if not EXTRA_MODE then task.spawn(triggerExtras) end end; return oldNC(self,...) end); if setreadonly then setreadonly(mt,true) end end) end)

local amsConn=nil; local function startAMS() if amsConn then return end; amsConn=RS.Heartbeat:Connect(function() if not K.alwaysMaxSpeed or not soyKiller() or estoyStuneado() then return end; local mc=LP.Character; if not mc then return end; local hum=mc:FindFirstChildOfClass("Humanoid"); if hum and hum.WalkSpeed~=27 then pcall(function() hum.WalkSpeed=27 end) end end) end; local function stopAMS() K.alwaysMaxSpeed=false; if amsConn then amsConn:Disconnect(); amsConn=nil end end
local killAllConn=nil; local savedSpeedKA,savedJumpKA=16,50; local killAllStuckT=0
local function getNearestSurvivor() local mc=LP.Character; if not mc then return nil end; local mh=mc:FindFirstChild("HumanoidRootPart"); if not mh then return nil end; local b,bd=nil,math.huge; for _,p in ipairs(PL:GetPlayers()) do if p~=LP and p.Character then local h=p.Character:FindFirstChildOfClass("Humanoid"); local hrp=p.Character:FindFirstChild("HumanoidRootPart"); if h and h.Health>0 and hrp then local d=(mh.Position-hrp.Position).Magnitude; if d<bd then bd=d; b=p.Character end end end end return b end
local function updateKillAll() if not K.killAll or estoyStuneado() then return end; local s=getNearestSurvivor(); if not s then return end; local shrp=s:FindFirstChild("HumanoidRootPart"); if not shrp then return end; local mc=LP.Character; if not mc then return end; local myhrp=mc:FindFirstChild("HumanoidRootPart"); if not myhrp then return end; local myhum=mc:FindFirstChildOfClass("Humanoid"); if myhum then myhum.WalkSpeed=0; myhum.JumpPower=0 end; local tPos=shrp.Position+Vector3.new(2.5,1,0); local fLook=Vector3.new(shrp.Position.X,tPos.Y,shrp.Position.Z); if (myhrp.Position-shrp.Position).Magnitude>2.5 then local nPos=myhrp.Position:Lerp(tPos,0.1); local ign={mc,s}; if hayPared(myhrp.Position,nPos,ign) or hayPared(Vector3.new(myhrp.Position.X,myhrp.Position.Y+2,myhrp.Position.Z),Vector3.new(nPos.X,nPos.Y+2,nPos.Z),ign) then if tick()-killAllStuckT>1.5 then pcall(function() myhrp.CFrame=CFrame.lookAt(tPos,fLook) end); killAllStuckT=tick(); return end; if killAllStuckT==0 then killAllStuckT=tick() end; myhrp.CFrame=CFrame.new(myhrp.Position)*CFrame.Angles(0,math.atan2(-(shrp.Position.X-myhrp.Position.X),-(shrp.Position.Z-myhrp.Position.Z)),0); return end; killAllStuckT=0; pcall(function() myhrp.CFrame=CFrame.lookAt(nPos,fLook) end); return end; killAllStuckT=0; pcall(function() myhrp.CFrame=CFrame.lookAt(myhrp.Position,fLook) end) end
local function startKillAll() if killAllConn then return end; local mc=LP.Character; if mc then local h=mc:FindFirstChildOfClass("Humanoid"); if h then savedSpeedKA=h.WalkSpeed; savedJumpKA=h.JumpPower end end; killAllConn=RS.RenderStepped:Connect(function() pcall(updateKillAll) end) end
local function stopKillAll() K.killAll=false; if killAllConn then killAllConn:Disconnect(); killAllConn=nil end; local mc=LP.Character; if mc then local h=mc:FindFirstChildOfClass("Humanoid"); if h then h.WalkSpeed=savedSpeedKA; h.JumpPower=savedJumpKA end end end
local stunConns={}; local function nukeStun(v) if v:GetAttribute("FH_STUN") then return end; v:SetAttribute("FH_STUN",true); pcall(function() v.Value=false end); table.insert(stunConns,v:GetPropertyChangedSignal("Value"):Connect(function() if K.antiStun and v.Value then pcall(function() v.Value=false end) end end)) end
local function findStunValues() local mc=LP.Character; if not mc then return end; for _,d in ipairs(mc:GetDescendants()) do if d.Name:lower():find("stun") and (d:IsA("BoolValue") or d:IsA("IntValue") or d:IsA("NumberValue")) then nukeStun(d) end end end
