local function soyKiller() return FH.isKiller(LP.Character) end
local function estoyStuneado() local mc=LP.Character; if not mc then return false end; local s=mc:FindFirstChild("Stun"); if s and s:IsA("BoolValue") then return s.Value==true end; local h=mc:FindFirstChildOfClass("Humanoid"); if h and h.PlatformStand then return true end; return false end
