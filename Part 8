-- 360 HITBOX & HITBOX TP
local function triggerExtras()
    if EXTRA_MODE or not soyKiller() or estoyStuneado() then return end
    local ev=getPunchEv(); if not ev then return end; local mc=LP.Character; local mh=mc and mc:FindFirstChild("HumanoidRootPart"); if not mh then return end; EXTRA_MODE=true
    
    if K.hitbox360 then
        K.attackId = K.attackId + 1; local id = K.attackId; local R = K.hbRange; local sT = tick()
        while tick() - sT <= 0.4 do
            for _, rf in ipairs({0.4, 0.7, 1.0}) do for _, d in ipairs(SPHERE_DIRS) do
                pcall(function() ev:FireServer({AttackId=id, Position=mh.Position+d*(R*rf), Velocity=Vector3.new(0,0,0), Direction=d}) end)
            end end
            task.wait(0.1)
        end
    end
    
    if K.hitboxTp then local t=FH.nearest(K.expanderRange); if t then local th=t.Char:FindFirstChild("Head") or t.Char:FindFirstChild("HumanoidRootPart"); if th then K.attackId=K.attackId+1; local id=K.attackId; local step=K.tpBoxSize/2; local sT=tick(); while tick()-sT<=0.4 do if estoyStuneado() then break end; local c=th.Position; for dx=-1,1 do for dy=-1,1 do for dz=-1,1 do local p=c+Vector3.new(dx*step,dy*step,dz*step); local d=(p-mh.Position).Unit; pcall(function() ev:FireServer({AttackId=id, Position=p, Velocity=Vector3.new(0,0,0), Direction=d}) end) end end end; task.wait(0.1) end end end end
    
    if K.hitboxExpander or K.anchoredHitbox then
        local look = mh.CFrame.LookVector; local target = FH.nearest(K.range); local targetPos = target and target.HRP.Position
        for i=1,7 do K.attackId = K.attackId + 1; local pos
            if K.anchoredHitbox then pos = mh.Position + look * (i * 3)
            else local dir = (targetPos and (targetPos - mh.Position).Unit) or look; pos = mh.Position + dir * (i * 3) end
            pcall(function() ev:FireServer({AttackId=K.attackId, Position=pos, Velocity=Vector3.new(0,0,0), Direction=look}) end); task.wait(0.05)
        end
    end
    EXTRA_MODE=false
end

task.spawn(function() local ev=getPunchEv(); local tries=0; while not ev and tries<30 do task.wait(0.5); ev=getPunchEv(); tries=tries+1 end; if not ev then return end; pcall(function() local mt=getrawmetatable(game); if setreadonly then setreadonly(mt,false) end; local oldNC=mt.__namecall; mt.__namecall=newcclosure(function(self,...) if getnamecallmethod()=="FireServer" and self==getPunchEv() then if not EXTRA_MODE then task.spawn(triggerExtras) end end; return oldNC(self,...) end); if setreadonly then setreadonly(mt,true) end end) end)

