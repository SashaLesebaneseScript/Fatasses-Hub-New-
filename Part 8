-- Extras On-Click (Extras manuales)
local function triggerExtras()
    if EXTRA_MODE or not soyKiller() or estoyStuneado() then return end
    local ev = getPunchEv(); if not ev then return end
    local mc = LP.Character; local mh = mc and mc:FindFirstChild("HumanoidRootPart"); if not mh then return end
    EXTRA_MODE = true
    
    if K.hitboxTp then
        local t = enemigoCercano(K.expanderRange)
        if t then local th = t:FindFirstChild("Head") or t:FindFirstChild("HumanoidRootPart")
            if th then K.attackId = K.attackId + 1; local id = K.attackId; local step = K.tpBoxSize / 2; local startT = tick()
                while tick() - startT <= 0.4 do
                    if estoyStuneado() then break end
                    local t2 = t and (t:FindFirstChild("Head") or t:FindFirstChild("HumanoidRootPart")); if not t2 then break end
                    local center = t2.Position
                    for dx=-1,1 do for dy=-1,1 do for dz=-1,1 do
                        local pos = center + Vector3.new(dx*step, dy*step, dz*step); local dir = (pos - mh.Position).Unit
                        pcall(function() ev:FireServer({AttackId=id, Position=pos, Velocity=Vector3.new(0,0,0), Direction=dir}) end)
                    end end end
                    task.wait(0.1)
                end
            end
        end
    end
    
    if K.hitbox360 then
        K.attackId = K.attackId + 1; local id = K.attackId; local R = K.hbRange; local startT = tick()
        while tick() - startT <= 0.4 do
            if estoyStuneado() then break end
            local c = LP.Character; if not c then break end
            local h = c:FindFirstChild("HumanoidRootPart"); if not h then break end
            for _, rfrac in ipairs({0.4, 0.7, 1.0}) do for _, dir in ipairs(SPHERE_DIRS) do
                pcall(function() ev:FireServer({AttackId=id, Position=h.Position + dir*(R*rfrac), Velocity=Vector3.new(0,0,0), Direction=dir}) end)
            end end
            task.wait(0.1)
        end
    end
    
    if K.hitboxExpander then
        K.attackId = K.attackId + 1; local id = K.attackId; local look = mh.CFrame.LookVector
        local dist = K.expanderRange; local width = K.expanderWidth; local startT = tick()
        while tick() - startT <= 0.3 do
            if estoyStuneado() then break end
            -- Solo 1 hitbox extra al frente para que sea realista
            local pos = mh.Position + look * dist
            pcall(function() ev:FireServer({AttackId=id, Position=pos, Velocity=Vector3.new(0,0,0), Direction=look}) end)
            task.wait(0.1)
        end
    end
    EXTRA_MODE = false
end

task.spawn(function()
    local ev = getPunchEv(); local tries = 0
    while not ev and tries < 30 do task.wait(0.5); ev = getPunchEv(); tries = tries + 1 end
    if not ev then return end
    pcall(function()
        local mt = getrawmetatable(game); if setreadonly then setreadonly(mt, false) end
        local oldNC = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "FireServer" and self == getPunchEv() then if not EXTRA_MODE then task.spawn(triggerExtras) end end
            return oldNC(self, ...)
        end)
        if setreadonly then setreadonly(mt, true) end
    end)
end)

