            task.spawn(function() while FH.k8.alwaysMaxSpeed do local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid"); if h then h.WalkSpeed=30 end; task.wait(0.1) end end)
        end
    end, true)
    opt("Kill All ☠️",function(v) FH.k8.killAll=v; FH.updateKillAll() end, true)
