local FH = getgenv().FH
if not FH or not FH.p1 then return end
local RS, PL, LP = FH.RS, FH.PL, FH.LP
local C = FH.C

FH.sashaSprint = false
FH.noclipActive = false

FH.MUSIC_LIST = {
    {name="Mesmerizer",       id="rbxassetid://71934965392436"},
    {name="F-L-Y",            id="rbxassetid://76819270320985"},
    {name="Birdbrain",        id="rbxassetid://139924511923380"},
    {name="Spoken For",       id="rbxassetid://91472362989961"},
    {name="Execution Clap",   id="rbxassetid://72478420140778"},
    {name="Looping The Rooms",id="rbxassetid://116273924154778"}
}
local music = nil

local function playMusic(id)
    if music then music:Destroy() end
    music = Instance.new("Sound")
    music.SoundId = id
    music.Volume = FH.musicVolume
    music.Looped = true
    music.Parent = FH.SS
    music:Play()
end

local function stopMusic()
    if music then music:Destroy(); music = nil end
end

RS.RenderStepped:Connect(function()
    if FH.sashaSprint then
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local stam = char:FindFirstChild("Stam")
            if FH.UI:IsKeyDown(Enum.KeyCode.LeftShift) or FH.isSprintingManually then
                if hum and hum.WalkSpeed ~= 30 then hum.WalkSpeed = 30 end
                if stam then stam.Value = 100 end
            end
            local pg = LP:FindFirstChild("PlayerGui")
            if pg then
                local sg = pg:FindFirstChild("SprintGui")
                if sg then
                    local txt = sg:FindFirstChild("StaminaText", true)
                    local bar = sg:FindFirstChild("FillFrame", true)
                    if txt and txt:IsA("TextLabel") then txt.Text = "Sasha Wuz Here" end
                    if bar and bar:IsA("Frame") then 
                        bar.Size = UDim2.new(1, 0, 1, 0)
                        bar.BackgroundColor3 = C.accent 
                    end
                end
            end
        end
    end
    if FH.noclipActive and LP.Character then
        for _, v in pairs(LP.Character:GetDescendants()) do 
            if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end 
        end
    end
end)

task.spawn(function()
    while true do
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then
            local sg = pg:FindFirstChild("SprintGui")
            if sg then
                local btn = sg:FindFirstChild("SprintButton", true)
                if btn and not btn:GetAttribute("FH_HOOKED") then
                    btn:SetAttribute("FH_HOOKED", true)
                    btn.InputBegan:Connect(function(input) 
                        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then FH.isSprintingManually = true end 
                    end)
                    btn.InputEnded:Connect(function(input) 
                        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then FH.isSprintingManually = false end 
                    end)
                end
            end
        end
        task.wait(1)
    end
end)

local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Extra Stuff" then return end
    local opt = FH.crearOpcion
    local btn = FH.crearBotonAccion
    
    opt("Inf Stamina", function(v) FH.sashaSprint = v end)
    opt("Noclip", function(v) FH.noclipActive = v end)
    
    opt("Music ON/OFF", function(v) 
        if v then 
            if music then music:Play() else playMusic(FH.MUSIC_LIST[1].id) end
        else 
            stopMusic() 
        end
    end)
    
    local songList = Instance.new("ScrollingFrame", FH.oc)
    songList.Size = UDim2.new(1, 0, 0, 120)
    songList.BackgroundColor3 = C.bg_card
    songList.BackgroundTransparency = .2
    songList.BorderSizePixel = 0
    Instance.new("UICorner", songList).CornerRadius = UDim.new(0, 10)
    local sLayout = Instance.new("UIListLayout", songList)
    sLayout.Padding = UDim.new(0, 4)
    
    for i, song in ipairs(FH.MUSIC_LIST) do
        local b = Instance.new("TextButton", songList)
        b.Size = UDim2.new(1, -10, 0, 28)
        b.BackgroundColor3 = C.bg_dark
        b.Text = song.name
        b.TextColor3 = C.text
        b.Font = Enum.Font.GothamBold
        b.TextScaled = true
        b.BorderSizePixel = 0
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        b.MouseButton1Click:Connect(function()
            playMusic(song.id)
        end)
    end
    
    local volFrame = Instance.new("Frame", FH.oc)
    volFrame.Size = UDim2.new(1, 0, 0, 34)
    volFrame.BackgroundColor3 = C.bg_card
    volFrame.BackgroundTransparency = .2
    volFrame.BorderSizePixel = 0
    Instance.new("UICorner", volFrame).CornerRadius = UDim.new(0, 10)
    
    local volText = Instance.new("TextLabel", volFrame)
    volText.Size = UDim2.new(0, 60, 1, 0)
    volText.Position = UDim2.new(0, 10, 0, 0)
    volText.BackgroundTransparency = 1
    volText.Text = "Volume"
    volText.TextColor3 = C.text
    volText.Font = Enum.Font.GothamBold
    volText.TextScaled = true
    
    local volBar = Instance.new("Frame", volFrame)
    volBar.Size = UDim2.new(1, -90, 0, 10)
    volBar.Position = UDim2.new(0, 75, 0.5, -5)
    volBar.BackgroundColor3 = C.bg_dark
    volBar.BorderSizePixel = 0
    Instance.new("UICorner", volBar).CornerRadius = UDim.new(1, 0)
    
    local volFill = Instance.new("Frame", volBar)
    volFill.Size = UDim2.new(FH.musicVolume, 0, 1, 0)
    volFill.BackgroundColor3 = C.accent
    volFill.BorderSizePixel = 0
    Instance.new("UICorner", volFill).CornerRadius = UDim.new(1, 0)
    
    local draggingVol = false
    local function updateVol(x)
        local rel = math.clamp((x - volBar.AbsolutePosition.X) / volBar.AbsoluteSize.X, 0, 1)
        volFill.Size = UDim2.new(rel, 0, 1, 0)
        FH.musicVolume = rel
        if music then music.Volume = rel end
    end
    
    volBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingVol = true
            updateVol(i.Position.X)
        end
    end)
    FH.UI.InputChanged:Connect(function(i)
        if draggingVol and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            updateVol(i.Position.X)
        end
    end)
    FH.UI.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingVol = false
        end
    end)
end
FH.p7 = true
