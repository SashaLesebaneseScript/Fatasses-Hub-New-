}
local music = nil
local musicVol = 0.15

local function playMusic(id)
    if music then music:Destroy() end
    music = Instance.new("Sound")
    music.SoundId = id
    music.Volume = musicVol
    music.Looped = true
    music.Parent = FH.SS
    music:Play()
end

local function stopMusic()
    if music then music:Destroy(); music = nil end
end

RS.RenderStepped:Connect(function()
    if FH.sashaSprint then
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local stam = char:FindFirstChild("Stam")
            if FH.UI:IsKeyDown(Enum.KeyCode.LeftShift) or FH.isSprintingManually then
                if hum and hum.WalkSpeed ~= 30 then hum.WalkSpeed = 30 end
                if stam then stam.Value = 100 end
            end
            local pg = LP:FindFirstChild("PlayerGui")
            if pg then
                local sg = pg:FindFirstChild("SprintGui")
                if sg then
                    local txt = sg:FindFirstChild("StaminaText", true)
                    local bar = sg:FindFirstChild("FillFrame", true)
                    if txt and txt:IsA("TextLabel") then txt.Text = "Sasha Wuz Here" end
                    if bar and bar:IsA("Frame") then 
                        bar.Size = UDim2.new(1, 0, 1, 0)
                        bar.BackgroundColor3 = C.accent 
                    end
                end
            end
        end
    end
    if FH.noclipActive and LP.Character then
        for _, v in pairs(LP.Character:GetDescendants()) do 
            if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end 
        end
    end
end)

task.spawn(function()
    while true do
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then
            local sg = pg:FindFirstChild("SprintGui")
            if sg then
                local btn = sg:FindFirstChild("SprintButton", true)
                if btn and not btn:GetAttribute("FH_HOOKED") then
                    btn:SetAttribute("FH_HOOKED", true)
                    btn.InputBegan:Connect(function(input) 
                        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then FH.isSprintingManually = true end 
                    end)
                    btn.InputEnded:Connect(function(input) 
                        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then FH.isSprintingManually = false end 
                    end)
                end
            end
        end
        task.wait(1)
    end
end)

local guardianConn = nil
local function startGuardian()
    if guardianConn then return end
    guardianConn = RS.RenderStepped:Connect(function()
        if not FH.guardianActive then return end
        local exp = FH.getExperiment and FH.getExperiment()
        if not exp or not exp.Character then return end
        local expHRP = exp.Character:FindFirstChild("HumanoidRootPart")
        if not expHRP then return end
        local best, bd = nil, 100
        for _, p in ipairs(PL:GetPlayers()) do
            if p ~= LP and p ~= exp and p.Character then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if h and h.Health > 0 and hrp then
                    local d = (expHRP.Position - hrp.Position).Magnitude
                    if d < bd then bd = d; best = hrp end
                end
            end
        end
        if best then
            local myChar = LP.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHRP then
                myHRP.CFrame = myHRP.CFrame:Lerp(best.CFrame * CFrame.new(2, 0, 2), 0.2)
            end
        end
    end)
end
local function stopGuardian()
    FH.guardianActive = false
    if guardianConn then guardianConn:Disconnect(); guardianConn = nil end
end

