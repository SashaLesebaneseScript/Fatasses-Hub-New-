-- ============ PARTE 17/17 - Class S Gun Enhancements ============
local FH = getgenv().FH
if not FH or not FH.p16 then warn("[FH] Ejecuta Partes 1-16 primero") return end
if FH.p17 then warn("[FH] Parte 17 ya ejecutada") return end
local RS,PL,LP = FH.RS,FH.PL,FH.LP
local RST = FH.RST
local WS = FH.WS
local C = FH.C

local GunEvent = nil
local function getGun()
    if GunEvent and GunEvent.Parent then return GunEvent end
    GunEvent = RST:FindFirstChild("GunEvent")
    return GunEvent
end

FH.gun = { silentAim=false, sniper=false, legitBigger=false, megaHitbox=false, noCollision=false }

local function getKiller()
    local best, bestH = nil, 6.5
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local ok, sz = pcall(function() return p.Character:GetExtentsSize().Y end)
                if ok and sz and sz > bestH then bestH = sz; best = p.Character end
            end
        end
    end
    return best
end

local function getChest(char) if not char then return nil end return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") end

local function isAiming() local mc = LP.Character return mc and mc:GetAttribute("IsAiming") == true end

-- Loop principal: Dispara solo al pecho del asesino mientras estas apuntando
task.spawn(function()
    while true do
        local ev = getGun()
        if ev and isAiming() and FH.gun.silentAim then
            local target = getKiller()
            if target then
                local chest = getChest(target)
                if chest then
                    local shootPos = chest.Position
                    pcall(function()
                        ev:FireServer("Shoot", shootPos)
                    end)
                end
            end
        end
        task.wait(0.15)
    end
end)

local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Class S" then return end
    local opt = FH.crearOpcion
    opt("Silent Aim (To Killer) 🎯", function(v) FH.gun.silentAim = v end)
    opt("Sniper Mode 🔭", function(v) FH.gun.sniper = v end)
    opt("Legit Bigger Hitbox 📦", function(v) FH.gun.legitBigger = v end)
    opt("Mega Hitbox 🌌", function(v) FH.gun.megaHitbox = v end)
    opt("No Collision Shoot 🚫", function(v) FH.gun.noCollision = v end)
end

if FH.pestana == "Class S" then FH.panel() end
FH.p17 = true
print("🎃 [17/17] Class S Gun Enhancements OK (Silent Aim + Hitbox Modes)")
