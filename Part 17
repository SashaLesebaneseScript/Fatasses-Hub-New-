-- ============ PARTE 17/17 - Class S Gun Enhancements ============
local FH = getgenv().FH
if not FH or not FH.p16 then warn("[FH] Ejecuta Partes 1-16 primero") return end
if FH.p17 then warn("[FH] Parte 17 ya ejecutada") return end
local RS,PL,LP = FH.RS,FH.PL,FH.LP
local WS = FH.WS
local RST = FH.RST
local C = FH.C

local GunEvent = nil
local function getGun()
    if GunEvent and GunEvent.Parent then return GunEvent end
    GunEvent = RST:FindFirstChild("GunEvent")
    return GunEvent
end

FH.gun = { silentAim=false, lastShot=0 }

local function getKiller()
    local best, bestH = nil, 6.5
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local ok, sz = pcall(function() return p.Character:GetExtentsSize().Y end)
                if ok and sz and sz > bestH then bestH = sz; best = p.Character end
            end
        end
    end
    return best
end

local function getChest(char)
    if not char then return nil end
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end

local function hasLOS(targetChar)
    local mc = LP.Character; if not mc or not targetChar then return false end
    local mh = mc:FindFirstChild("Head") or mc:FindFirstChild("HumanoidRootPart")
    local th = targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart")
    if not mh or not th then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {mc, targetChar}
    local ray = WS:Raycast(mh.Position, th.Position - mh.Position, params)
    return ray == nil 
end

local function isAiming()
    local mc = LP.Character
    return mc and mc:GetAttribute("IsAiming") == true
end

-- Loop principal: Dispara SI O SI al pecho y quita el apuntado
task.spawn(function()
    while true do
        local ev = getGun()
        if ev and isAiming() and FH.gun.silentAim then
            local target = getKiller()
            if target and hasLOS(target) then
                if tick() - FH.gun.lastShot >= 45 then
                    local chest = getChest(target)
                    if chest then
                        pcall(function() ev:FireServer("Shoot", chest.Position) end)
                        FH.gun.lastShot = tick()
                        
                        -- Forzar quitar la animacion de apuntado
                        local mc = LP.Character
                        if mc then
                            mc:SetAttribute("IsAiming", false)
                            pcall(function()
                                keypress(Enum.KeyCode.F)
                                task.wait(0.05)
                                keyrelease(Enum.KeyCode.F)
                            end)
                        end
                    end
                end
            end
        end
        task.wait(0.2)
    end
end)

local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Class S" then return end
    local opt = FH.crearOpcion
    opt("Silent Aim (Auto-Fire) 🎯", function(v) FH.gun.silentAim = v end)
end

if FH.pestana == "Class S" then FH.panel() end
FH.p17 = true
print("🎃 [17/17] Class S Gun Enhancements OK (Silent Aim)")
