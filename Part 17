-- ============ PARTE 17/17 - Class S Gun Enhancements ============
local FH = getgenv().FH
if not FH or not FH.p16 then warn("[FH] Ejecuta Partes 1-16 primero") return end
if FH.p17 then warn("[FH] Parte 17 ya ejecutada") return end
local RS,PL,LP = FH.RS,FH.PL,FH.LP
local WS = FH.WS
local RST = FH.RST
local C = FH.C

local GunEvent = nil
local function getGun()
    if GunEvent and GunEvent.Parent then return GunEvent end
    GunEvent = RST:FindFirstChild("GunEvent")
    return GunEvent
end

FH.gun = { silentAim=false, autoShoot=false, lastShot=0 }

local function getKiller()
    local best, bestH = nil, 6.5
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local ok, sz = pcall(function() return p.Character:GetExtentsSize().Y end)
                if ok and sz and sz > bestH then bestH = sz; best = p.Character end
            end
        end
    end
    return best
end

local function getChest(char)
    if not char then return nil end
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end

-- LOS (Line of Sight)
local function hasLOS(targetChar)
    local mc = LP.Character; if not mc or not targetChar then return false end
    local mh = mc:FindFirstChild("Head") or mc:FindFirstChild("HumanoidRootPart")
    local th = targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart")
    if not mh or not th then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {mc, targetChar}
    local ray = WS:Raycast(mh.Position, th.Position - mh.Position, params)
    return ray == nil -- Si no hay nada en medio, hay linea de vision
end

-- Forzar Pecho (Silent Aim)
task.spawn(function()
    task.wait(1)
    pcall(function()
        local mt = getrawmetatable(game)
        if setreadonly then setreadonly(mt, false) end
        local oldNamecall = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and self.Name == "GunEvent" then
                local args = {...}
                if args[1] == "Shoot" and FH.gun.silentAim then
                    local target = getKiller()
                    if target then
                        local chest = getChest(target)
                        if chest then
                            args[2] = chest.Position -- SI O SI va al pecho
                        end
                    end
                    return oldNamecall(self, unpack(args))
                end
            end
            return oldNamecall(self, ...)
        end)
        if setreadonly then setreadonly(mt, true) end
    end)
end)

-- Loop de Auto Shoot
task.spawn(function()
    while true do
        if FH.gun.autoShoot then
            local target = getKiller()
            if target and hasLOS(target) then
                if tick() - FH.gun.lastShot >= 45 then
                    local ev = getGun()
                    if ev then
                        local chest = getChest(target)
                        if chest then
                            pcall(function() ev:FireServer("Shoot", chest.Position) end)
                            FH.gun.lastShot = tick()
                            
                            -- Quitar animacion de apuntado (Un-aim)
                            local mc = LP.Character
                            if mc then
                                mc:SetAttribute("IsAiming", false)
                                -- Intentar soltar el boton de apuntar (si existe)
                                local pg = LP.PlayerGui
                                local gg = pg:FindFirstChild("GunGui")
                                if gg then
                                    local aimBtn = gg:FindFirstChild("AimButton")
                                    if aimBtn and firesignal then
                                        pcall(firesignal, aimBtn.MouseButton1Click)
                                    end
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.5)
        else
            task.wait(1)
        end
    end
end)

local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Class S" then return end
    local opt = FH.crearOpcion
    opt("Silent Aim (Force Chest) 🎯", function(v) FH.gun.silentAim = v end)
    opt("Auto Shoot (45s + LOS) 🔫", function(v) FH.gun.autoShoot = v end)
end

if FH.pestana == "Class S" then FH.panel() end
FH.p17 = true
print("🎃 [17/17] Class S Gun Enhancements OK (Silent Aim + Auto Shoot)")
