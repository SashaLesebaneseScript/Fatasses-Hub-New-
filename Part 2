local FH=getgenv().FH
if not FH or not FH.p1 then warn("[FH] Ejecuta Parte 1 primero") return end
if FH.p2 then warn("[FH] Parte 2 ya ejecutada") return end
local RS,PL,WS,RST,LP=FH.RS,FH.PL,FH.WS,FH.RST,FH.LP

FH.vision=function(t) if not t then return false end; local mc=LP.Character;if not mc then return false end; local mh=mc:FindFirstChild("Head")or mc:FindFirstChild("HumanoidRootPart"); local th=t:FindFirstChild("Head")or t:FindFirstChild("HumanoidRootPart"); if not mh or not th then return false end; local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude;rp.FilterDescendantsInstances={mc,t}; return not WS:Raycast(mh.Position,th.Position-mh.Position,rp) end

local evCache={}
FH.getEv=function(n) if evCache[n] and evCache[n].Parent then return evCache[n]end; local e=RST:FindFirstChild(n); if e and e:IsA("RemoteEvent")then evCache[n]=e;return e end; for _,v in ipairs(RST:GetDescendants())do if v:IsA("RemoteEvent")and v.Name==n then evCache[n]=v;return v end end end
FH.getHealEv=function() local hs=RST:FindFirstChild("HealingAbility"); if hs then local e=hs:FindFirstChild("HealingEvent");if e then evCache.heal=e;return e end end; if evCache.heal and evCache.heal.Parent then return evCache.heal end; return FH.getEv("HealingEvent") end

FH.getExperiment = function()
    for _, p in ipairs(PL:GetPlayers()) do
        if p.Character then
            local exp = p.Character:FindFirstChild("Experiment")
            if exp and (exp:IsA("BoolValue") or exp:IsA("ObjectValue") or exp:IsA("StringValue")) and (exp.Value == true or exp.Value == p) then
                return p
            end
        end
    end
    return nil
end
FH.updateKiller = function() local exp = FH.getExperiment(); return exp and exp.Character or nil end
FH.isKiller = function(m) if not m then return false end return m==FH.updateKiller() end

FH.nearest=function(maxD) 
    maxD=maxD or math.huge; local mc=LP.Character;if not mc then return nil end; local mh=mc:FindFirstChild("HumanoidRootPart");if not mh then return nil end; local b,bd=nil,maxD
    for _,p in ipairs(PL:GetPlayers())do 
        if p~=LP and p.Character then
            local ch=p.Character;local h=ch:FindFirstChildOfClass("Humanoid");local hr=ch:FindFirstChild("HumanoidRootPart")
            if h and h.Health>0 and hr then local d=(mh.Position-hr.Position).Magnitude; if d<bd then bd=d;b={Player=p,Char=ch,HRP=hr}end end 
        end 
    end 
    return b 
end

FH.injPlayer=function(maxD) 
    maxD=maxD or 20; local mc=LP.Character;if not mc then return nil end; local mh=mc:FindFirstChild("HumanoidRootPart");if not mh then return nil end; local b,bd=nil,maxD
    for _,p in ipairs(PL:GetPlayers())do 
        if p~=LP and p.Character then
            local ch=p.Character;local h=ch:FindFirstChildOfClass("Humanoid");local hr=ch:FindFirstChild("HumanoidRootPart")
            if h and hr and h.Health>0 and h.Health<h.MaxHealth then 
                local ex=p:FindFirstChild("Experiment")
                if not(ex and ex.Value==true)then local d=(mh.Position-hr.Position).Magnitude; if d<bd then bd=d;b=p end end 
            end 
        end 
    end 
    return b 
end

local TR=nil;pcall(function()TR=RST:WaitForChild("TaskRemote",5)end)
FH.TR=TR;FH.tarea=nil;FH.ultima=nil
if TR then TR.OnClientEvent:Connect(function(a,id,gui) if a=="OpenGui"then FH.tarea={id=id,gui=gui} elseif a=="EndTask"then if FH.tarea and FH.tarea.id==id then FH.ultima=FH.tarea;FH.tarea=nil end end end)end

FH.complete=function() if not FH.TR or not FH.tarea then return false end; local id = FH.tarea.id; if not id then return false end; local ok = pcall(function() FH.TR:FireServer("CompleteStep", id) end); return ok end

local spT = nil
local lastSpamId = nil
FH.startSp=function()
    if spT then return end
    spT=task.spawn(function()
        while FH.on.spamComplete do
            if FH.tarea and FH.tarea.id ~= lastSpamId then
                lastSpamId = FH.tarea.id
                FH.complete()
            end
            task.wait(0.3)
        end
        spT=nil
    end)
end
FH.stopSp=function() FH.on.spamComplete=false; spT=nil; lastSpamId=nil end

-- CURACIÓN INFINITA (Spam de HealTick)
FH.healT=function(t) 
    local e=FH.getHealEv(); if not e or not t then return false end
    local targetPlayer = t.Character and PL:GetPlayerFromCharacter(t.Character) or t
    if not targetPlayer then return false end
    pcall(function() e:FireServer("StartVisuals", targetPlayer) end)
    task.spawn(function() 
        for i=1,30 do 
            pcall(function() e:FireServer("HealTick", targetPlayer) end)
            task.wait(0.05) 
        end
        pcall(function() e:FireServer("GiveSpeedBoost") end)
        -- No enviamos StartCooldown para evitar el bloqueo
    end)
    return true 
end
FH.healN=function() return FH.healT(FH.injPlayer(100)) end
FH.healS=function() return FH.healT(LP) end
FH.healAll=function()
    local e=FH.getHealEv(); if not e then return end
    for _,p in ipairs(PL:GetPlayers())do 
        if p~=LP and p.Character then 
            local h=p.Character:FindFirstChildOfClass("Humanoid"); 
            if h and h.Health>0 and h.Health<h.MaxHealth then 
                task.spawn(function() 
                    pcall(function() e:FireServer("StartVisuals",p) end)
                    for i=1,30 do pcall(function() e:FireServer("HealTick",p) end); task.wait(0.05) end
                    pcall(function() e:FireServer("GiveSpeedBoost") end) 
                end) 
            end 
        end 
    end
end
FH.resetCd=function() local e=FH.getHealEv(); if not e then return end; task.spawn(function() for i=1,15 do pcall(function() e:FireServer("RequestCooldownCheck") end); task.wait(.05) end end) end
FH.boost=function() local e=FH.getHealEv(); if not e then return end; pcall(function() e:FireServer("GiveSpeedBoost") end) end

FH.ahT = nil
FH.startAH=function() if FH.ahT then return end; FH.ahT=task.spawn(function() while FH.on.autoHeal do task.wait(0.5); if FH.on.autoHeal then local t=FH.injPlayer(100); if t then FH.healT(t); task.wait(0.5) end end end FH.ahT=nil end) end
