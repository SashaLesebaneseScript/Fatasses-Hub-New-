local FH=getgenv().FH
if not FH or not FH.p1 then warn("[FH] Ejecuta Parte 1 primero") return end
if FH.p2 then warn("[FH] Parte 2 ya ejecutada") return end
local RS,PL,WS,RST,LP=FH.RS,FH.PL,FH.WS,FH.RST,FH.LP
FH.vision=function(t)
 if not t then return false end
 local mc=LP.Character;if not mc then return false end
 local mh=mc:FindFirstChild("Head")or mc:FindFirstChild("HumanoidRootPart")
 local th=t:FindFirstChild("Head")or t:FindFirstChild("HumanoidRootPart")
 if not mh or not th then return false end
 local rp=RaycastParams.new()
 rp.FilterType=Enum.RaycastFilterType.Exclude;rp.FilterDescendantsInstances={mc,t}
 return not WS:Raycast(mh.Position,th.Position-mh.Position,rp)
end
local evCache={}
FH.getEv=function(n)
 if evCache[n] and evCache[n].Parent then return evCache[n]end
 local e=RST:FindFirstChild(n)
 if e and e:IsA("RemoteEvent")then evCache[n]=e;return e end
 for _,v in ipairs(RST:GetDescendants())do
  if v:IsA("RemoteEvent")and v.Name==n then evCache[n]=v;return v end end
end
FH.getHealEv=function()
 local hs=RST:FindFirstChild("HealingAbility")
 if hs then local e=hs:FindFirstChild("HealingEvent");if e then evCache.heal=e;return e end end
 if evCache.heal and evCache.heal.Parent then return evCache.heal end
 return FH.getEv("HealingEvent")
end
-- ===== KILLER: solo el jugador mas alto (>7 studs). Cacheado 0.5s. =====
FH.killerCache=nil
FH.killerCacheTime=0
FH.updateKiller=function()
 if tick()-FH.killerCacheTime<0.5 then return FH.killerCache end
 local best,bestH=nil,0
 for _,p in ipairs(PL:GetPlayers())do
  if p.Character then
   local h=p.Character:FindFirstChildOfClass("Humanoid")
   if h and h.Health>0 then
    local ok,sz=pcall(function()return p.Character:GetExtentsSize().Y end)
    if ok and sz and sz>bestH then bestH=sz;best=p.Character end end end end
 if bestH<7 then best=nil end
 FH.killerCache=best
 FH.killerCacheTime=tick()
 return best
end
FH.isKiller=function(m)
 if not m then return false end
 return m==FH.updateKiller()
end
FH.nearest=function(maxD)
 maxD=maxD or math.huge
 local mc=LP.Character;if not mc then return nil end
 local mh=mc:FindFirstChild("HumanoidRootPart");if not mh then return nil end
 local b,bd=nil,maxD
 for _,p in ipairs(PL:GetPlayers())do
  if p~=LP and p.Character then
   local ch=p.Character;local h=ch:FindFirstChildOfClass("Humanoid");local hr=ch:FindFirstChild("HumanoidRootPart")
   if h and h.Health>0 and hr then
    local d=(mh.Position-hr.Position).Magnitude
    if d<bd then bd=d;b={Player=p,Char=ch,HRP=hr}end end end end
 return b
end
FH.injPlayer=function(maxD)
 maxD=maxD or 20
 local mc=LP.Character;if not mc then return nil end
 local mh=mc:FindFirstChild("HumanoidRootPart");if not mh then return nil end
 local b,bd=nil,maxD
 for _,p in ipairs(PL:GetPlayers())do
  if p~=LP and p.Character then
   local ch=p.Character;local h=ch:FindFirstChildOfClass("Humanoid");local hr=ch:FindFirstChild("HumanoidRootPart")
   if h and hr and h.Health>0 and h.Health<h.MaxHealth then
    local ex=p:FindFirstChild("Experiment")
    if not(ex and ex.Value==true)then
     local d=(mh.Position-hr.Position).Magnitude
     if d<bd then bd=d;b=p end end end end end
 return b
end
local TR=nil;pcall(function()TR=RST:WaitForChild("TaskRemote",5)end)
FH.TR=TR;FH.tarea=nil;FH.ultima=nil
if TR then TR.OnClientEvent:Connect(function(a,id,gui)
 if a=="OpenGui"then FH.tarea={id=id,gui=gui}
 elseif a=="EndTask"then if FH.tarea and FH.tarea.id==id then FH.ultima=FH.tarea;FH.tarea=nil end end end)end
-- Auto Complete (1 disparo por tarea)
FH.acFired = {}
FH.complete=function()
    if not FH.TR or not FH.tarea then return false end
    local id = FH.tarea.id
    if not id then return false end
    local ok = pcall(function() FH.TR:FireServer("CompleteStep", id) end)
    return ok
end
local acT
FH.startAC=function()
    if acT then return end
    FH.acFired = {}
    acT=task.spawn(function()
        while FH.on.autoComplete do
            local t = FH.tarea
            if t and t.id and not FH.acFired[t.id] then
                task.wait(1)
                if FH.on.autoComplete and FH.tarea and FH.tarea.id == t.id and not FH.acFired[t.id] then
                    FH.acFired[t.id] = true
                    FH.complete()
                end
            end
            task.wait(.5)
        end
        acT=nil
    end)
end
FH.stopAC=function()
    FH.on.autoComplete=false
    FH.acFired = {}
    acT=nil
end
local spT
FH.startSp=function()
 if spT then return end
 spT=task.spawn(function()while FH.on.spamComplete do if FH.tarea then FH.complete()end;task.wait(.3)end;spT=nil end)end
FH.stopSp=function()FH.on.spamComplete=false;spT=nil end
FH.getPrompts=function()
    local l = {}
    local mc = LP.Character
    if not mc then return l end
    local hrp = mc:FindFirstChild("HumanoidRootPart")
    if not hrp then return l end
    local mp = hrp.Position
    for _, pp in ipairs(WS:GetDescendants()) do
        if pp:IsA("ProximityPrompt") and pp.Enabled then
            local model = pp.Parent
            if model then
                local ref = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
                if not ref and model.Parent then
                    ref = model.Parent:FindFirstChildWhichIsA("BasePart")
                end
                if ref then
                    table.insert(l, {pp=pp, d=(mp-ref.Position).Magnitude})
                end
            end
        end
    end
    table.sort(l, function(a,b) return a.d < b.d end)
    return l
end
FH.firePrompt=function(pp)
    if not pp then return false end
    pcall(function()
        if not pp.Enabled then pp.Enabled = true end
        if fireproximityprompt then
            fireproximityprompt(pp)
            return
        end
        if firesignal then
            pcall(firesignal, pp.PromptButtonHoldBegan)
            pcall(firesignal, pp.PromptButtonHoldEnded)
            pcall(firesignal, pp.Triggered)
            return
        end
        if pp.HoldDuration and pp.HoldDuration > 0 then
            keypress(Enum.KeyCode.E)
            task.wait(pp.HoldDuration + .05)
            keyrelease(Enum.KeyCode.E)
        else
            keypress(Enum.KeyCode.E)
            task.wait(.05)
            keyrelease(Enum.KeyCode.E)
        end
    end)
    return true
end
local asT
FH.startAS=function()
    if asT then return end
    asT=task.spawn(function()
        while FH.on.autoStart do
            if not FH.tarea then
                local l = FH.getPrompts()
                if #l > 0 then
                    FH.firePrompt(l[1].pp)
                end
            end
            task.wait(.7)
        end
        asT=nil
    end)
end
FH.stopAS=function()FH.on.autoStart=false;asT=nil end
local arT
FH.startAR=function()
    if arT then return end
    arT=task.spawn(function()
        while FH.on.autoRequeue do
            local ult = FH.ultima
            if ult and not FH.tarea then
                local npcName = string.split(ult.id, "_")[1]
                local npc = nil
                for _, obj in ipairs(WS:GetDescendants()) do
                    if obj.Name == npcName then npc = obj; break end
                end
                if npc then
                    local pp = npc:FindFirstChild("ProximityPrompt", true)
                    if not pp and npc.Parent then
                        pp = npc.Parent:FindFirstChild("ProximityPrompt", true)
                    end
                    if pp then
                        FH.ultima = nil
                        task.wait(.5)
                        if FH.on.autoRequeue and not FH.tarea then
                            FH.firePrompt(pp)
                        end
                    else
                        FH.ultima = nil
                    end
                else
                    FH.ultima = nil
                end
            end
            task.wait(.6)
        end
        arT=nil
    end)
end
FH.stopAR=function()FH.on.autoRequeue=false;arT=nil end
