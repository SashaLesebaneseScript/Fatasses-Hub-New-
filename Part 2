-- ============ PARTE 2/5 - Core Fixes ============
local FH=getgenv().FH
if not FH or not FH.p1 then warn("[FH] Ejecuta Parte 1 primero") return end
if FH.p2 then warn("[FH] Parte 2 ya ejecutada") return end
local RS,PL,WS,RST,LP=FH.RS,FH.PL,FH.WS,FH.RST,FH.LP

FH.vision=function(t) 
    if not t then return false end
    local mc=LP.Character; if not mc then return false end
    local mh=mc:FindFirstChild("Head")or mc:FindFirstChild("HumanoidRootPart")
    local th=t:FindFirstChild("Head")or t:FindFirstChild("HumanoidRootPart")
    if not mh or not th then return false end
    local rp=RaycastParams.new()
    rp.FilterType=Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances={mc,t}
    return not WS:Raycast(mh.Position, th.Position - mh.Position, rp) 
end

local evCache={}
FH.getEv=function(n) 
    if evCache[n] and evCache[n].Parent then return evCache[n] end
    local e=RST:FindFirstChild(n)
    if e and e:IsA("RemoteEvent") then evCache[n]=e; return e end
    for _,v in ipairs(RST:GetDescendants()) do 
        if v:IsA("RemoteEvent") and v.Name==n then evCache[n]=v; return v end 
    end
end

FH.getHealEv=function() 
    local hs=RST:FindFirstChild("HealingAbility")
    if hs then local e=hs:FindFirstChild("HealingEvent"); if e then evCache.heal=e; return e end end
    if evCache.heal and evCache.heal.Parent then return evCache.heal end
    return FH.getEv("HealingEvent") 
end

FH.getExperiment = function()
    for _, p in ipairs(PL:GetPlayers()) do
        if p.Character then
            local exp = p.Character:FindFirstChild("Experiment")
            if exp and (exp:IsA("BoolValue") or exp:IsA("ObjectValue") or exp:IsA("StringValue")) and (exp.Value == true or exp.Value == p) then
                return p
            end
        end
    end
    return nil
end

FH.updateKiller = function() 
    local exp = FH.getExperiment(); return exp and exp.Character or nil 
end
FH.isKiller = function(m) if not m then return false end return m==FH.updateKiller() end

FH.nearest=function(maxD) 
    maxD=maxD or math.huge; local mc=LP.Character; if not mc then return nil end
    local mh=mc:FindFirstChild("HumanoidRootPart"); if not mh then return nil end
    local b,bd=nil,maxD
    for _,p in ipairs(PL:GetPlayers()) do 
        if p~=LP and p.Character then
            local ch=p.Character; local h=ch:FindFirstChildOfClass("Humanoid"); local hr=ch:FindFirstChild("HumanoidRootPart")
            if h and h.Health>0 and hr then local d=(mh.Position-hr.Position).Magnitude; if d<bd then bd=d; b={Player=p,Char=ch,HRP=hr} end end 
        end 
    end 
    return b 
end

FH.injPlayer=function(maxD) 
    maxD=maxD or 25; local mc=LP.Character; if not mc then return nil end
    local mh=mc:FindFirstChild("HumanoidRootPart"); if not mh then return nil end
    local b,bd=nil,maxD
    for _,p in ipairs(PL:GetPlayers()) do 
        if p~=LP and p.Character then
            local ch=p.Character; local h=ch:FindFirstChildOfClass("Humanoid"); local hr=ch:FindFirstChild("HumanoidRootPart")
            if h and hr and h.Health>0 and h.Health<h.MaxHealth then 
                local ex=p:FindFirstChild("Experiment")
                if not(ex and ex.Value==true)then local d=(mh.Position-hr.Position).Magnitude; if d<bd then bd=d; b=p end end 
            end 
        end 
    end 
    return b 
end

-- SISTEMA DE CURACIÓN (TP + HEAL)
FH.healT=function(t) 
    local e=FH.getHealEv()
    if not e or not t then return false end
    local targetPlayer = t.Character and PL:GetPlayerFromCharacter(t.Character) or t
    if not targetPlayer or not targetPlayer.Character then return false end
    
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP or not tHRP then return false end
    
    -- TP al objetivo para evitar el error "Target is too far"
    if (myHRP.Position - tHRP.Position).Magnitude > 15 then
        pcall(function() myHRP.CFrame = tHRP.CFrame * CFrame.new(0, 0, 3) end)
        task.wait(0.1)
    end
    
    -- Forzar UI
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        local hg = pg:FindFirstChild("HealingGui")
        if hg and hg:FindFirstChild("HealingButton") then
            local ct = hg.HealingButton:FindFirstChild("CooldownText")
            if ct then ct.Text = "∞" end
        end
    end
    
    pcall(function() e:FireServer("StartVisuals", targetPlayer) end)
    task.spawn(function() 
        for i=1,6 do -- 6 ticks = 30 data = 50XP
            if not targetPlayer.Character then break end
            pcall(function() e:FireServer("HealTick", targetPlayer) end)
            task.wait(1) -- 1 segundo por tick
        end
        pcall(function() e:FireServer("GiveSpeedBoost") end)
        pcall(function() e:FireServer("StopVisuals") end)
    end)
    return true 
end

FH.healN=function() return FH.healT(FH.injPlayer(100)) end
FH.healS=function() return FH.healT(LP) end

FH.p2=true
print("[2/5] Core + Heal Fix OK")
