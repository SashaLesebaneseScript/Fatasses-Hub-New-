local FH = getgenv().FH
if not FH or not FH.p1 then return end
local RS, PL, WS, RST, LP = FH.RS, FH.PL, FH.WS, FH.RST, FH.LP

local PunchEvent = nil
local function getPunchEv()
    if PunchEvent and PunchEvent.Parent then return PunchEvent end
    PunchEvent = RST:FindFirstChild("PunchEvent")
    return PunchEvent
end

FH.isKiller = function(m) 
    local exp = FH.getExperiment and FH.getExperiment()
    return exp and exp.Character == m 
end

FH.nearest = function(maxD) 
    maxD = maxD or math.huge
    local mc = LP.Character
    if not mc then return nil end
    local mh = mc:FindFirstChild("HumanoidRootPart")
    if not mh then return nil end
    local b, bd = nil, maxD
    for _, p in ipairs(PL:GetPlayers()) do 
        if p ~= LP and p.Character then
            local ch = p.Character
            local h = ch:FindFirstChildOfClass("Humanoid")
            local hr = ch:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and hr then 
                local d = (mh.Position - hr.Position).Magnitude
                if d < bd then 
                    bd = d
                    b = {Player=p, Char=ch, HRP=hr} 
                end 
            end 
        end 
    end 
    return b 
end

FH.k8 = FH.k8 or {
    autoPunch=false, antiStun=false, hitboxTp=false, hitbox360=false, hitboxExpander=false,
    alwaysMaxSpeed=false, killAll=false, anchoredHitbox=false, range=12, hbRange=100,
    expanderRange=3.5, expanderWidth=2.0, tpBoxSize=8, attackId=0
}
