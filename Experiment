local FH = getgenv().FH
if not FH or not FH.p1 then return end
local RS, PL, WS, RST, LP = FH.RS, FH.PL, FH.WS, FH.RST, FH.LP
local C = FH.C

FH.k8 = FH.k8 or {
    autoPunch=false, antiStun=false, hitbox360=false,
    alwaysMaxSpeed=false, killAll=false, attackId=0
}
local K = FH.k8

local function soyKiller() return FH.isKiller(LP.Character) end
local function estoyStuneado()
    local mc = LP.Character; if not mc then return false end
    local s = mc:FindFirstChild("Stun"); if s and s:IsA("BoolValue") then return s.Value == true end
    local hum = mc:FindFirstChildOfClass("Humanoid"); if hum and hum.PlatformStand then return true end
    return false
end

task.spawn(function()
    while true do
        if K.autoPunch and soyKiller() and not estoyStuneado() then
            local ev = RST:FindFirstChild("PunchEvent")
            local mh = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if ev and mh then
                K.attackId = K.attackId + 1
                pcall(function() ev:FireServer({AttackId=K.attackId, Position=mh.Position, Velocity=mh.AssemblyLinearVelocity, Direction=mh.CFrame.LookVector}) end)
            end
            task.wait(0.3)
        else
            task.wait(0.5)
        end
    end
end)

local EXTRA_MODE = false
task.spawn(function()
    local ev = RST:FindFirstChild("PunchEvent"); local tries = 0
    while not ev and tries < 30 do task.wait(0.5); ev = RST:FindFirstChild("PunchEvent"); tries = tries + 1 end
    if not ev then return end
    pcall(function()
        local mt2 = getrawmetatable(game); setreadonly(mt2, false)
        local oldNC2 = mt2.__namecall
        mt2.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "FireServer" and self == ev and not EXTRA_MODE then
                task.spawn(function()
                    if not soyKiller() or estoyStuneado() then return end
                    EXTRA_MODE = true
                    if K.hitbox360 then
                        K.attackId = K.attackId + 1
                        local id = K.attackId
                        local mh = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                        if mh then
                            for i = 1, 36 do
                                local angle = (i / 36) * (math.pi * 2)
                                local dir = Vector3.new(math.cos(angle), 0, math.sin(angle)).Unit
                                local pos = mh.Position + dir * 12
                                pcall(function() oldNC2(self, {AttackId=id, Position=pos, Velocity=Vector3.new(0,0,0), Direction=dir}) end)
                            end
                        end
                    end
                    EXTRA_MODE = false
                end)
            end
            return oldNC2(self, ...)
        end)
        setreadonly(mt2, true)
    end)
end)

local killAllConn = nil
local function updateKillAll()
    if not K.killAll or not soyKiller() or estoyStuneado() then return end
    local survivor = FH.nearest(2000)
    if survivor and survivor.HRP then
        local myhrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if myhrp then
            local targetPos = survivor.HRP.Position + Vector3.new(0, 0, 3)
            myhrp.CFrame = myhrp.CFrame:Lerp(CFrame.new(targetPos, survivor.HRP.Position), 0.2)
            K.attackId = K.attackId + 1
            local ev = RST:FindFirstChild("PunchEvent")
            if ev then pcall(function() ev:FireServer({AttackId=K.attackId, Position=survivor.HRP.Position, Velocity=Vector3.new(0,0,0), Direction=Vector3.new(0,1,0)}) end) end
        end
    end
end
local function startKillAll()
    if killAllConn then return end
    killAllConn = RS.RenderStepped:Connect(function() pcall(updateKillAll) end)
end
local function stopKillAll()
    K.killAll = false
    if killAllConn then killAllConn:Disconnect(); killAllConn = nil end
end

local amsConn = nil
local function startAMS()
    if amsConn then return end
    amsConn = RS.Heartbeat:Connect(function()
        if not K.alwaysMaxSpeed or not soyKiller() or estoyStuneado() then return end
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= 27 then pcall(function() hum.WalkSpeed = 27 end) end
    end)
end
local function stopAMS()
    K.alwaysMaxSpeed = false
    if amsConn then amsConn:Disconnect(); amsConn = nil end
end

local stunConns = {}
local function startAntiStun()
    local mc = LP.Character; if not mc then return end
    for _, d in ipairs(mc:GetDescendants()) do
        if d.Name:lower():find("stun") and (d:IsA("BoolValue") or d:IsA("IntValue") or d:IsA("NumberValue")) then
            if not d:GetAttribute("FH_STUN") then
                d:SetAttribute("FH_STUN", true)
                table.insert(stunConns, d:GetPropertyChangedSignal("Value"):Connect(function()
                    if K.antiStun and d.Value then pcall(function() d.Value = false end) end
                end))
            end
        end
    end
end

local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Experiment" then return end
    local opt = FH.crearOpcion
    opt("Auto Punch", function(v) K.autoPunch = v end)
    opt("Kill All", function(v) K.killAll = v; if v then startKillAll() else stopKillAll() end end)
    opt("360 Hitbox", function(v) K.hitbox360 = v end)
    opt("Always Max Speed", function(v) K.alwaysMaxSpeed = v; if v then startAMS() else stopAMS() end end)
    opt("Anti Stun", function(v) K.antiStun = v; if v then startAntiStun() end end)
end
FH.p6 = true
