-- ============ PARTE 10/10 - Auto Farms Logic ============
local FH = getgenv().FH
if not FH or not FH.p8 then warn("[FH] Ejecuta Partes 1-8 primero") return end
if FH.p10 then warn("[FH] Parte 10 ya ejecutada") return end
local RS,PL,WS,LP = FH.RS,FH.PL,FH.WS,FH.LP
local C = FH.C

-- Auto Farm: Scientist (en la pestaña de Auto Farm)
-- Auto Farm: Class S
-- Auto Farm: Class A

local function getSpectatorSpawn()
    return WS:FindFirstChild("SpectatorSpawn") or WS:FindFirstChild("SpectatorSpawn2") or WS:FindFirstChild("SpawnLocation")
end

-- Class S Farm
FH.startClassSFarm = function()
    task.spawn(function()
        while FH.classSFarmActive and FH.blatantMode do
            local gunGui = LP.PlayerGui:FindFirstChild("GunGui")
            if gunGui then
                -- Activar Silent Aim logic (simplificada)
                local target = FH.nearest(200)
                if target and target.HRP then
                    -- Check stun
                    local stun = target.Char:FindFirstChild("Stun")
                    if stun and stun.Value then
                        -- Dance 2s
                        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
                        if hum then
                            local anim = Instance.new("Animation")
                            anim.AnimationId = "rbxassetid://507771019"
                            local track = hum:LoadAnimation(anim)
                            track:Play()
                            task.wait(2)
                            track:Stop()
                        end
                        local sp = getSpectatorSpawn()
                        if sp then LP.Character.HumanoidRootPart.CFrame = sp.CFrame end
                    else
                        -- TP 5 studs
                        local look = target.HRP.CFrame.LookVector
                        local tpPos = target.HRP.Position + (look * 5)
                        LP.Character.HumanoidRootPart.CFrame = CFrame.new(tpPos, target.HRP.Position)
                        
                        -- Aim & Shoot
                        local ev = FH.getEv("GunEvent")
                        if ev then
                            pcall(function() ev:FireServer("Shoot", target.HRP.Position) end)
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end

-- Class A Farm
FH.startClassAFarm = function()
    task.spawn(function()
        while FH.classAFarmActive and FH.blatantMode do
            local healGui = LP.PlayerGui:FindFirstChild("HealingGui")
            if healGui then
                local sp = getSpectatorSpawn()
                if sp and LP.Character then LP.Character.HumanoidRootPart.CFrame = sp.CFrame end
                
                -- Activar toggles
                FH.hideHealMsg = true
                FH.muteGame = true
                FH.on.jackpot = true
                FH.on.autoHeal = true
                FH.on.autoHealSelf = true
                
                -- Forzar actualizacion de UI si es necesario
                if not FH.ahT then FH.startAH() end
                if not FH.ahsT then FH.startAHS() end
                if not FH.jT then FH.startJ() end
            end
            task.wait(2)
        end
    end)
end

-- Añadir los toggles a las pestañas correspondientes
local origPanel = FH.panel
FH.panel = function()
    origPanel()
    local opt = FH.crearOpcion
    
    if FH.pestana == "Class S" then
        opt("Auto Farm (Class S) 🤖", function(v) 
            FH.classSFarmActive = v
            if v then FH.startClassSFarm() end
        end, true)
    elseif FH.pestana == "Class A" then
        opt("Auto Farm (Class A) 🤖", function(v) 
            FH.classAFarmActive = v
            if v then FH.startClassAFarm() end
        end, true)
    end
end

if FH.pestana == "Class S" or FH.pestana == "Class A" then FH.panel() end
FH.p10 = true
print("🎃 [10/10] Auto Farms OK")
