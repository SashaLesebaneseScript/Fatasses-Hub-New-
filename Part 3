  for _,h in ipairs(fm:GetChildren())do
   if h.Name=="Note" and h:IsA("Frame")then
    local a=h:GetAttribute("Angle")
    if a then local d=math.abs(a-FH.ANGULO_ABAJO);if d>math.pi then d=2*math.pi-d end
     if d>.3 then h:SetAttribute("Angle",FH.ANGULO_ABAJO)end end end end
  local ac=FH.ANGULO_ABAJO+math.pi/2
  catcher.Position=UDim2.new(math.cos(ac)*FH.RADIO+.5,0,math.sin(ac)*FH.RADIO+.5,0)
