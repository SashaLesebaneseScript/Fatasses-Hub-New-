local espCache={}
local function mapId()if WS:FindFirstChild("Map1")then return 1 end;if WS:FindFirstChild("Map2")then return 2 end;return 0 end
local function tipo(m,mi)if not m or not m.Name then return nil end
 local n=string.lower(m.Name)
 if mi==1 and string.find(n,"patient",1,true)then return "patient"end
 if mi==2 and string.find(n,"tube",1,true)then return "tube"end end
local function scanESP()
 local mi=mapId();local list={}
 for _,o in ipairs(WS:GetDescendants())do if o:IsA("Model")and tipo(o,mi)then list[o]=true end end
 for m in pairs(list)do
  if not espCache[m]then
   local h=Instance.new("Highlight")
   h.FillTransparency=.5;h.OutlineTransparency=0
   h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
   h.Adornee=m;h.Parent=m
   h.FillColor=Color3.fromRGB(255,120,20);h.OutlineColor=Color3.fromRGB(255,180,80)
   espCache[m]=h end end
 for m,h in pairs(espCache)do if not list[m]or not m.Parent then h:Destroy();espCache[m]=nil end end end
local eT
FH.startESP=function()
 if eT then return end
 scanESP()
 eT=task.spawn(function()while FH.on.espActive do task.wait(2);if FH.on.espActive then scanESP()end end;eT=nil end)end
FH.stopESP=function()for m,h in pairs(espCache)do h:Destroy()end;espCache={};eT=nil end
