if not FH or not FH.p2 then warn("[FH] Ejecuta Partes 1-2 primero") return end
if FH.p3 then warn("[FH] Parte 3 ya ejecutada") return end
local RS,PL,WS,LP=FH.RS,FH.PL,FH.WS,FH.LP
local conexion
FH.startAP=function()
 if conexion then return end
 conexion=RS.Heartbeat:Connect(function()
  if not FH.on.autoPatient then return end
  local gui=LP.PlayerGui:FindFirstChild(FH.NOMBRE_GUI)
  if not gui or not gui.Enabled then return end
  local fm=gui:FindFirstChild("Frame");if not fm or not fm.Visible then return end
