local TweenService = game:GetService("TweenService")
local user = "SashaLesebaneseScript"
local repo = "Fatasses-Hub-New-"
local branch = "main"

local files = {
    "MainGUI",
    "ESP",
    "Scientist",
    "ClassA",
    "ClassS",
    "Experiment",
    "ExtraStuff",
    "Blatant",
    "Halloween"
}

local totalFiles = #files
local errorOcurred = false

local function downloadFile(file)
    local url1 = string.format("https://raw.githubusercontent.com/%s/%s/%s/%s", user, repo, branch, file)
    local url2 = string.format("https://github.com/%s/%s/raw/%s/%s?raw=true", user, repo, branch, file)
    
    local ok, code = pcall(function() return game:HttpGet(url1, true) end)
    if ok and code and code ~= "" and not code:find("404: Not Found") then return code end
    
    ok, code = pcall(function() return game:HttpGet(url2, true) end)
    if ok and code and code ~= "" and not code:find("404: Not Found") then return code end
    
    return nil
end

if getgenv().FH and getgenv().FH.lsFrame then
    getgenv().FH.lsFrame.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(getgenv().FH.lsFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 320, 0, 120)}):Play()
    task.wait(0.4)
end

for i, file in ipairs(files) do
    if getgenv().FH and getgenv().FH.lsText then
        getgenv().FH.lsText.Text = "Loading " .. file .. " page..."
        if getgenv().FH.lsFill then
            TweenService:Create(getgenv().FH.lsFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(i / totalFiles, 0, 1, 0)}):Play()
        end
    end
    
    local code = downloadFile(file)
    if code then
        local fn = loadstring(code)
        if fn then 
            local success, err = pcall(fn) 
            if not success then
                errorOcurred = true
            end
        end
    else
        errorOcurred = true
    end
    task.wait(0.35)
end

if getgenv().FH then
    if getgenv().FH.lsText then
        if errorOcurred then
            getgenv().FH.lsText.Text = "Error loading."
            getgenv().FH.lsText.TextColor3 = Color3.fromRGB(255, 50, 50)
        else
            getgenv().FH.lsText.Text = "Ready!"
            if getgenv().FH.lsFill then
                TweenService:Create(getgenv().FH.lsFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 1, 0)}):Play()
            end
        end
    end
    
    task.wait(0.8)
    
    if getgenv().FH.lsFrame then
        TweenService:Create(getgenv().FH.lsFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)}):Play()
        task.wait(0.3)
    end
    
    if getgenv().FH.ls then getgenv().FH.ls:Destroy() end
    
    if getgenv().FH.sg then 
        getgenv().FH.sg.Enabled = true 
    end
    if getgenv().FH.fr then
        getgenv().FH.fr.Size = UDim2.new(0, 0, 0, 0)
        getgenv().FH.fr.Visible = true
        TweenService:Create(getgenv().FH.fr, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, getgenv().FH.BW, 0, getgenv().FH.BH)}):Play()
    end
    if getgenv().FH.panel then pcall(getgenv().FH.panel) end
end
