local FH = getgenv().FH
if not FH or not FH.p7 then warn("[FH] Ejecuta Partes 1-7 primero") return end
if FH.p8a then warn("[FH] Parte 8A ya ejecutada") return end
local RS,PL,WS,RST,LP = FH.RS,FH.PL,FH.WS,FH.RST,FH.LP
local C = FH.C

local PunchEvent = nil
local function getPunchEv()
    if PunchEvent and PunchEvent.Parent then return PunchEvent end
    PunchEvent = RST:FindFirstChild("PunchEvent")
    if not PunchEvent then
        for _, v in ipairs(RST:GetDescendants()) do
            if v:IsA("RemoteEvent") and v.Name == "PunchEvent" then PunchEvent = v; break end
        end
    end
    return PunchEvent
end

FH.showWarning = function(featureName, limit)
    local existing = FH.sg:FindFirstChild("FH_Warning")
    if existing then existing:Destroy() end
    local w = Instance.new("Frame", FH.sg)
    w.Name = "FH_Warning"
    w.Size = UDim2.new(0, 320, 0, 120)
    w.Position = UDim2.new(0.5, -160, 0, 120)
    w.BackgroundColor3 = Color3.fromRGB(30, 10, 15)
    w.BorderSizePixel = 0
    w.ZIndex = 10
    Instance.new("UICorner", w).CornerRadius = UDim.new(0, 10)
    local wstroke = Instance.new("UIStroke", w)
    wstroke.Color = Color3.fromRGB(255, 80, 80)
    wstroke.Thickness = 2
    local txt = Instance.new("TextLabel", w)
