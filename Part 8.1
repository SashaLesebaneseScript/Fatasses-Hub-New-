-- ============ PARTE 8B - Killer Punch (funciones + panel) ============
local FH = getgenv().FH
if not FH or not FH.p8a then warn("[FH] Ejecuta Parte 8A primero") return end
if FH.p8b then warn("[FH] Parte 8B ya ejecutada") return end
local RS,PL,LP = FH.RS,FH.PL,FH.LP
local C = FH.C

local getPunchEv = FH._getPunchEv
local soyKiller = FH._soyKiller
local estoyStuneado = FH._estoyStuneado
local hayPared = FH._hayPared
local enemigoCercano = FH._enemigoCercano
local enemigoAlFrente = FH._enemigoAlFrente
local K = FH._K
local LIMITS = FH._LIMITS
local SPHERE_DIRS = FH._SPHERE_DIRS

local EXTRA_MODE = false

local function triggerExtras()
    if EXTRA_MODE then return end
    if not soyKiller() then return end
    if estoyStuneado() then return end
    local ev = getPunchEv(); if not ev then return end
    local mc = LP.Character
    local mh = mc and mc:FindFirstChild("HumanoidRootPart"); if not mh then return end
    EXTRA_MODE = true

    if K.autoPunch then
        K.attackId = K.attackId + 1
        local id = K.attackId
        local startT = tick()
        while tick() - startT <= 0.4 do
            if estoyStuneado() then break end
            local c = LP.Character; if not c then break end
            local h = c:FindFirstChild("HumanoidRootPart"); if not h then break end
            for i = 1, 5 do
                pcall(function()
                    ev:FireServer({
                        AttackId = id,
                        Position = h.Position,
                        Velocity = h.AssemblyLinearVelocity,
                        Direction = h.CFrame.LookVector,
                    })
                end)
            end
            task.wait(0.05)
        end
    end

    if K.hitboxTp then
        local t = enemigoAlFrente(K.expanderRange) or enemigoCercano(K.range)
        if t then
            local th = t:FindFirstChild("Head") or t:FindFirstChild("HumanoidRootPart")
            if th then
                K.attackId = K.attackId + 1
                local id = K.attackId
                local boxSize = K.tpBoxSize
                local startT = tick()
                while tick() - startT <= 0.4 do
                    if estoyStuneado() then break end
                    local t2 = t and (t:FindFirstChild("Head") or t:FindFirstChild("HumanoidRootPart"))
                    if not t2 then break end
                    local center = t2.Position
                    local step = boxSize / 2
                    for dx = -1, 1 do
                        for dy = -1, 1 do
                            for dz = -1, 1 do
                                local pos = center + Vector3.new(dx * step, dy * step, dz * step)
                                local dir = (pos - mh.Position).Unit
                                pcall(function()
                                    ev:FireServer({
                                        AttackId = id,
                                        Position = pos,
                                        Velocity = Vector3.new(0,0,0),
                                        Direction = dir,
                                    })
                                end)
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end
        end
    end

    if K.hitbox360 then
        K.attackId = K.attackId + 1
        local id = K.attackId
        local R = K.hbRange
        local startT = tick()
        while tick() - startT <= 0.4 do
            if estoyStuneado() then break end
            local c = LP.Character; if not c then break end
            local h = c:FindFirstChild("HumanoidRootPart"); if not h then break end
            local origin = h.Position
            for _, rfrac in ipairs({0.4, 0.7, 1.0}) do
                local r = R * rfrac
                for _, dir in ipairs(SPHERE_DIRS) do
                    local pos = origin + dir * r
                    pcall(function()
                        ev:FireServer({
                            AttackId = id,
                            Position = pos,
                            Velocity = Vector3.new(0,0,0),
                            Direction = dir,
                        })
                    end)
                end
            end
            task.wait(0.1)
        end
    end

    if K.hitboxExpander then
        K.attackId = K.attackId + 1
        local id = K.attackId
        local dist = K.expanderRange
        local width = K.expanderWidth
        local startT = tick()
        while tick() - startT <= 0.4 do
            if estoyStuneado() then break end
            local c = LP.Character; if not c then break end
            local h = c:FindFirstChild("HumanoidRootPart"); if not h then break end
            local look = h.CFrame.LookVector
            local right = h.CFrame.RightVector
            local up = h.CFrame.UpVector
            local origin = h.Position + look * 2
            local lenSteps = 15
            local wSteps = 2
            for i = 0, lenSteps do
                local lfrac = i / lenSteps
                local basePos = origin + look * (dist * lfrac)
                for j = -wSteps, wSteps do
                    for k = -wSteps, wSteps do
                        local offR = right * (j * (width / (2 * wSteps + 1)))
                        local offU = up * (k * (width / (2 * wSteps + 1)))
                        local pos = basePos + offR + offU
                        pcall(function()
                            ev:FireServer({
                                AttackId = id,
                                Position = pos,
                                Velocity = Vector3.new(0,0,0),
                                Direction = look,
                            })
                        end)
                    end
                end
            end
            task.wait(0.1)
        end
    end

    EXTRA_MODE = false
end

task.spawn(function()
    local ev = getPunchEv()
    local tries = 0
    while not ev and tries < 30 do
        task.wait(0.5); ev = getPunchEv(); tries = tries + 1
    end
    if not ev then return end
    pcall(function()
        local mt = getrawmetatable(game)
        if setreadonly then setreadonly(mt, false) end
        local oldNC = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "FireServer" and self == getPunchEv() then
                if not EXTRA_MODE then task.spawn(triggerExtras) end
            end
            return oldNC(self, ...)
        end)
        if setreadonly then setreadonly(mt, true) end
    end)
end)

local amsConn = nil
local function startAMS()
    if amsConn then return end
    amsConn = RS.Heartbeat:Connect(function()
        if not K.alwaysMaxSpeed then return end
        if not soyKiller() then return end
        if estoyStuneado() then return end
        local mc = LP.Character; if not mc then return end
        local hum = mc:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= 27 then
            pcall(function() hum.WalkSpeed = 27 end)
        end
    end)
end
local function stopAMS()
    K.alwaysMaxSpeed = false
    if amsConn then amsConn:Disconnect(); amsConn = nil end
end

local killAllConn = nil
local savedSpeedKA, savedJumpKA = 16, 50

local function getNearestSurvivor()
    local mc = LP.Character; if not mc then return nil end
    local mh = mc:FindFirstChild("HumanoidRootPart"); if not mh then return nil end
    local best, bd = nil, math.huge
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and hrp then
                local d = (mh.Position - hrp.Position).Magnitude
                if d < bd then bd = d; best = p.Character end
            end
        end
    end
    return best
end

local function updateKillAll()
    if not K.killAll then return end
    if estoyStuneado() then return end
    local survivor = getNearestSurvivor()
    if not survivor then return end
    local shrp = survivor:FindFirstChild("HumanoidRootPart"); if not shrp then return end
    local mc = LP.Character; if not mc then return end
    local myhrp = mc:FindFirstChild("HumanoidRootPart"); if not myhrp then return end
    local myhum = mc:FindFirstChildOfClass("Humanoid")
    if myhum then myhum.WalkSpeed = 0; myhum.JumpPower = 0 end

    local targetPos = shrp.Position + Vector3.new(2.5, 1, 0)
    local finalLook = Vector3.new(shrp.Position.X, targetPos.Y, shrp.Position.Z)
    local dist = (myhrp.Position - shrp.Position).Magnitude

    if dist > 2.5 then
        local newPos = myhrp.Position:Lerp(targetPos, 0.1)
        local ignorar = {mc, survivor}
        local hayPared1 = hayPared(myhrp.Position, newPos, ignorar)
        local headA = Vector3.new(myhrp.Position.X, myhrp.Position.Y + 2, myhrp.Position.Z)
        local headB = Vector3.new(newPos.X, newPos.Y + 2, newPos.Z)
        local hayPared2 = hayPared(headA, headB, ignorar)
        if hayPared1 or hayPared2 then
            local ry = math.atan2(-(shrp.Position.X - myhrp.Position.X), -(shrp.Position.Z - myhrp.Position.Z))
            myhrp.CFrame = CFrame.new(myhrp.Position) * CFrame.Angles(0, ry, 0)
            return
        end
        pcall(function() myhrp.CFrame = CFrame.lookAt(newPos, finalLook) end)
        return
    end
    pcall(function() myhrp.CFrame = CFrame.lookAt(myhrp.Position, finalLook) end)
end

local function startKillAll()
    if killAllConn then return end
    local mc = LP.Character
    if mc then
        local hum = mc:FindFirstChildOfClass("Humanoid")
        if hum then savedSpeedKA = hum.WalkSpeed; savedJumpKA = hum.JumpPower end
    end
    killAllConn = RS.RenderStepped:Connect(function() pcall(updateKillAll) end)
end
local function stopKillAll()
    K.killAll = false
    if killAllConn then killAllConn:Disconnect(); killAllConn = nil end
    local mc = LP.Character
    if mc then
        local hum = mc:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = savedSpeedKA; hum.JumpPower = savedJumpKA end
    end
end

local stunConns = {}
local function nukeStun(val)
    if val:GetAttribute("FH_STUN") then return end
    val:SetAttribute("FH_STUN", true)
    pcall(function() val.Value = false end)
    table.insert(stunConns, val:GetPropertyChangedSignal("Value"):Connect(function()
        if K.antiStun and val.Value then pcall(function() val.Value = false end) end
    end))
end
local function findStunValues()
    local mc = LP.Character; if not mc then return end
    for _, d in ipairs(mc:GetDescendants()) do
        if d.Name:lower():find("stun") and (d:IsA("BoolValue") or d:IsA("IntValue") or d:IsA("NumberValue")) then
            nukeStun(d)
        end
    end
end
local antiStunConn = nil
local function startAntiStun()
    findStunValues()
    if antiStunConn then return end
    antiStunConn = RS.Heartbeat:Connect(function()
        if K.antiStun then findStunValues() end
    end)
end
local function stopAntiStun()
    K.antiStun = false
    if antiStunConn then antiStunConn:Disconnect(); antiStunConn = nil end
    for _, c in ipairs(stunConns) do pcall(function() c:Disconnect() end) end
    stunConns = {}
end

local function mkNumInput(labelTxt, minV, maxV, getV, setV)
    local holder = Instance.new("Frame", FH.oc)
    holder.Size = UDim2.new(1, 0, 0, 40)
    holder.BackgroundColor3 = C.bg_card
    holder.BackgroundTransparency = 0.2
    holder.BorderSizePixel = 0
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 10)
    local hs = Instance.new("UIStroke", holder)
    hs.Color = C.border
    hs.Thickness = 1
    hs.Transparency = 0.5
    local lbl = Instance.new("TextLabel", holder)
    lbl.Size = UDim2.new(1, -100, 1, 0)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelTxt
    lbl.TextColor3 = C.text
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    local inputBg = Instance.new("Frame", holder)
    inputBg.Size = UDim2.new(0, 76, 0, 30)
    inputBg.Position = UDim2.new(1, -88, 0.5, -15)
    inputBg.BackgroundColor3 = Color3.fromRGB(35, 15, 45)
    inputBg.BorderSizePixel = 0
    Instance.new("UICorner", inputBg).CornerRadius = UDim.new(0, 6)
    local tb = Instance.new("TextBox", inputBg)
    tb.Size = UDim2.new(1, -8, 1, -8)
    tb.Position = UDim2.new(0, 4, 0, 4)
    tb.BackgroundTransparency = 1
    tb.Text = tostring(math.floor(getV()))
    tb.TextColor3 = C.accent
    tb.TextScaled = true
    tb.Font = Enum.Font.GothamBold
    tb.ClearTextOnFocus = false
    tb.FocusLost:Connect(function()
        local n = tonumber(tb.Text)
        if not n then tb.Text = tostring(math.floor(getV())); return end
        if n > maxV then
            tb.Text = tostring(maxV); setV(maxV); FH.showWarning(labelTxt, maxV)
        elseif n < minV then
            tb.Text = tostring(minV); setV(minV)
        else
            n = math.floor(n); tb.Text = tostring(n); setV(n)
        end
    end)
end

local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Experiment" then return end
    local opt = FH.crearOpcion

    opt("Auto Punch 👊", function(v) K.autoPunch = v end)
    opt("Anti Stun 🛡", function(v)
        K.antiStun = v
        if v then startAntiStun() else stopAntiStun() end
    end)
    opt("Hitbox Tp 👻", function(v) K.hitboxTp = v end)
    opt("360° Hitbox 💥", function(v) K.hitbox360 = v end)
    opt("Hitbox Expander 📏", function(v) K.hitboxExpander = v end)
    opt("Always Max Speed 🏃", function(v)
        K.alwaysMaxSpeed = v
        if v then startAMS() else stopAMS() end
    end)
    opt("Kill All ☠️", function(v)
        K.killAll = v
        if v then startKillAll() else stopKillAll() end
    end)

    mkNumInput("Rango", 1, LIMITS.range, function() return K.range end, function(v) K.range = v end)
    mkNumInput("360 Radio", 1, LIMITS.hbRange, function() return K.hbRange end, function(v) K.hbRange = v end)
    mkNumInput("Expander Largo", 1, LIMITS.expanderRange, function() return K.expanderRange end, function(v) K.expanderRange = v end)
    mkNumInput("Expander Ancho", 1, LIMITS.expanderWidth, function() return K.expanderWidth end, function(v) K.expanderWidth = v end)
    mkNumInput("TP Caja", 1, LIMITS.tpBoxSize, function() return K.tpBoxSize end, function(v) K.tpBoxSize = v end)
end

if FH.pestana == "Experiment" then FH.panel() end
FH.p8b = true
print("🎃 [8B/8] Killer Punch OK (funciones + panel)")
