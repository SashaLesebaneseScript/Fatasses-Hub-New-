local camera = workspace.CurrentCamera
while not camera do
    task.wait()
    camera = workspace.CurrentCamera
end

local function applyResponsive()
    local vp = camera.ViewportSize
    local minDim = math.min(vp.X, vp.Y)

    local pad = math.clamp(math.floor(minDim * 0.045), 12, 32)
    padding.PaddingTop = UDim.new(0, pad)
    padding.PaddingBottom = UDim.new(0, pad)
    padding.PaddingLeft = UDim.new(0, pad)
    padding.PaddingRight = UDim.new(0, pad)

    local radius = math.clamp(math.floor(minDim * 0.035), 8, 24)
    corner.CornerRadius = UDim.new(0, radius)

    local thickness = math.clamp(math.floor(minDim * 0.01), 2, 7)
    stroke.Thickness = thickness

    local textSize = math.clamp(math.floor(minDim * 0.032), 14, 26)
    label.TextSize = textSize
end

applyResponsive()

local conn
local function bindCamera()
    if conn then
        conn:Disconnect()
    end
    conn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyResponsive)
end

bindCamera()

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    local newCam = workspace.CurrentCamera
    if newCam and newCam ~= camera then
        camera = newCam
        bindCamera()
        applyResponsive()
    end
end)

task.defer(applyResponsive)
task.delay(0.5, applyResponsive)
