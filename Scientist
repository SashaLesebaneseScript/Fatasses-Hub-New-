local FH = getgenv().FH
if not FH or not FH.p1 then return end
local RS, PL, LP = FH.RS, FH.PL, FH.LP

FH.startAP = function()
    if FH.apConn then return end
    FH.apConn = RS.Heartbeat:Connect(function()
        if not FH.autoPatientLegit then return end
        local gui = LP.PlayerGui:FindFirstChild("TaskGuiMap1")
        if not gui or not gui.Enabled then return end
        local fm = gui:FindFirstChild("Frame")
        if not fm then return end
        local catcher = fm:FindFirstChild("Catcher")
        if not catcher then return end
        for _, h in ipairs(fm:GetChildren()) do
            if h.Name == "Note" and h:IsA("Frame") then
                local a = h:GetAttribute("Angle")
                if a then 
                    local d = math.abs(a - (math.pi/2))
                    if d > math.pi then d = 2*math.pi - d end
                    if d > 0.05 then h:SetAttribute("Angle", math.pi/2) end 
                end
            end
        end
        local ac = math.pi/2
        catcher.Position = UDim2.new(math.cos(ac)*0.42+0.5, 0, math.sin(ac)*0.42+0.5, 0)
        catcher.Rotation = math.deg(ac)+90
    end)
end

local SIDES = {["Straight"]={0,2}, ["Corner"]={1,2}, ["Endpoint"]={2}, ["TPipe"]={1,2,3}}
local OPU = {2,3,0,1}
local DIRV = {[0]={0,-1}, [1]={1,0}, [2]={0,1}, [3]={-1,0}}

local function rotCelda(c)
    local i = c:FindFirstChildOfClass("ImageButton")
    if not i then return 0 end
    return math.round((i:GetAttribute("TargetRotation") or i.Rotation)/90)%4 
end

local function esRota(c)
    return c:FindFirstChild("IsBroken") ~= nil 
end

local function xyDeOrder(o)
    return (o-1)%5, math.floor((o-1)/5) 
end

local function orderDeXY(x, y)
    return y*5+x+1 
end

local function lados(c)
    local p = c:FindFirstChild("PipeType")
    if not p then return {} end
    local bs = SIDES[p.Value]
    if not bs then return {} end
    local r = rotCelda(c)
    local l = {}
    for _, b in ipairs(bs) do table.insert(l, (b+r)%4) end
    return l 
end

local function puedeAbrir(c, l1, l2)
    local p = c:FindFirstChild("PipeType")
    if not p then return nil end
    local bs = SIDES[p.Value]
    if not bs then return nil end
    local ra = rotCelda(c)
    for d = 0, 3 do 
        local rp = (ra+d)%4
        local a1, a2 = false, false
        for _, b in ipairs(bs) do 
            local l = (b+rp)%4
            if l == l1 then a1 = true end
            if l == l2 then a2 = true end 
        end
        if a1 and a2 then return d end 
    end
    return nil 
end

local function encontrar(celdas)
    local mp = {}
    for _, c in ipairs(celdas) do 
        local x, y = xyDeOrder(c.LayoutOrder)
        mp[x] = mp[x] or {}
        mp[x][y] = c 
    end
    local c1 = mp[0] and mp[0][0]
    local c25 = mp[4] and mp[4][4]
    if not c1 or not c25 then return nil end
    local l1 = lados(c1)
    if #l1 ~= 1 or (l1[1] ~= 1 and l1[1] ~= 2) then return nil end
    local l25 = lados(c25)
    if #l25 ~= 1 or (l25[1] ~= 0 and l25[1] ~= 3) then return nil end
    local cam = {}
    local function dfs(x, y, le)
        local cel = mp[x] and mp[x][y]
        if not cel or esRota(cel) then return false end
        local o = orderDeXY(x, y)
        if cam[o] ~= nil then return false end
        if o == 25 then 
            if le == l25[1] then 
                cam[o] = 0
                return true 
            end
            return false 
        end
        if o == 1 then
            local ls = l1[1]
            local dx, dy = DIRV[ls][1], DIRV[ls][2]
            local nx, ny = x+dx, y+dy
            if nx >= 0 and nx < 5 and ny >= 0 and ny < 5 then
                local v = mp[nx] and mp[nx][ny]
                if v and not esRota(v) then 
                    local lo = OPU[ls+1]
                    cam[o] = 0
                    if dfs(nx, ny, lo) then return true end
                    cam[o] = nil 
                end 
            end
            return false 
        end
        for ls = 0, 3 do
            if ls ~= le then
                local dx, dy = DIRV[ls][1], DIRV[ls][2]
                local nx, ny = x+dx, y+dy
                if nx >= 0 and nx < 5 and ny >= 0 and ny < 5 then
                    local nO = orderDeXY(nx, ny)
                    local v = mp[nx] and mp[nx][ny]
                    if v and not esRota(v) and cam[nO] == nil then
                        local d = puedeAbrir(cel, le, ls)
                        if d ~= nil then 
                            local lo = OPU[ls+1]
                            cam[o] = d
                            if dfs(nx, ny, lo) then return true end
                            cam[o] = nil 
                        end 
                    end 
                end 
            end 
        end
        return false 
    end
    if dfs(0, 0, nil) then return cam end
    return nil 
end

local function resolver(celdas)
    local cam = encontrar(celdas)
    if not cam then return false end
    for o = 1, 25 do 
        local d = cam[o]
        if d and d > 0 then
            for _, c in ipairs(celdas) do
                if c.LayoutOrder == o then
                    local i = c:FindFirstChildOfClass("ImageButton")
                    if i then 
                        local r = i:GetAttribute("TargetRotation") or i.Rotation
                        local nr = r+d*90
                        i:SetAttribute("TargetRotation", nr)
                        i.Rotation = nr 
                    end
                    break 
                end 
            end 
        end 
    end
    local trig
    for o = 2, 24 do 
        local d = cam[o] or 0
        if d > 0 then 
            for _, c in ipairs(celdas) do 
                if c.LayoutOrder == o then 
                    trig = c
                    break 
                end 
            end
            break 
        end 
    end
    if trig then 
        local i = trig:FindFirstChildOfClass("ImageButton")
        if i then 
            local r = i:GetAttribute("TargetRotation") or i.Rotation
            i:SetAttribute("TargetRotation", r-90)
            i.Rotation = r-90
            if firesignal then pcall(firesignal, i.MouseButton1Click) end 
        end 
    end
    return true 
end

FH.startGen = function()
    if FH.genC then return end
    FH.genC = RS.Heartbeat:Connect(function()
        if not FH.autoTubeLegit then return end
        local gui = LP.PlayerGui:FindFirstChild("TaskGuiMap2")
        if not gui or not gui.Enabled then FH.ultGrid = nil; return end
        local gc = gui:FindFirstChild("GridContainer")
        if not gc or not gc.Visible then FH.ultGrid = nil; return end
        if FH.ultGrid == gc or FH.resolv then return end
        local celdas = {}
        for _, h in ipairs(gc:GetChildren()) do 
            if h:IsA("Frame") and h:FindFirstChildOfClass("ImageButton") then table.insert(celdas, h) end 
        end
        if #celdas < 25 then return end
        table.sort(celdas, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
        FH.resolv = true
        FH.ultGrid = gc
        task.spawn(function()
            task.wait(.3)
            if FH.autoTubeLegit then resolver(celdas) end
            FH.resolv = false 
        end)
    end)
end

FH.startPanel = function()
    if FH.panelC then return end
    FH.panelC = task.spawn(function()
        local sequence = {}
        local isRecording = false
        while task.wait(0.1) do
            if not FH.autoTask3Legit then continue end
            local gui = LP.PlayerGui:FindFirstChild("TaskGuiMap3")
            if not gui or not gui.Enabled then sequence = {}; isRecording = false; continue end
            local status = gui:FindFirstChild("StatusText")
            local grid = gui:FindFirstChild("GridArea")
            if not (status and grid) then continue end
            if status.Text:find("RECEIVING") then
                isRecording = true
                for i = 1, 16 do
                    local node = grid:FindFirstChild("Node_" .. i)
                    if node and not node:GetAttribute("FH_Hooked") then
                        node:SetAttribute("FH_Hooked", true)
                        node:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
                            if isRecording and FH.autoTask3Legit then table.insert(sequence, i) end
                        end)
                    end
                end
            elseif status.Text == "ENTER FREQUENCY CODE" and #sequence > 0 then
                isRecording = false
                for _, nodeNum in ipairs(sequence) do
                    if not FH.autoTask3Legit then break end
                    local node = grid:FindFirstChild("Node_" .. nodeNum)
                    if node then 
                        if firesignal then pcall(firesignal, node.MouseButton1Click) end
                        task.wait(0.2) 
                    end
                end
                sequence = {}
            end
        end
    end)
end

FH.startAB = function()
    if FH.abC then return end
    FH.abC = RS.Heartbeat:Connect(function()
        if not FH.antiBrokenTube then return end
        local gui = LP.PlayerGui:FindFirstChild("TaskGuiMap2")
        if not gui or not gui.Enabled then return end
        local gc = gui:FindFirstChild("GridContainer")
        if not gc then return end
        for _, celda in ipairs(gc:GetChildren()) do
            if celda:IsA("Frame") then
                local ib = celda:FindFirstChild("IsBroken")
                if ib then ib:Destroy() end
                local ov = celda:FindFirstChild("BrokenOverlay")
                if ov then ov:Destroy() end 
            end 
        end 
    end)
end

FH.startSp = function(v)
    if not v then return end
    if FH.spLoop then return end
    FH.spLoop = task.spawn(function()
        while FH.on.spamComplete do
            local taskID = FH.tarea and FH.tarea.id or "Task_1_1"
            local TR = FH.RST:FindFirstChild("TaskRemote")
            local RE = FH.RST:FindFirstChild("RewardEvent")
            local RE2 = FH.RST:FindFirstChild("RewardEvent2")
            
            if TR then 
                pcall(function() TR:FireServer("CompleteStep", taskID) end)
                pcall(function() TR:FireServer("EndTask", taskID) end)
            end
            if RE2 then 
                pcall(function() RE2:FireServer("Completed a Tuning Minigame", 20, "Scientist") end)
            end
            if RE then 
                pcall(function() RE:FireServer("Successfully Transmitted Signal Sequence", 10) end)
            end
            
            task.wait(0.1)
        end
        FH.spLoop = nil
    end)
end

local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Scientist" then return end
    FH.crearOpcion("Auto Patient", function(v) FH.autoPatientLegit = v; if v then FH.startAP() end end, false)
    FH.crearOpcion("Auto Generator", function(v) FH.autoTubeLegit = v; if v then FH.startGen() end end, false)
    FH.crearOpcion("Auto Panel", function(v) FH.autoTask3Legit = v; if v then FH.startPanel() end end, false)
    FH.crearOpcion("Spam Complete", function(v) FH.on.spamComplete = v; FH.startSp(v) end, false)
    FH.crearOpcion("Anti Broken Tube", function(v) FH.antiBrokenTube = v; if v then FH.startAB() end end, false)
end
