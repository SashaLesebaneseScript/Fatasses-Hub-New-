local FH = getgenv().FH
if not FH or not FH.p1 then return end

local origPanel = FH.panel
FH.panel = function()
    origPanel()
    if FH.pestana ~= "Blatant" then return end
    
    local warning = Instance.new("TextLabel", FH.oc)
    warning.Size = UDim2.new(1, 0, 0, 60)
    warning.BackgroundTransparency = 1
    warning.Text = "When you turn Blatant On all the response of ANY Bans on your account isn't my fault"
    warning.TextColor3 = FH.C.danger
    warning.Font = Enum.Font.GothamBold
    warning.TextScaled = true
    warning.TextWrapped = true
    
    FH.crearOpcion("Blatant Mode", function(v) 
        if v then 
            FH.blatantMode = true 
        else 
            FH.blatantMode = false
            FH.panel()
        end
    end)
end
FH.p8 = true
